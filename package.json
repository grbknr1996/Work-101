{
  "name": "ipas-webapp-frontend",
  "version": "0.0.250409",
  "scripts": {
    "i": "npm i --legacy-peer-deps --verbose",
    "postinstall": "npm i --legacy-peer-deps --prefer-offline --no-audit --location=global concurrently pug-cli stylus-chokidar && npm run build:assets",
    "build:assets": "pug --pretty --doctype html . && stylus-chokidar . && node scripts/copy-assets.mjs",
    "pugWatch": "pug --pretty --doctype html --watch .",
    "stylusWatch": "stylus-chokidar --watch .",
    "angularWatch": "ng serve --proxy-config proxy.conf.json --configuration devQuick",
    "assets-cache-busting": "node ./assets-cache-busting.js",
    "dev": "npm run assets-cache-busting && concurrently \"npm run pugWatch\" \"npm run stylusWatch\" \"npm run angularWatch\" --names \"Pug,Stylus,Angular\"",
    "lint:styles": "stylelint \"src/**/*.styl\"",
    "awsdev": "npm ci && npm run assets-cache-busting && pug --doctype html . && stylus-chokidar . && ng build --configuration awsdev --base-href / --deploy-url /",
    "awsacc": "npm ci && npm run assets-cache-busting && pug --doctype html . && stylus-chokidar . && ng build --configuration awsacc --base-href / --deploy-url /",
    "awsprod": "npm ci && npm run assets-cache-busting && pug --doctype html . && stylus-chokidar . && ng build --configuration awsprod --base-href / --deploy-url /",
    "awspreprod": "npm ci && npm run assets-cache-busting && pug --doctype html . && stylus-chokidar . && ng build --configuration awspreprod --base-href / --deploy-url /",
    "build-dev": "npm run awsdev",
    "all": "npm ci && npm run awsdev && npm run awsacc && npm run awsprod && npm run awspreprod"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "^19.2.4",
    "@angular/animations": "^19.2.3",
    "@angular/cdk": "^19.2.4",
    "@angular/cli": "^19.2.4",
    "@angular/common": "^19.2.3",
    "@angular/compiler": "^19.2.3",
    "@angular/compiler-cli": "^19.2.3",
    "@angular/core": "^19.2.3",
    "@angular/forms": "^19.2.3",
    "@angular/platform-browser": "^19.2.3",
    "@angular/platform-browser-dynamic": "^19.2.3",
    "@angular/router": "^19.2.3",
    "@ngneat/helipopper": "9.2.1",
    "@ngneat/overview": "^6.1.1",
    "@ngrx/signals": "^19.1.0",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "@popperjs/core": "^2.11.8",
    "@primeng/themes": "^19.0.10",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.10",
    "aws-amplify": "^6.14.3",
    "bootstrap": "^5.3.3",
    "bson-objectid": "^2.0.4",
    "echarts": "^5.4.3",
    "express": "^4.21.2",
    "filenamify": "^6.0.0",
    "ngx-echarts": "^19.0.0",
    "ngx-extended-pdf-viewer": "^25.6.0-alpha.3",
    "ngx-image-cropper": "^9.1.5",
    "ngx-translate-multi-http-loader": "^19.0.2",
    "primeicons": "^7.0.0",
    "primeng": "^19.0.10",
    "query-string": "^9.1.1",
    "quill": "^2.0.3",
    "rxjs": "^7.8.2",
    "sanitize-filename": "^1.6.3",
    "tailwindcss-primeui": "^0.6.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "5.8.x",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/localize": "^19.2.3",
    "@tailwindcss/forms": "^0.5.10",
    "@types/chai": "^5.2.0",
    "@types/jasmine": "^5.1.7",
    "@types/pug": "^2.0.10",
    "autoprefixer": "^10.4.21",
    "codelyzer": "^6.0.2",
    "postcss": "^8.5.3",
    "postcss-styl": "^0.12.3",
    "pug": "^3.0.2",
    "stylelint": "^16.25.0",
    "stylelint-stylus": "^1.0.0",
    "tailwindcss": "^3.4.17",
    "tslint": "^6.1.3"
  }
}
