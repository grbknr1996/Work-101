body 
    //background-color: green

// St. Vincent & Grenadines Office Specific Styles
.vc
  // Color Variables - Based on CIPO official website
  $vc-primary = #1e3a8a  // Dark blue from CIPO header
  $vc-secondary = #fbbf24  // Gold/yellow from CIPO accents
  $vc-accent = #059669  // Green from CIPO elements
  $vc-text = #1f2937  // Dark text color
  $vc-light = #f8fafc  // Light background
  $vc-hover = rgba(30, 58, 138, 0.1)  // Primary hover color
  $vc-gradient = linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #60a5fa 100%)  // CIPO gradient
  $vc-gradient-secondary = linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%)  // Gold gradient
  $vc-card-shadow = 0 4px 24px rgba(30, 58, 138, 0.08)
  $vc-radius = 12px
  $vc-logo-bg = #e2e8f0  // Light blue/grey background for logo area

  // PrimeNG Theme Overrides
  :root
    --p-primary-color: $vc-primary !important
    --p-primary-color-text: #ffffff !important
    --p-primary-50: lighten($vc-primary, 45%) !important
    --p-primary-100: lighten($vc-primary, 40%) !important
    --p-primary-200: lighten($vc-primary, 30%) !important
    --p-primary-300: lighten($vc-primary, 20%) !important
    --p-primary-400: lighten($vc-primary, 10%) !important
    --p-primary-500: $vc-primary !important
    --p-primary-600: darken($vc-primary, 10%) !important
    --p-primary-700: darken($vc-primary, 20%) !important
    --p-primary-800: darken($vc-primary, 30%) !important
    --p-primary-900: darken($vc-primary, 40%) !important
    --p-surface-0: #fff !important
    --p-surface-100: #f8fafc !important
    --p-surface-200: #e2e8f0 !important
    --p-surface-300: #cbd5e1 !important
    --p-surface-400: #fff !important
    --p-surface-500: #fff !important
    --p-text-color: $vc-text !important
    --p-text-color-secondary: #64748b !important
    --p-primary-text-color: #fff !important
    --p-secondary-text-color: #64748b !important
    --p-border-radius: 12px
    --p-input-border-color: #cbd5e1
    --p-input-hover-border-color: $vc-primary
    --p-focus-ring-color: rgba(30, 58, 138, 0.2)
    --p-highlight-bg: rgba(30, 58, 138, 0.08)
    --p-highlight-text-color: $vc-primary
    --p-menuitem-text-color: #fff !important
    --p-menuitem-hover-bg: rgba(255,255,255,0.08) !important
    --p-menuitem-active-bg: $vc-accent !important
    --p-submenu-bg: #fff !important
    --p-submenu-text-color: #374151 !important
    --p-submenu-hover-bg: $vc-hover !important
    --p-menu-separator: #e2e8f0 !important

  // Header and Navigation
  .app-navbar
    background: $vc-gradient !important
    box-shadow: 0 4px 16px rgba(30, 58, 138, 0.15) !important
    border-radius: 0px !important
    .navbar-title
      color: var(--p-surface-0) !important
      font-weight: 700 !important
      text-transform: uppercase !important
      letter-spacing: 1.5px !important
      font-size: 1.1rem
    .p-menubar-item-label
      color: var(--p-surface-0) !important    
    .p-button-text
      color: var(--p-surface-0) !important

  // Logo Styling - CIPO logo with distinct background
  .logo, .logo-container, .navbar-brand .logo
    background: $vc-logo-bg !important
    border-radius: 8px
    padding: 8px 16px
    margin: 8px 0
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1)
    display: inline-block

  // Sidebar
  .sidebar-container
    background: #f8fafc !important
    border-right: 1px solid #e2e8f0 !important
    box-shadow: 2px 0 12px rgba(30, 58, 138, 0.04)
    .menu-item
      &.menu-item-active > .menu-link
        background: $vc-hover !important
        color: $vc-primary !important
        font-weight: 600
        &::before
          background: $vc-accent !important
      .menu-link
        border-radius: 8px
        margin: 2px 0
        transition: background 0.2s, color 0.2s
        &:hover
          background: $vc-hover !important
          color: $vc-accent !important
        &.active-route
          background: $vc-accent !important
          color: #fff !important
          border-left: 4px solid $vc-secondary !important

  // Buttons
  .p-button
    &.p-button-primary
      background: $vc-gradient !important
      border: none !important
      border-radius: 8px
      font-weight: 600
      letter-spacing: 0.5px
      box-shadow: 0 2px 8px rgba(30, 58, 138, 0.12)
      &:hover
        background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #3b82f6 100%) !important
        color: #fff !important
        transform: translateY(-1px)
        box-shadow: 0 4px 12px rgba(30, 58, 138, 0.2)

  // Cards and Containers
  .widget-container, .p-card
    border: none !important
    background: #fff !important
    border-radius: $vc-radius
    margin-bottom: 1.5rem
    .widget-title, .p-card-title
      color: $vc-primary !important
      font-weight: 700 !important
      font-size: 1rem
      letter-spacing: 0.5px
    .p-card-header
      background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%) !important
      border-bottom: 1px solid #e2e8f0 !important
      border-top-left-radius: $vc-radius
      border-top-right-radius: $vc-radius

  // Tables
  .p-datatable
    .p-datatable-thead > tr > th
      background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%) !important
      color: $vc-primary !important
      font-weight: 700 !important
      border-bottom: 2px solid $vc-primary !important
      letter-spacing: 0.5px
    .p-datatable-tbody > tr > td
      background: #fff !important 
      border-bottom: 1px solid #e2e8f0 !important

  // Dashboard Specific
  .dashboard-heading
    background: $vc-gradient !important
    color: #fff !important
    border-radius: $vc-radius
    box-shadow: 0 2px 12px rgba(30, 58, 138, 0.08)
    .dashboard-title
      color: #fff !important
      font-weight: 700 !important
      text-transform: uppercase !important
      letter-spacing: 1.5px !important
      font-size: 2rem
    .dashboard-subtitle
      color: #e2e8f0 !important
      font-size: 1.1rem
      font-weight: 400

  // User Stats
  .user-stat-card
    border: 1px solid #e2e8f0 !important
    border-radius: $vc-radius
    box-shadow: 0 2px 8px rgba(30, 58, 138, 0.06)
    background: #fff !important
    &.selected
      background-color: rgba(59, 130, 246, 0.08) !important
      border: 2px solid #3B82F6 !important
      box-shadow: inset 0 0 0 2px rgba(59, 130, 246, 0.2) !important
    .stat-label
      color: $vc-primary
      font-weight: 600
    .stat-count
      color: $vc-accent
      font-size: 1.5rem
    .stat-change
      color: $vc-secondary
      font-weight: 600

  // Form Elements
  .p-inputtext:focus
    border-color: $vc-primary !important
    box-shadow: 0 0 0 0.2rem rgba(30, 58, 138, 0.12) !important
    border-radius: 8px

  // Badges and Tags
  .p-tag
    &.p-tag-success
      background: $vc-accent !important
      color: #fff !important
      border-radius: 8px
      font-weight: 600

  // Footer
  .layout-footer
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%) !important
    border-top: 1px solid #e2e8f0 !important
    border-bottom-left-radius: $vc-radius
    border-bottom-right-radius: $vc-radius
    p
      color: $vc-primary !important
      font-weight: 600
      letter-spacing: 0.5px
      font-size: 1rem
      margin: 0.5rem 0

  // PrimeNG Specific Components
  .p-menubar
    background: $vc-gradient !important
    border: none !important
    padding: 0.25rem 0.2rem !important
    border-radius: $vc-radius
    box-shadow: 0 2px 12px rgba(30, 58, 138, 0.08)
    .p-menubar-root-list > .p-menuitem > .p-menuitem-link
      padding: 0.75rem 1.25rem !important
      color: #fff !important
      border-radius: 8px !important
      font-weight: 600
      margin: 0 0.25rem !important
      transition: background 0.2s, color 0.2s
      .p-menuitem-text, .p-menuitem-icon, .p-submenu-icon
        color: #fff !important
      &:not(.p-disabled):hover
        background: $vc-accent !important
        color: #fff !important
      &.p-menuitem-active
        background: $vc-gradient-secondary !important
        color: $vc-primary !important
    .p-submenu-list
      background: #fff !important
      border: 1px solid #e2e8f0 !important
      border-radius: 8px !important
      box-shadow: 0 2px 12px rgba(0,0,0,0.08) !important
      .p-menuitem-link
        color: $vc-primary !important
        &:hover
          background: $vc-hover !important
          color: $vc-accent !important
        &.p-menuitem-active
          background: $vc-accent !important
          color: #fff !important

  // Sidebar Menu Enhancement
  .sidebar-container
    .menu-list
      .menu-item
        .menu-link
          padding: 0.75rem 1.25rem !important
          color: var(--p-text-color) !important
          transition: background-color 0.2s, color 0.2s !important
          border-radius: 0 !important
          
          &:hover
            background-color: var(--p-submenu-hover-bg) !important
            color: var(--p-primary-500) !important
            
            .menu-icon
              color: var(--p-primary-500) !important
          
          &.active-route
            background-color: var(--p-highlight-bg) !important
            color: var(--p-primary-500) !important
            border-left: 3px solid var(--p-primary-500) !important
            
            .menu-icon
              color: var(--p-primary-500) !important

        .submenu
          .submenu-item
            .submenu-link
              padding: 0.75rem 1.75rem !important
              color: var(--p-text-color) !important
              transition: background-color 0.2s, color 0.2s !important
              
              &:hover
                background-color: var(--p-submenu-hover-bg) !important
                color: var(--p-primary-500) !important
              
              &.active-route
                background-color: var(--p-highlight-bg) !important
                color: var(--p-primary-500) !important
