p-fieldset.no-border-fieldset(*ngIf="showQuery", [legend]="'common.components.advancedFilter.query.header'|translate", [toggleable]="true", [collapsed]="true")
  .mb-6.query-box
    h3.query-header.mb-3 {{"common.components.advancedFilter.query.queryUsed"|translate}}
    div(*ngFor="let levelList of selectedQuery?.levelList; let k = index; let levellast = last")
      div(*ngIf="levelList.level === '1'; else level2Block")
        div(*ngFor="let group_list of levelList.group_list; let j = index; let grouplast = last")
            div.level1-margin
              .group-name {{group_list.group_name}}
                div(*ngFor="let file_list of group_list.file_list; let i = index; let last = last")
                  div.group-margin
                    div
                      span.field-name {{file_list.field.name}}:&nbsp;
                      span.field-connector {{file_list.connecting.name}} 
                      span.field-value &apos;{{file_list.value}}&apos;
                    .operator(*ngIf="!last")
                      ng-container(*ngIf="file_list.orOperator; else andLabel")
                        | {{"common.components.advancedFilter.toggle.or"|translate}}
                      ng-template(#andLabel)
                        | {{"common.components.advancedFilter.toggle.and"|translate}}
                .operator(*ngIf="!grouplast") {{group_list.orOperator}}
                  ng-container(*ngIf="group_list.orOperator; else andLabel")
                    | {{"common.components.advancedFilter.toggle.or"|translate}}
                  ng-template(#andLabel)
                    | {{"common.components.advancedFilter.toggle.and"|translate}}
      ng-template(#level2Block)
          div.level2-margin
            .level-name {{levelList.level_name}}:
            .level-marker
              div(*ngFor="let group_list of levelList.group_list; let j = index; let grouplast = last")
                div.level2-group-margin
                  .group-name {{group_list.group_name}}
                    div(*ngFor="let file_list of group_list.file_list; let i = index; let last = last")
                      div.group-margin
                        div
                          span.field-name {{file_list.field.name}}:&nbsp;
                          span.field-connector {{file_list.connecting.name}} 
                          span.field-value &apos;{{file_list.value}}&apos;
                        .operator(*ngIf="!last")
                          ng-container(*ngIf="file_list.orOperator; else andLabel")
                            | {{"common.components.advancedFilter.toggle.or"|translate}}
                          ng-template(#andLabel)
                            | {{"common.components.advancedFilter.toggle.and"|translate}}
                    .operator(*ngIf="!grouplast")
                      ng-container(*ngIf="group_list.orOperator; else andLabel")
                        | {{"common.components.advancedFilter.toggle.or"|translate}}
                      ng-template(#andLabel)
                        | {{"common.components.advancedFilter.toggle.and"|translate}}
      .operator(*ngIf="!levellast")
        ng-container(*ngIf="levelList.orOperator; else andLabel")
          | {{"common.components.advancedFilter.toggle.or"|translate}}
        ng-template(#andLabel)
          | {{"common.components.advancedFilter.toggle.and"|translate}}
