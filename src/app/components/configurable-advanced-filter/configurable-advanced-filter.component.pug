.filter-component-container
  button.filter-button(
    pButton,
    type="button",
    [label]="'common.components.advancedFilter.button'|translate",
    icon="pi pi-search",
    (click)="toggleFilter()",
  )

  // Filter Overlay
  .advanced-search-overlay.overflow-y-auto(*ngIf="visible")
    .advanced-search-panel
      .advanced-header
        h1.advanced-header-text {{"common.components.advancedFilter.header"|translate}}
        // Close Button - Positioned at top right corner
        button.p-button-sm.advanced-overlay-close(
          pButton,
          type="button",
          icon="pi pi-times",
          [pTooltip]="'common.components.advancedFilter.close'|translate",
          tooltipPosition="bottom",
          tooltipStyleClass="text-xs px-2 py-1",
          (click)="onClose()"
        )

      // Filter Content
      .advanced-filter-content
        div.space-y-2.category-box(*ngIf="categorySelection")
          label.category-title {{"common.components.advancedFilter.category"|translate}}
          p-select.w-full([options]="categories", [(ngModel)]="selectedCategory", (onChange)="filterTemplates()", optionLabel="name")

        .query-template-box(*ngIf="templateSelection")
          .query-template-header
            h3 
              i.pi.pi-briefcase(pButtonIcon) 
              | &nbsp; {{"common.components.advancedFilter.template"|translate}}
            .query-template-buttons
              button.query-button-browse((click)="toggleTemplate()") {{"common.components.advancedFilter.browse"|translate}} ({{queryTemplates.length}})
              button.query-button-save((click)="openSaveTemplate()") 
                i.pi.pi-save(pButtonIcon)
                | &nbsp; {{"common.components.advancedFilter.save"|translate}}

          .query-templates.space-y-2(*ngIf="templateVisible")
            .template-box(*ngFor="let template of queryTemplates")
              .template-alignment
                .template-left
                  .template-title-box
                    .template-title {{template.title}}
                    span.template-category {{template.category}}
                  p.template-description {{template.description}}
                  .template-date
                    span.template-date-text {{"common.components.advancedFilter.created"|translate}}: {{template.created}}
                    span.template-date-text {{"common.components.advancedFilter.lastUsed"|translate}}: {{template.lastUsed}}
                .template-right
                  button.query-button-load((click)="loadTemplate(template.templateId)") 
                    i.pi.pi-copy(pButtonIcon)
                    | &nbsp; {{"common.components.advancedFilter.load"|translate}}
                  button.query-button-delete((click)="deleteTemplate(template.templateId)") 
                    i.pi.pi-trash(pButtonIcon)

          .query-button-clear
            button.query-button-browse((click)="clearSearch()") {{"common.components.advancedFilter.clear"|translate}}


        .selection-box(*ngIf="selectedList.total > 0")
          .selection-header
            .selection-text
              strong {{"common.components.advancedFilter.selection.selected"|translate}}:
              |  {{selectedList.groups}} {{"common.components.advancedFilter.selection.group"|translate}},  {{selectedList.levels}} {{"common.components.advancedFilter.selection.level"|translate}}
            button.clear-button((click)="clearSelection()") {{"common.components.advancedFilter.selection.clear"|translate}} ({{selectedList.total}})


        div(*ngFor="let level of levels; let k = index; let levellast = last")
          div(*ngIf="level.level === '1'; else level2Block")
            div(*ngFor="let group of level.group_list; let j = index; let grouplast = last")
              .filter-group-box([ngClass]="{ 'filter-group-box-unselected': !group.selected, 'filter-group-box-selected': group.selected }")
                .filter-group-content
                  .filter-group-heading
                    .relative
                      input.filter-group-selection(*ngIf="levelCreationAllowed", type='checkbox', [value]="group.selected", (change)="onSelectionChange('group',level.levelId, group.group, $event)")
                    .filter-group-name {{group.group_name}}
                    span.group-selection-badge(*ngIf="group.selected") {{"common.components.advancedFilter.selection.forGrouping"|translate}}
                  button.filter-group-delete(*ngIf="addGroupAllowed", (click)="removeGroup(level.levelId,group.group)")
                    i.pi.pi-times(pButtonIcon)
                .grid.grid-cols-12.filter-group-header-text
                  .col-span-3 {{"common.components.advancedFilter.field"|translate}}
                  .col-span-3 {{strategyHeader}}
                  .col-span-3 {{"common.components.advancedFilter.value"|translate}}
                  .col-span-3(*ngIf="addGroupAllowed") {{"common.components.advancedFilter.actions"|translate}}
                div(*ngFor="let file of group.file_list; let i = index; let last = last")
                  .grid.grid-cols-12.filter-field-line
                    .col-span-3
                      p-select.filter-field-select([options]="fieldOptions", [(ngModel)]="file.field", [placeholder]="'common.components.advancedFilter.fieldPlaceholder'|translate", [group]="true", optionLabel="name", (onChange)="onFieldChange($event.value,file)", [disabled]="singleField != null")
                        ng-template(let-group #grp)
                          div.flex.items-center
                            span {{grp.name}}
                    .col-span-3
                      p-select.filter-field-select(*ngIf="file.fieldType == null", [options]="queryOptions", [disabled]="true", [placeholder]="'common.components.advancedFilter.strategyPlaceholder'|translate", optionLabel="name")
                      p-select.filter-field-select(*ngIf="file.fieldType == 'text'", [options]="queryOptions", [(ngModel)]="file.connecting", [placeholder]="'common.components.advancedFilter.strategyPlaceholder'|translate", optionLabel="name")
                      p-select.filter-field-select(*ngIf="file.fieldType == 'date'", [options]="dateQueryOptions", [(ngModel)]="file.connecting", [placeholder]="'common.components.advancedFilter.strategyPlaceholder'|translate", optionLabel="name")
                      p-select.filter-field-select(*ngIf="file.fieldType == 'application'", [options]="applicationTypeOptions", [(ngModel)]="file.connecting", [placeholder]="'common.components.advancedFilter.ipTypePlaceholder'|translate", optionLabel="name")
                      p-select.filter-field-select(*ngIf="file.fieldType == 'patents'", [options]="[{ code: 'patents', name: ('common.components.advancedFilter.display.applicationTypes.patents'|translate) }]", [(ngModel)]="file.connecting", optionLabel="name", [disabled]="true")
                    .col-span-3
                      input.filter-field-value(*ngIf="file.fieldType == null", [placeholder]="'common.components.advancedFilter.valuePlaceholder'|translate", [disabled]="true")
                      input.filter-field-value(*ngIf="file.fieldType == 'text'", [placeholder]="'common.components.advancedFilter.valuePlaceholder'|translate", [(ngModel)]="file.value")
                      p-datePicker.w-full.date-calendar(
                        *ngIf="file.fieldType == 'date'",
                        [(ngModel)]="file.value",
                        [placeholder]="'common.components.advancedFilter.datePlaceholder'|translate",
                        [dateFormat]="searchDateFormat || 'yy-mm-dd'",
                        [selectionMode]="file.connecting.code === 'dateRange' ? 'range' : 'single'",
                        [showIcon]="true",
                        [showButtonBar]="true",
                        [touchUI]="false",
                        [readonlyInput]="true"
                      )
                      input.filter-field-value(*ngIf="(file.fieldType == 'application' || file.fieldType == 'patents') && file.connecting.code == ''", [placeholder]="'common.components.advancedFilter.valuePlaceholder'|translate", [disabled]="true")
                      p-autocomplete.filter-field-autocomplete(
                        *ngIf="(file.fieldType == 'application' || file.fieldType == 'patents') && file.connecting.code != ''", 
                        [(ngModel)]="file.value", 
                        [suggestions]="filteredResults", 
                        (completeMethod)="searchService($event,file.connecting.code)", 
                        [minLength]="5"
                      )
                        ng-template(pTemplate="item" let-item)
                          div((click)="handleAutoCompleteItemClick($event, item)")
                            | {{ item }}
                    .col-span-3.flex.gap-1(*ngIf="addGroupAllowed")
                      button.filter-field-delete((click)="removeField(level.levelId, group.group, file.fieldId)")
                        i.pi.pi-trash(pButtonIcon)
                      button.filter-field-add(*ngIf="last", (click)="addField(level.levelId, group.group)")
                        i.pi.pi-plus(pButtonIcon)
                  .filter-operator-box(*ngIf="!last")
                    p-togglebutton.filter-operator-button(*ngIf="group.file_list?.length === 2", [(ngModel)]="file.orOperator", [onLabel]="'common.components.advancedFilter.toggle.or'|translate", [offLabel]="'common.components.advancedFilter.toggle.and'|translate", [pTooltip]="'common.components.advancedFilter.toggle.tooltip'|translate")
                    p-togglebutton.filter-operator-button(*ngIf="group.file_list?.length > 2", [(ngModel)]="file.orOperator", [onLabel]="'common.components.advancedFilter.toggle.or'|translate", [offLabel]="'common.components.advancedFilter.toggle.and'|translate",onIcon="pi pi-lock" ,offIcon="pi pi-lock", disabled="true")

              .filter-group-operator(*ngIf="!grouplast")
                p-togglebutton.filter-operator-button(*ngIf="level.group_list?.length === 2", [(ngModel)]="group.orOperator", [onLabel]="'common.components.advancedFilter.toggle.or'|translate", [offLabel]="'common.components.advancedFilter.toggle.and'|translate", [pTooltip]="'common.components.advancedFilter.toggle.tooltip'|translate")
                p-togglebutton.filter-operator-button(*ngIf="level.group_list?.length > 2", [(ngModel)]="group.orOperator", [onLabel]="'common.components.advancedFilter.toggle.or'|translate", [offLabel]="'common.components.advancedFilter.toggle.and'|translate",onIcon="pi pi-lock" ,offIcon="pi pi-lock", disabled="true")

            .filter-group-operator(*ngIf="!levellast")
              p-togglebutton.filter-operator-button(*ngIf="levels?.length === 2", [(ngModel)]="level.orOperator", [onLabel]="'common.components.advancedFilter.toggle.or'|translate", [offLabel]="'common.components.advancedFilter.toggle.and'|translate", [pTooltip]="'common.components.advancedFilter.toggle.tooltip'|translate")
              p-togglebutton.filter-operator-button(*ngIf="levels?.length > 2", [(ngModel)]="level.orOperator", [onLabel]="'common.components.advancedFilter.toggle.or'|translate", [offLabel]="'common.components.advancedFilter.toggle.and'|translate",onIcon="pi pi-lock" ,offIcon="pi pi-lock", disabled="true")


          ng-template(#level2Block)
            .filter-level-box([ngClass]="{'filter-level-box-selected': level.selected}")
              .filter-level-content
                span.filter-level-title ( {{"common.components.advancedFilter.selection.groupedLogic"|translate}} ) - {{level.level_name}}
              .filter-level-header
                .filter-level-header-content
                  .relative
                    input.filter-level-selection(*ngIf="levelCreationAllowed", type='checkbox', [value]="level.selected", (change)="onSelectionChange('level',level.levelId,'',$event)")
                  span.filter-level-text {{"common.components.advancedFilter.selection.furtherGrouping"|translate}}
                button.filter-level-ungroup((click)="unGroup(level.levelId)")
                  i.pi.pi-times(pButtonIcon)
                  |  {{"common.components.advancedFilter.selection.unGroup"|translate}}
            
              .space-y-4
                div(*ngFor="let group of level.group_list; let j = index; let grouplast = last")
                  .filter-group-box.filter-group-box-unselected
                    .filter-group-content
                      .filter-group-heading
                        .relative
                          //input.filter-group-selection(type='checkbox', [value]="group.selected", (change)="onSelectionChange('group',level.levelId, group.group,$event)")
                        .filter-group-name {{group.group_name}}
                      button.filter-group-delete(*ngIf="addGroupAllowed", (click)="removeGroup(level.levelId,group.group)")
                        i.pi.pi-times(pButtonIcon)
                    .grid.grid-cols-12.filter-group-header-text
                      .col-span-3 {{"common.components.advancedFilter.field"|translate}}
                      .col-span-3 {{"common.components.advancedFilter.strategy"|translate}}
                      .col-span-3 {{"common.components.advancedFilter.value"|translate}}
                      .col-span-3 {{"common.components.advancedFilter.actions"|translate}}
                    div(*ngFor="let file of group.file_list; let i = index; let last = last")
                      .grid.grid-cols-12.filter-field-line
                        .col-span-3
                          p-select.filter-field-select([options]="fieldOptions", [(ngModel)]="file.field", [placeholder]="'common.components.advancedFilter.fieldPlaceholder'|translate", [group]="true", optionLabel="name", (onChange)="onFieldChange($event.value,file)", [disabled]="singleField != null")
                            ng-template(let-group #grp)
                              div.flex.items-center
                                span {{grp.name}}
                        .col-span-3
                          p-select.filter-field-select(*ngIf="file.fieldType == null", [options]="queryOptions", [disabled]="true", [placeholder]="'common.components.advancedFilter.strategyPlaceholder'|translate", optionLabel="name")
                          p-select.filter-field-select(*ngIf="file.fieldType == 'text'", [options]="queryOptions", [(ngModel)]="file.connecting", [placeholder]="'common.components.advancedFilter.strategyPlaceholder'|translate", optionLabel="name")
                          p-select.filter-field-select(*ngIf="file.fieldType == 'date'", [options]="dateQueryOptions", [(ngModel)]="file.connecting", [placeholder]="'common.components.advancedFilter.strategyPlaceholder'|translate", optionLabel="name")
                          p-select.filter-field-select(*ngIf="file.fieldType == 'application'", [options]="applicationTypeOptions", [(ngModel)]="file.connecting", [placeholder]="'common.components.advancedFilter.ipTypePlaceholder'|translate", optionLabel="name")
                          p-select.filter-field-select(*ngIf="file.fieldType == 'patents'", [options]="[{ code: 'patents', name: ('common.components.advancedFilter.display.applicationTypes.patents'|translate) }]", [(ngModel)]="file.connecting", optionLabel="name", [disabled]="true")
                        .col-span-3
                          input.filter-field-value(*ngIf="file.fieldType == null", [placeholder]="'common.components.advancedFilter.valuePlaceholder'|translate", [disabled]="true")
                          input.filter-field-value(*ngIf="file.fieldType == 'text'", [placeholder]="'common.components.advancedFilter.valuePlaceholder'|translate", [(ngModel)]="file.value")
                          p-datePicker.w-full.date-calendar(
                            *ngIf="file.fieldType == 'date'",
                            [(ngModel)]="file.value",
                            [placeholder]="'common.components.advancedFilter.datePlaceholder'|translate",
                            [dateFormat]="searchDateFormat || 'yy-mm-dd'",
                            [selectionMode]="file.connecting.code === 'dateRange' ? 'range' : 'single'",
                            [showIcon]="true",
                            [showButtonBar]="true",
                            [touchUI]="false",
                            [readonlyInput]="true"
                          )
                          input.filter-field-value(*ngIf="(file.fieldType == 'application' || file.fieldType == 'patents') && file.connecting.code == ''", [placeholder]="'common.components.advancedFilter.valuePlaceholder'|translate", [disabled]="true")
                          p-autocomplete.filter-field-autocomplete(
                            *ngIf="(file.fieldType == 'application' || file.fieldType == 'patents') && file.connecting.code != ''", 
                            [(ngModel)]="file.value", 
                            [suggestions]="filteredResults", 
                            (completeMethod)="searchService($event)", 
                            [minLength]="5"
                          )
                            ng-template(pTemplate="item" let-item)
                              div((click)="handleAutoCompleteItemClick($event, item)")
                                | {{ item }}
                        .col-span-3.flex.gap-1(*ngIf="addGroupAllowed")
                          button.filter-field-delete((click)="removeField(level.levelId, group.group, file.fieldId)")
                            i.pi.pi-trash(pButtonIcon)
                          button.filter-field-add(*ngIf="last", (click)="addField(level.levelId, group.group)")
                            i.pi.pi-plus(pButtonIcon)
                      .filter-operator-box(*ngIf="!last")
                        p-togglebutton.filter-operator-button(*ngIf="group.file_list?.length === 2", [(ngModel)]="file.orOperator", [onLabel]="'common.components.advancedFilter.toggle.or'|translate", [offLabel]="'common.components.advancedFilter.toggle.and'|translate", [pTooltip]="'common.components.advancedFilter.toggle.tooltip'|translate")
                        p-togglebutton.filter-operator-button(*ngIf="group.file_list?.length > 2", [(ngModel)]="file.orOperator", [onLabel]="'common.components.advancedFilter.toggle.or'|translate", [offLabel]="'common.components.advancedFilter.toggle.and'|translate",onIcon="pi pi-lock" ,offIcon="pi pi-lock", disabled="true")

                  .filter-group-operator(*ngIf="!grouplast")
                    p-togglebutton.filter-operator-button(*ngIf="level.group_list?.length === 2", [(ngModel)]="group.orOperator", [onLabel]="'common.components.advancedFilter.toggle.or'|translate", [offLabel]="'common.components.advancedFilter.toggle.and'|translate", [pTooltip]="'common.components.advancedFilter.toggle.tooltip'|translate")
                    p-togglebutton.filter-operator-button(*ngIf="level.group_list?.length > 2", [(ngModel)]="group.orOperator", [onLabel]="'common.components.advancedFilter.toggle.or'|translate", [offLabel]="'common.components.advancedFilter.toggle.and'|translate",onIcon="pi pi-lock" ,offIcon="pi pi-lock", disabled="true")

            .filter-group-operator(*ngIf="!levellast")
                  p-togglebutton.filter-operator-button(*ngIf="levels?.length === 2", [(ngModel)]="level.orOperator", [onLabel]="'common.components.advancedFilter.toggle.or'|translate", [offLabel]="'common.components.advancedFilter.toggle.and'|translate", [pTooltip]="'common.components.advancedFilter.toggle.tooltip'|translate")
                  p-togglebutton.filter-operator-button(*ngIf="levels?.length > 2", [(ngModel)]="level.orOperator", [onLabel]="'common.components.advancedFilter.toggle.or'|translate", [offLabel]="'common.components.advancedFilter.toggle.and'|translate",onIcon="pi pi-lock" ,offIcon="pi pi-lock", disabled="true")

        .filter-group-add-line(*ngIf="addGroupAllowed")
            button.filter-group-add-button((click)="addGroup()")
              i.pi.pi-plus(pButtonIcon)
              | {{"common.components.advancedFilter.addFilterGroup"|translate}}

        br
        br

        .advanced-filter-actions
          .flex.items-center.justify-end.gap-3.sticky.bottom-0
            .action-buttons
              button.p-button-outlined.p-button-secondary(
                pButton,
                type="button",
                [label]="'common.components.advancedFilter.cancel'|translate",
                (click)="onClose()"
              )
              button.p-button-primary(
                pButton,
                type="button",
                [label]="'common.components.advancedFilter.search'|translate",
                (click)="onSearch()"
              )

    .template-dialog-overlay(*ngIf="showSaveTemplate")
      .template-dialog-container
        .template-dialog-header
          h2.template-dialog-title {{"common.components.advancedFilter.saveTemplate.title"|translate}}
        .space-y-4
          div
            label {{"common.components.advancedFilter.saveTemplate.templateName"|translate}}
            input.template-title-input(type="text", [placeholder]="'common.components.advancedFilter.saveTemplate.templatePlaceHolder'|translate", [(ngModel)]="templateTitle")
          div
            label {{"common.components.advancedFilter.saveTemplate.description"|translate}}
            textarea.template-description-textarea([placeholder]="'common.components.advancedFilter.saveTemplate.descriptionPlaceHolder'|translate", [(ngModel)]="templateDescripton")
          .template-button-group
            button.p-button-secondary(pButton, type='button', (click)="closeSaveTemplate()") {{"common.components.advancedFilter.saveTemplate.cancel"|translate}}
            button.p-button-primary(pButton, type='button', (click)="saveAsTemplate()") {{"common.components.advancedFilter.saveTemplate.save"|translate}}
        button.template-close-button(type='button', (click)="closeSaveTemplate()")
          i.pi.pi-times(pButtonIcon)

    .filter-group-button-container(*ngIf="selectedList.total > 1")
      button.filter-group-button(*ngIf="selectedList.levels == 0", (click)="createLevel2()")
        i.pi.pi-server(pButtonIcon)
        |  {{"common.components.advancedFilter.groupButton.group"|translate}} {{selectedList.groups}} {{"common.components.advancedFilter.groupButton.items"|translate}}
      button.filter-group-add-level-button(*ngIf="selectedList.levels == 1", (click)="mergeWithSelectedLevel()")
        i.pi.pi-bolt(pButtonIcon)
        |  {{"common.components.advancedFilter.groupButton.addGroup"|translate}}