.grid.grid-cols-6.mt-2([style]="disabled? 'display:none' : '' ")
    .col-span-6.grid.grid-cols-12.filter
      .col-span-4([style]="showSearchBar? '' :'display:none' ")
        p-floatlabel(variant='on')
          p-iconfield
            p-inputicon.pi.pi-search
            input.w-full#on_label(pInputText='', [(ngModel)]='searchBar', (input)="onFilterSearch(searchBar)", autocomplete='off')
          label(for='on_label') {{ searchLabel }}
      .col-span-4([style]="showDateSearchBar? '' :'display:none' ")
          p-datePicker.w-full.date-calendar(
            [(ngModel)]="searchBarDate",
            [placeholder]="dateSearchLabel || 'Select date'",
            [dateFormat]="searchDateFormat || 'yy-mm-dd'",
            selectionMode="range",
            [showIcon]="true",
            [showButtonBar]="true",
            [touchUI]="false",
            [readonlyInput]="true",
            appendTo="body",
            (onSelect)="onCalenderSelect($event)",
            (onClearClick)="onClearEvent($event)"
          )
      .col-span-8.flex.justify-end.gap-2.filter-icons
        p-button(
          *ngFor="let act of actions",
          [icon]="act.icon",
          [outlined]="true",
          [text]="true",
          [pTooltip]="act.label",
          (click)="onActionClick(act.action)",
        )
        app-configurable-filter(
          [filters]="filters",
          [showClearAll]="true",
          [showApplyButton]="true",
          [showFilterSelector]="true",
          [filterSelectorPlaceholder]="'Select filters to display'",
          (filterChange)="onFilterChange($event)",
          (filterCleared)="onFilterCleared()",
          (filterApplied)="onFilterApplied($event)",
          (appliedFiltersChange)="onAppliedFiltersChange($event)",
        )
        p-button( *ngIf="showDownloadIcon",
          icon="pi pi-file-pdf",
          [outlined]="true",
          [text]="true",
          (click)="onDownloadDetails()",
        )
        p-button( *ngIf="showInfoIcon",
          icon="pi pi-info-circle",
          [outlined]="true",
          [text]="true",
          (click)="onInfoDetails()",
        )
.mt-1.w-full([style]="(disabled || appliedFilters.length == 0)? 'display:none' : '' ")
  app-filter-chips(
    [appliedFilters]="appliedFilters",
    [showClearAll]="filterClearAll",
    [clearAllLabel]="'Clear All'",
    [getDisplayValue]="getFilterDisplayValue.bind(this)",
    (chipRemove)="removeFilterChip($event)",
    (clearAll)="clearAllFilters()"
  )