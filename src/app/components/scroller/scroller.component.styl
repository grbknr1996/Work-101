.scroller-container
  position fixed
  bottom 1.5rem
  right 1.5rem
  width 2.5rem
  height 2.5rem
  background var(--p-primary-500, #0067c0)
  border-radius 50%
  display flex
  align-items center
  justify-content center
  cursor pointer
  box-shadow 0 3px 8px rgba(0, 103, 192, 0.3)
  transition all 0.3s cubic-bezier(0.4, 0, 0.2, 1)
  z-index 1000
  opacity 0
  transform translateY(100px) scale(0.8)
  visibility hidden
  border 1px solid rgba(255, 255, 255, 0.1)

  &:hover
    background var(--p-primary-600, #0052a3)
    transform translateY(0) scale(1.05)
    box-shadow 0 4px 12px rgba(0, 103, 192, 0.4)

    .scroller-icon
      transform translateY(-2px)

    .scroller-tooltip
      opacity 1
      transform translateY(0)

  &:active
    transform translateY(0) scale(0.95)

  &.show
    opacity 0.5
    transform translateY(0) scale(1)
    visibility visible
    animation scrollerFadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards

  &.hide
    opacity 0
    transform translateY(100px) scale(0.8)
    visibility hidden
    animation scrollerFadeOut 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards

  &:focus
    outline 2px solid var(--p-primary-300, #66a3da)
    outline-offset 2px

.scroller-icon
  color white
  font-size 0.9rem
  font-weight bold
  transition transform 0.2s ease

.scroller-tooltip
  position absolute
  bottom 100%
  right 0
  background rgba(0, 0, 0, 0.8)
  color white
  padding 0.5rem 0.75rem
  border-radius 0.375rem
  font-size 0.875rem
  white-space nowrap
  opacity 0
  transform translateY(10px)
  transition all 0.2s ease
  pointer-events none
  margin-bottom 0.5rem

  &::after
    content ''
    position absolute
    top 100%
    right 1rem
    border 5px solid transparent
    border-top-color rgba(0, 0, 0, 0.8)

// Mobile responsiveness
@media (max-width: 768px)
  .scroller-container
    bottom 1rem
    right 1rem
    width 2.2rem
    height 2.2rem

  .scroller-icon
    font-size 0.8rem

  .scroller-tooltip
    display none // Hide tooltip on mobile for cleaner UI

// Dark mode support
@media (prefers-color-scheme: dark)
  .scroller-container
    background var(--p-primary-600, #0052a3)
    box-shadow 0 4px 12px rgba(0, 103, 192, 0.4)

    &:hover
      background var(--p-primary-700, #003e87)
      box-shadow 0 6px 20px rgba(0, 103, 192, 0.5)

// Animations
@keyframes scrollerFadeIn
  from
    opacity 0
    transform translateY(100px) scale(0.8)
  to
    opacity 0.5
    transform translateY(0) scale(1)

@keyframes scrollerFadeOut
  from
    opacity 0.5
    transform translateY(0) scale(1)
  to
    opacity 0
    transform translateY(100px) scale(0.8)