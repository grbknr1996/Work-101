// Scroll to Top Button
.scroller-container(
  [class.show]="showScroller",
  [class.hide]="!showScroller",
  (click)="scrollToTop()",
  role="button",
  tabindex="0",
  (keydown.enter)="scrollToTop()",
  (keydown.space)="scrollToTop()"
)
  i.pi.pi-chevron-up.scroller-icon
  
  .scroller-tooltip
    span {{"common.components.scroller.backToTop"|translate}}