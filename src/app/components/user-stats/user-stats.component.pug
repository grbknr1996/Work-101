.user-stats-container
  .user-stat-card(
    *ngFor="let stat of userStats"
    "[class.selected]"="selectedStat === stat.key"
    "(click)"="selectStat(stat.key)"
  )
    .stat-header
      span.stat-label("[style.color]"="stat.color") {{ stat.label }}
      i(
        *ngIf="config.showIcons !== false"
        "[class]"="stat.icon", 
        "[style.color]"="stat.color"
      )
    
    .stat-content
      span.stat-count(
        *ngIf="config.showCounts !== false"
        "[style.color]"="stat.color"
      ) {{ stat.count }}