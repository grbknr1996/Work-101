p-dialog(
  [header]="config.header",
  [(visible)]="visible",
  [modal]="true",
  [style]="{ width: config.width || '500px' }",
  [draggable]="false",
  [resizable]="false",
  (onHide)="onClose()"
)
  .modal-content
    .modal-icon(*ngIf="config.showIcon")
      i(
        [class]="config.iconClass || 'pi pi-info-circle'",
        [style]="{ 'font-size': config.iconSize || '3rem', color: config.iconColor || '#2196f3' }"
      )
    .modal-message([innerHTML]="config.content")
  
  ng-template(pTemplate="footer")
    //- Custom buttons
    div(
      *ngIf="config.buttons && config.buttons.length > 0",
      class="modal-buttons"
    )
      button(
        *ngFor="let button of config.buttons",
        pButton,
        type="button",
        [label]="button.label",
        [icon]="button.icon",
        [class]="button.class || 'p-button-secondary'",
        (click)="onButtonClick(button)"
      )
    
    //- Default close button (when no custom buttons)
    button(
      *ngIf="(!config.buttons || config.buttons.length === 0) && config.showCloseButton !== false",
      pButton,
      type="button",
      [label]="config.closeButtonText || 'Close'",
      class="p-button-primary",
      (click)="onClose()"
    )