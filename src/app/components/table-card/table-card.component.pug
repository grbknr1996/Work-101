.table-card-container
  // Sort Controls Bar
  .controls-bar.mb-4
    .sort-container
      label.sort-label Sort by:
      p-dropdown(
        [options]="sortOptions",
        [(ngModel)]="selectedSortField",
        optionLabel="label",
        optionValue="value",
        placeholder="Select field to sort",
        (onChange)="onSortFieldChange($event)",
        styleClass="w-full"
      )
    .controls-right
      button(
        pButton,
        type="button",
        [icon]="sortOrder === 1 ? 'pi pi-sort-amount-up' : 'pi pi-sort-amount-down'",
        class="p-button-outlined p-button-sm",
        (click)="toggleSortOrder()",
        pTooltip="Toggle sort order"
      )

  // Loading State
  .loading-container.text-center.p-4(*ngIf="loading")
    i.pi.pi-spin.pi-spinner(style="font-size: 2rem")
    p.mt-2 Loading...

  // Cards Grid
  .cards-grid(*ngIf="!loading")
    .card-item(*ngFor="let item of getCurrentData(); trackBy: trackByFn")
      p-card(styleClass="h-full")
        ng-template(pTemplate="header")
          // Card Header Section
          .card-header
            .header-left
              .avatar-section
                p-avatar(
                  *ngIf="getAvatarField()",
                  [image]="isValidImageUrl(getValue(item, getAvatarField())) ? getValue(item, getAvatarField()) : null",
                  [label]="!isValidImageUrl(getValue(item, getAvatarField())) ? getValue(item, getAvatarField()) : null",
                  [alt]="getValue(item, getNameField()) || getValue(item, 'userName') || 'User'",
                  size="large",
                  shape="circle"
                )
                .avatar-fallback(*ngIf="!getAvatarField()")
                  i.pi.pi-image(style="font-size: 2rem; color: var(--p-tag-contrast-color)")
              .header-info
                h3.header-title {{ getValue(item, getNameField()) || getValue(item, 'userName') || 'User' }}
                .header-subtitle
                  p-tag(
                    *ngIf="getStatusField()",
                    [value]="getStatusValue(item)",
                    [severity]="getStatusSeverity(item)",
                    styleClass="text-xs"
                  )
            .header-right
              // Actions Menu in Header
              .actions-section
                ng-container(*ngFor="let col of columns")
                  ng-container(*ngIf="col.display === 'actions' && col.actions")
                    // Actions as dropdown
                    ng-container(*ngIf="col.showAsDropdown !== false")
                      button.p-button-rounded.p-button-text.p-button-plain.header-actions-btn(
                        pButton,
                        type="button",
                        icon="pi pi-ellipsis-v",
                        (click)="menu.toggle($event); $event.stopPropagation()"
                      )
                      p-menu(
                        #menu,
                        [popup]="true",
                        appendTo="body",
                        [model]="getMenuItems(col.actions, item)"
                      )

        ng-template(pTemplate="content")
          // Card Content with Organized Sections
          .card-content
            // Card Body Section
            .card-section.body-section
              .content-row(
                *ngFor="let col of getColumnsBySection('body')",
                [ngClass]="col.customClass"
              )
                .field-label {{ col.label }}
                .field-value
                  // Text Display
                  ng-container(*ngIf="col.display === 'text' || !col.display") {{ getValue(item, col.field) }}
                  // Date Display
                  ng-container(*ngIf="col.display === 'date'") {{ getValue(item, col.field) | date : col.dateFormat || 'MM/dd/yyyy' }}
                  // Currency Display
                  ng-container(*ngIf="col.display === 'currency'") {{ getValue(item, col.field) | currency : col.currency || 'USD' : 'symbol' }}
                  // Tag Display
                  ng-container(*ngIf="col.display === 'tag'")
                    p-tag(
                      [value]="getValue(item, col.field)",
                      [severity]="col.severity ? col.severity(getValue(item, col.field)) : 'success'"
                    )
                  // Progress Display
                  ng-container(*ngIf="col.display === 'progress'")
                    p-progressBar(
                      [value]="getValue(item, col.field)",
                      [showValue]="false"
                    )
                  // Icon Display
                  ng-container(*ngIf="col.display === 'icon'")
                    i.pi(
                      [ngClass]="col.iconClass ? col.iconClass(getValue(item, col.field)) : ''",
                      style="font-size: 1.5rem"
                    )
                  // Boolean Display
                  ng-container(*ngIf="col.display === 'boolean'")
                    .text-center
                      i.pi(
                        [ngClass]="{ 'text-green-500 pi-check-circle': getValue(item, col.field), 'text-red-500 pi-times-circle': !getValue(item, col.field) }"
                      )
                  // Custom Template
                  ng-container(*ngIf="col.display === 'custom'")
                    ng-container(
                      *ngTemplateOutlet="customCellTemplate",
                      [context]="{ $implicit: item, field: col.field }"
                    )

            // Card Info Section
            .card-section.info-section
              .content-row(
                *ngFor="let col of getColumnsBySection('info')",
                [ngClass]="col.customClass"
              )
                .field-label {{ col.label }}
                .field-value
                  // Text Display
                  ng-container(*ngIf="col.display === 'text' || !col.display") {{ getValue(item, col.field) }}
                  // Date Display
                  ng-container(*ngIf="col.display === 'date'") {{ getValue(item, col.field) | date : col.dateFormat || 'MM/dd/yyyy' }}
                  // Currency Display
                  ng-container(*ngIf="col.display === 'currency'") {{ getValue(item, col.field) | currency : col.currency || 'USD' : 'symbol' }}
                  // Tag Display
                  ng-container(*ngIf="col.display === 'tag'")
                    p-tag(
                      [value]="getValue(item, col.field)",
                      [severity]="col.severity ? col.severity(getValue(item, col.field)) : 'success'"
                    )
                  // Progress Display
                  ng-container(*ngIf="col.display === 'progress'")
                    p-progressBar(
                      [value]="getValue(item, col.field)",
                      [showValue]="false"
                    )
                  // Icon Display
                  ng-container(*ngIf="col.display === 'icon'")
                    i.pi(
                      [ngClass]="col.iconClass ? col.iconClass(getValue(item, col.field)) : ''",
                      style="font-size: 1.5rem"
                    )
                  // Boolean Display
                  ng-container(*ngIf="col.display === 'boolean'")
                    .text-center
                      i.pi(
                        [ngClass]="{ 'text-green-500 pi-check-circle': getValue(item, col.field), 'text-red-500 pi-times-circle': !getValue(item, col.field) }"
                      )
                  // Custom Template
                  ng-container(*ngIf="col.display === 'custom'")
                    ng-container(
                      *ngTemplateOutlet="customCellTemplate",
                      [context]="{ $implicit: item, field: col.field }"
                    )

        ng-template(pTemplate="footer")
          // Card Footer - Empty for now, actions moved to header

  // Empty State
  .empty-state.text-center.p-8(*ngIf="!loading && getCurrentData().length === 0")
    i.pi.pi-inbox(style="font-size: 3rem; color: #6c757d; margin-bottom: 1rem")
    h3.text-lg.font-semibold.text-gray-700.mb-2 No data found
    p.text-gray-500 {{ emptyMessage }}

  // Pagination
  .pagination-container.mt-6(*ngIf="paginator && totalRecords > 0")
    p-paginator(
      [rows]="rows",
      [totalRecords]="totalRecords",
      [rowsPerPageOptions]="rowsPerPageOptions",
      [showCurrentPageReport]="showCurrentPageReport",
      [currentPageReportTemplate]="currentPageReportTemplate",
      (onPageChange)="onPageChange($event)",
      (onLazyLoad)="onLazyLoad.emit($event)"
    )