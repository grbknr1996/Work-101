// Filter Component Container
.filter-component-container
  // Filter Button - Right Side
  button.p-button-outlined.p-button-secondary.filter-button(
    pButton,
    type="button",
    icon="pi pi-sliders-h",
    [class.has-active-filters]="hasActiveFilters",
    (click)="toggleFilter()",
    [pTooltip]="'configurableFilter.openFilter' | translate",
    tooltipPosition="bottom",
    tooltipStyleClass="text-xs px-2 py-1"
  )

  // Filter Overlay
  .filter-overlay(*ngIf="visible")
    .filter-panel.filter-panel-left
      // Close Button - Positioned at top right corner
      button.p-button-text.p-button-sm.close-button-overlay(
        pButton,
        type="button",
        icon="pi pi-times",
        [pTooltip]="'configurableFilter.close' | translate",
        tooltipPosition="bottom",
        tooltipStyleClass="text-xs px-2 py-1",
        (click)="onClose()"
      )

      // Header with Filter Selector and Icons
      .filter-header(*ngIf="showFilterSelector")
        .filter-selector-section
          label.filter-selector-label {{ 'configurableFilter.displayFilters' | translate }}:
          .filter-selector-controls
            p-multiSelect.filter-selector(
              [options]="getFilterSelectorOptions()",
              [(ngModel)]="selectedFilters",
              [placeholder]="filterSelectorPlaceholder",
              [showClear]="false",
              [showFilter]="true",
              (onChange)="onFilterSelectorChange()",
              optionLabel="label",
              optionValue="value",
              appendTo="body"
            )

      // Filter Content
      .filter-content
        form.filter-form([formGroup]="filterForm")
          .filter-sections
            .filter-section(*ngFor="let sectionKey of getSectionKeys()")
              h3.section-title {{ sectionKey }}
              .filter-options
                .filter-option(*ngFor="let filter of getFiltersBySection()[sectionKey]")
                  // Checkbox Type
                  .checkbox-option(*ngIf="filter.type === 'checkbox'")
                    p-checkbox(
                      [formControlName]="filter.key",
                      [binary]="true",
                      [inputId]="filter.key"
                    )
                    label.checkbox-label([for]="filter.key") {{ filter.label | translate }}

                  // Radio Type
                  .radio-option(*ngIf="filter.type === 'radio'")
                    label.filter-label {{ filter.label | translate }}
                    .radio-group
                      .radio-item(*ngFor="let option of filter.options; let i = index")
                        p-radioButton(
                          [formControlName]="filter.key",
                          [value]="option.value",
                          [inputId]="filter.key + '_' + i",
                          [name]="filter.key"
                        )
                        label.radio-label([for]="filter.key + '_' + i") {{ option.label | translate }}

                  // Multi-Select Type
                  .multiselect-option(*ngIf="filter.type === 'multiSelect'")
                    label.filter-label {{ filter.label | translate }}
                    p-multiSelect.w-full(
                      [formControlName]="filter.key",
                      [options]="filter.options || []",
                      [placeholder]="filter.placeholder || ('configurableFilter.selectOptions' | translate)",
                      [showClear]="filter.showClear !== false",
                      [showFilter]="filter.showFilter !== false",
                      [filterBy]="filter.filterBy || 'label'",
                      [optionLabel]="filter.optionLabel || 'label'",
                      [optionValue]="filter.optionValue || 'value'",
                      appendTo="body"
                    )

                  // Dropdown Type
                  .dropdown-option(*ngIf="filter.type === 'dropdown'")
                    label.filter-label {{ filter.label | translate }}
                    p-dropdown.w-full(
                      [formControlName]="filter.key",
                      [options]="filter.options || []",
                      [placeholder]="filter.placeholder || ('configurableFilter.selectOption' | translate)",
                      [showClear]="filter.showClear !== false",
                      [filter]="filter.showFilter !== false",
                      [filterBy]="filter.filterBy || 'label'",
                      [optionLabel]="filter.optionLabel || 'label'",
                      [optionValue]="filter.optionValue || 'value'",
                      appendTo="body"
                    )

                  // Text Input Type
                  .text-option(*ngIf="filter.type === 'text'")
                    label.filter-label {{ filter.label | translate }}
                    input.w-full(
                      pInputText,
                      [formControlName]="filter.key",
                      [placeholder]="filter.placeholder || ('configurableFilter.enterText' | translate)"
                    )

                  // Number Input Type
                  .number-option(*ngIf="filter.type === 'number'")
                    label.filter-label {{ filter.label | translate }}
                    p-inputNumber.w-full(
                      [formControlName]="filter.key",
                      [placeholder]="filter.placeholder || ('configurableFilter.enterNumber' | translate)",
                      [min]="filter.min",
                      [max]="filter.max",
                      [step]="filter.step"
                    )

                  // Date Input Type
                  .date-option(*ngIf="filter.type === 'date'")
                    label.filter-label {{ filter.label | translate }}
                    p-datePicker.w-full.date-calendar(
                      [formControlName]="filter.key",
                      [placeholder]="filter.placeholder || ('configurableFilter.selectDate' | translate)",
                      [dateFormat]="filter.dateFormat || 'dd/mm/yy'",
                      [showClear]="filter.showClear !== false",
                      [showIcon]="true",
                      [showButtonBar]="true",
                      [touchUI]="false",
                      appendTo="body"
                    )

                  // Date Range Input Type
                  .daterange-option(*ngIf="filter.type === 'dateRange'")
                    label.filter-label {{ filter.label | translate }}
                    p-datePicker.w-full.date-range-calendar(
                      [formControlName]="filter.key",
                      [placeholder]="filter.placeholder || ('configurableFilter.selectDateRange' | translate)",
                      [dateFormat]="filter.dateFormat || 'dd/mm/yy'",
                      [showClear]="filter.showClear !== false",
                      selectionMode="range",
                      [showIcon]="true",
                      [showButtonBar]="true",
                      [touchUI]="false",
                      [class.error]="hasDateRangeError(filter.key)",
                      appendTo="body"
                    )
                    small.error-message(*ngIf="hasDateRangeError(filter.key)") {{ getDateRangeError(filter.key) }}

      // Action Buttons
      .filter-actions(*ngIf="showClearAll || showApplyButton")
        .action-buttons
          button.p-button-outlined.p-button-secondary(
            *ngIf="showClearAll",
            pButton,
            type="button",
            [label]="'configurableFilter.clearAll' | translate",
            (click)="onClearAll()"
          )
          button.p-button-primary(
            *ngIf="showApplyButton",
            pButton,
            type="button",
            [label]="'configurableFilter.apply' | translate",
            (click)="onApplyFilters()"
          )