div(
  *ngIf="control?.invalid && (control?.dirty || control?.touched)",
  class="validation-errors"
)
  div(*ngIf="control?.errors?.['required']", class="error-message")
    | {{ 'validation.errors.required' | translate }}
  
  div(*ngIf="control?.errors?.['email']", class="error-message")
    | {{ 'validation.errors.email' | translate }}
  
  div(*ngIf="control?.errors?.['minlength']", class="error-message")
    | {{ 'validation.errors.minlength' | translate: {requiredLength: control?.errors?.['minlength'].requiredLength} }}
  
  div(*ngIf="control?.errors?.['pattern']", class="error-message")
    | {{ 'validation.errors.pattern' | translate }}
  
  div(*ngIf="control?.errors?.['maxlength']", class="error-message")
    | {{ 'validation.errors.maxlength' | translate: {requiredLength: control?.errors?.['maxlength'].requiredLength} }}
  
  div(*ngIf="control?.errors?.['min']", class="error-message")
    | {{ 'validation.errors.min' | translate: {min: control?.errors?.['min'].min} }}
  
  div(*ngIf="control?.errors?.['max']", class="error-message")
    | {{ 'validation.errors.max' | translate: {max: control?.errors?.['max'].max} }}