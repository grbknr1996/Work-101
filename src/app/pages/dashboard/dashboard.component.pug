app-layout([config]="layoutConfig")
  app-breadcrumbs
  
  // Error State
  div(*ngIf="permissionError", class="flex justify-center items-center min-h-[60vh] p-5")
    div(class="bg-white rounded-xl p-10 text-center shadow-2xl max-w-md w-full")
      div(class="mb-5")
        i(class="pi pi-exclamation-circle text-8xl text-red-500", style="font-size: 20pt")
      h2(class="text-2xl font-semibold text-gray-800 mb-4") Permission Error
      p(class="text-gray-600 text-base leading-relaxed mb-8") {{ errorMessage }}
      button(
        pButton,
        type="button",
        label="TRY AGAIN",
        icon="pi pi-refresh",
        class="p-button-primary min-w-[120px] h-10 font-medium hover:transform hover:-translate-y-0.5 hover:shadow-lg transition-all duration-200",
        (click)="retryPermissions()"
      )

  div(*ngIf="!permissionError")
    div(class="dashboard-heading")
      h1(class="dashboard-title") WELCOME TO WIPO IP OFFICE SUITE
      h2(class="dashboard-subtitle") WIPO IP ADMINISTRATION SYSTEM
    
    div(class="widgets-grid")
      div(class="widget-wrapper", *ngFor="let widget of widgets")
        app-widget(
          [icon]="widget.icon",
          [title]="widget.title",
          [items]="widget.items",
          [showBadge]="widget.showBadge",
          [badge]="widget.badge",
          [hoverEffect]="'shadow'"
        )