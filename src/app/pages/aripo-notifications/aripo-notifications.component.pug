app-layout([config]="layoutConfig")
  app-breadcrumbs([items]="breadcrumbItems")
  p-tabView
    p-tabpanel(value="aripo")
      ng-template(pTemplate="header")
        div((click)="onTabClick($event, 'aripo-incoming')") ARIPO Notifications
      app-package-stats([packageStats]="aripoStats",
        (statSelected)="onStatSelect($event)",
        [selectedStat]="'TOTAL IN MONTH'")
      app-configurable-filter-bar(
              [filters]="aripoFilterConfigs",
              [showClearAll]="true",
              [showApplyButton]="true",
              [showFilterSelector]="true",
              [filterSelectorPlaceholder]="'Select filters to display'",
              (filterChange)="onFilterChange($event)",
              (filterCleared)="onFilterCleared()",
              (filterApplied)="onFilterApplied($event)",
              (appliedFiltersChange)="onAppliedFiltersChange($event)",
              [showSearchBar]="true",
              [searchBar]="searchBar",
              (filterSearch)="filterSearch($event)",
              [searchLabel]="'Search File Id'",
              [showDownloadIcon]="false",
              [appliedFilters]="appliedFilters",
              [clearAllLabel]="'Clear All'",
              [getDisplayValue]="getFilterDisplayValue.bind(this)",
              (chipRemove)="removeFilterChip($event)",
              (clearAll)="clearAllFilters()",
            )
      p-tabView
          p-tabpanel(value="aripo-incoming")
              ng-template(pTemplate="header")
                div((click)="onHeaderClick($event, 'aripo-incoming')") ARIPO Incoming Notifications
              app-table([columns]="aripoIncomingTableColumns", [data]="aripoIncomingTableData", (actionClick)="onActionClick($event.action, $event.item)", [showClearButton]="false", [showSearch]="false") 
          p-tabpanel(value="aripo-outgoing")
              ng-template(pTemplate="header")
                div((click)="onHeaderClick($event, 'aripo-outgoing')") ARIPO Outgoing Notifications 
              app-table([columns]="aripoOutgoingTableColumns", [data]="aripoOutgoingTableData", (actionClick)="onActionClick($event.action, $event.item)", [showClearButton]="false", [showSearch]="false")
        
    p-tabpanel(value="hague")
      ng-template(pTemplate="header")
        div((click)="onTabClick($event, 'hague-incoming')") Hague Notifications

      p-tabView
        p-tabpanel(value="hague-incoming")
          ng-template(pTemplate="header")
            div((click)="onHeaderClick($event, 'hague-incoming')") Hague Incoming Notifications

        p-tabpanel(value="hague-outgoing")
          ng-template(pTemplate="header")
            div((click)="onHeaderClick($event, 'hague-outgoing')") Hague Outgoing Notifications 


    p-tabpanel(value="madrid")
      ng-template(pTemplate="header")
        div((click)="onTabClick($event, 'madrid-incoming')") Madrid Notifications

      p-tabView
        p-tabpanel(value="madrid-incoming")
          ng-template(pTemplate="header")
            div((click)="onHeaderClick($event, 'madrid-incoming')") Madrid Incoming Notifications

        p-tabpanel(value="madrid-outgoing")
          ng-template(pTemplate="header")
            div((click)="onHeaderClick($event, 'madrid-outgoing')") Madrid Outgoing Notifications


    p-tabpanel( value="office")
      ng-template(pTemplate="header")
        div((click)="onTabClick($event, 'office-incoming')") My Office  Notifications

      



