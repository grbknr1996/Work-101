app-layout([config]="layoutConfig")
  app-breadcrumbs([items]="breadcrumbItems")
  .user-accounts-header
    h1 {{"dataService.selectOffice.title"|translate}}
  p-select([options]='offices', [(ngModel)]='selectedOffice', (onChange)="onOfficeChange($event)", [placeholder]="'dataService.selectOffice.placeHolder'|translate", optionLabel='name',)
  br
  button.create-user-btn(pButton, type="button", (click)="onSelectOffice()") {{"dataService.selectOffice.button"|translate}}