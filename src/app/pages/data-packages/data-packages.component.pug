app-layout([config]="layoutConfig")
  app-breadcrumbs([items]="breadcrumbItems")
  .user-accounts-header
    h1 Data Sharing
  app-package-stats([packageStats]="packageStats",
    (statSelected)="onStatSelect($event)",
    [selectedStat]="'TOTAL IN MONTH'")
  .mb-4.flex.justify-between.items-center
    .flex-1
    .flex.items-center.gap-3
      app-configurable-filter(
        [filters]="filterConfigs",
        [showClearAll]="true",
        [showApplyButton]="true",
        [showSearch]="true"
        [searchPlaceholder]="'Search Package Name'",
        (filterChange)="onFilterChange($event)",
        (filterCleared)="onFilterCleared()",
        (filterApplied)="onFilterApplied($event)",
        (searchChange)="onSearchChange($event)"
      )
  app-table([columns]="tableColumns", [data]="tableData", (actionClick)="onActionClick($event.action, $event.item)", [searchPlaceHolder]="'Search Package Name'") 