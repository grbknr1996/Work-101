app-layout
  app-breadcrumbs([items]="breadcrumbItems")
  .user-accounts-header
    h1 {{"dataService.dataSharing.title"|translate}}
  app-package-stats([packageStats]="packageStats",
    (statSelected)="onStatSelect($event)",
    [selectedStat]="statSelected")
  app-configurable-filter-bar(
          [filters]="filterConfigs",
          [showClearAll]="true",
          [showApplyButton]="true",
          [showFilterSelector]="true",
          [filterSelectorPlaceholder]="'dataService.dataSharing.filter.placeHolder'|translate",
          (filterChange)="onFilterChange($event)",
          (filterCleared)="onFilterCleared()",
          (filterApplied)="onFilterApplied($event)",
          (appliedFiltersChange)="onAppliedFiltersChange($event)",
          [showSearchBar]="true",
          [searchBar]="searchBar",
          (filterSearch)="filterSearch($event)",
          [searchLabel]="'dataService.dataSharing.filter.search'|translate",
          [showDownloadIcon]="false",
          [filterClearAll]="false",
          [appliedFilters]="appliedFilters",
          [getDisplayValue]="getFilterDisplayValue.bind(this)",
          (chipRemove)="removeFilterChip($event)",
          (clearAll)="clearAllFilters()",
          (removeDefaultFilter)="removeDefaultFilter($event)",
          [showAdvancedSearch]="true",
          [showAdvancedSearchQuery]="true",
          [category]="'datapackages'",
          [categorySelection]="false",
          [templateSelection]="false",
          [levelCreationAllowed]="false",
          (advancedFilterSearch)="onAdvancedFilterSearch($event)"
        )
  app-table([columns]="tableColumns", [data]="tableData", (actionClick)="onActionClick($event.action, $event.item)", [showClearButton]="false", [showSearch]="false") 