app-layout
  app-breadcrumbs([items]="breadcrumbItems")
  .user-accounts-header
    h1 {{"dataService.dataSharing.title"|translate}}
  app-package-stats([packageStats]="packageStats",
    (statSelected)="onStatSelect($event)",
    [selectedStat]="statSelected")
  app-configurable-filter-bar(
          [filters]="filterConfigs",
          [showClearAll]="true",
          [showApplyButton]="true",
          [showFilterSelector]="true",
          [filterSelectorPlaceholder]="'dataService.dataSharing.filter.placeHolder'|translate",
          (filterChange)="onFilterChange($event)",
          (filterCleared)="onFilterCleared()",
          (filterApplied)="onFilterApplied($event)",
          (appliedFiltersChange)="onAppliedFiltersChange($event)",
          [showAutoComplete]="true",
          [autoCompleteSuggestions]="autoCompleteSuggestions",
          (searchItemSelected)="searchItemSelected($event)",
          (autoCompleteSearch)="autoCompleteSearch($event)",
          [actions]="filterActions",
          (actionClick)="onFilterActionClick($event)",
          [searchLabel]="'dataService.dataSharing.filter.search'|translate",
          [showDownloadIcon]="false",
          [filterClearAll]="false",
          [appliedFilters]="appliedFilters",
          [getDisplayValue]="getFilterDisplayValue.bind(this)",
          (chipRemove)="removeFilterChip($event)",
          (clearAll)="clearAllFilters()",
          (removeDefaultFilter)="removeDefaultFilter($event)",
          [showAdvancedSearch]="true",
          [showAdvancedSearchQuery]="true",
          [category]="'datapackages'",
          [advancedFilterMode]="'simple'",
          (advancedFilterSearch)="onAdvancedFilterSearch($event)"
        )
  app-table(
      [columns]="tableColumns", 
      [data]="tableData", 
      (actionClick)="onActionClick($event.action, $event.item)", 
      [showSearch]="false", 
      [emptyMessage]="emptyMessage", 
      [showCurrentPageReport]="true", 
      currentPageReportTemplate="{currentPage}", 
      [rows]="pageSize", 
      [totalRecords]="totalRecords", 
      [lazy]="true", 
      (onLazyLoad)="onLazyLoad($event)",
      [simplePaginator]="true",
    )

  .quality-dialog-overlay(*ngIf="qualityReportMessage")
      .quality-dialog-container
        .quality-dialog-header
          h2.quality-dialog-title {{"dataService.dataSharing.report.header"|translate}}
        .space-y-4
          div
            label {{"dataService.dataSharing.report.message"|translate}}
          .quality-button-group
            button.p-button-secondary(pButton, type='button', (click)="closeQualtiyReportMessage()") {{"dataService.dataSharing.report.button"|translate}}
        button.quality-close-button(type='button', (click)="closeQualtiyReportMessage()")
          i.pi.pi-times(pButtonIcon)