app-layout([config]="layoutConfig")
  app-breadcrumbs([items]="breadcrumbItems")
  
  .user-accounts-header
    h1 Authority Files
  
  app-package-stats(
    [packageStats]="packageStats",
    (statSelected)="onStatSelect($event)",
    [selectedStat]="'All'"
  )
  
  .grid.grid-cols-6.mt-2
    .col-span-6.grid.grid-cols-12.filter
      .col-span-4
        p-floatlabel(variant="on")
          p-iconfield
            p-inputicon.pi.pi-search
            input.w-full(
              id="on_label",
              pInputText="",
              [(ngModel)]="searchBar",
              (input)="filterSearch(searchBar)",
              autocomplete="off"
            )
          label(for="on_label") Search Publication Number
      
      .col-span-8.flex.justify-end.gap-2.filter-icons
        app-configurable-filter(
          [filters]="filterConfigs",
          [showClearAll]="true",
          [showApplyButton]="true",
          [showFilterSelector]="true",
          [filterSelectorPlaceholder]="'Select filters to display'",
          (filterChange)="onFilterChange($event)",
          (filterCleared)="onFilterCleared()",
          (filterApplied)="onFilterApplied($event)",
          (appliedFiltersChange)="onAppliedFiltersChange($event)"
        )
        p-button(
          icon="pi pi-file-pdf",
          [outlined]="true",
          [text]="true",
          (click)="downloadDetails(); $event.stopPropagation()"
        )
  
  .mb-8.mt-1.w-full
    app-filter-chips(
      [appliedFilters]="appliedFilters",
      [showClearAll]="true",
      [clearAllLabel]="'Clear All'",
      [getDisplayValue]="getFilterDisplayValue.bind(this)",
      (chipRemove)="removeFilterChip($event)",
      (clearAll)="clearAllFilters()"
    )
  
  app-table(
    [columns]="tableColumns",
    [data]="tableData",
    [showClearButton]="false",
    [showSearch]="false"
  )