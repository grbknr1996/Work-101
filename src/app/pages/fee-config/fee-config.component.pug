app-layout
  app-breadcrumbs([items]="breadcrumbItems")
  
  .floating-calculator(
    cdkDrag="",
    pToolTip="Calculator",
    toolTipPosition="left",
    (click)="openCalculator()"
  )
    i.pi.pi-calculator
  
  .flex.flex-row.gap-2
    h1.text-xl.mt-2.ml-4.col-span-3 {{ "systemConfiguration.feeConfiguration.title" | translate }}
    p-select(
      (onChange)="onLocationChange($event.value.code)",
      [options]="docOrigins",
      [(ngModel)]="selectedLocation", 
      optionLabel="documentOriginName", 
      placeholder="Select Location/Office",
      class="w-full md:w-56"
    )
  
  .grid.grid-cols-6.mt-2
    .col-span-6.grid.grid-cols-12.filter
      .col-span-4
        p-floatlabel(variant="on")
          p-iconfield
            p-inputicon.pi.pi-search
            input.w-full(
              id="on_label",
              pInputText="",
              [(ngModel)]="searchBar",
              autocomplete="off"
            )
          label(for="on_label") {{ "systemConfiguration.feeConfiguration.search_label" | translate }}
      
      .col-span-8.flex.justify-end.gap-2.filter-icons
        app-configurable-filter(
          [filters]="filterConfigs",
          [showClearAll]="true",
          [showApplyButton]="true",
          [showFilterSelector]="true",
          [filterSelectorPlaceholder]="'Select filters to display'",
          (filterChange)="onFilterChange($event)",
          (filterCleared)="onFilterCleared()",
          (filterApplied)="onFilterApplied($event)",
          (appliedFiltersChange)="onAppliedFiltersChange($event)"
        )
        p-button(
          icon="pi pi-file-pdf",
          [outlined]="true",
          [text]="true",
          style="font-size: 1.5rem"
        )
        p-button(
          icon="pi pi-info-circle",
          [outlined]="true",
          [text]="true",
          style="font-size: 1.5rem"
        )
  
  .mb-8.mt-1.w-full
    app-filter-chips(
      [appliedFilters]="appliedFilters",
      [showClearAll]="true",
      [clearAllLabel]="ms.translate('Clear All')",
      [getDisplayValue]="getFilterDisplayValue.bind(this)",
      (chipRemove)="removeFilterChip($event)",
      (clearAll)="clearAllFilters()"
    )
    
    .col-span-6
      p-tabs(value="trademarks")
        p-tablist
          | @for (category of categories; track category.ipRightCategory) {
          p-tab([value]="category.ipRightCategory")
            .category-label {{ category.ipRightCategory | capitalizeWords | translate }}
            p-badge([value]="category.count")
          | }
        
        p-tabpanels
          | @for (category of categories; track category.ipRightCategory) {
          p-tabpanel.grid.grid-cols-12.gap-3([value]="category.ipRightCategory")
            | @for (service of category.data; track service.feeId + service.documentOriginCode) {
            .col-span-3.mt-3
              p-card.w-full
                ng-template(#header="")
                  h1 {{ service.feeDescription | translate }}
                
                .text-base.font-bold.mb-2 {{ service.feeCategory | translate | capitalizeWords }}
                
                ng-template(#footer="")
                  .flex.gap-4.mt-1
                    p-button.w-full(
                      size="small",
                      severity="secondary",
                      [outlined]="true",
                      styleClass="w-full"
                    ) Basic Fee {{ service.basicFeeUnitAmount }} {{ currencyCode }}
                    p-button.w-full(
                      size="small",
                      styleClass="w-full"
                    ) Variable Fee {{ service.additionalFeeUnitAmount }} {{ currencyCode }}
            | }
          | }