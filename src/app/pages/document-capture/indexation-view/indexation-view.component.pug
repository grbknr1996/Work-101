app-layout
  app-breadcrumbs([items]="breadcrumbItems")
  .flex.justify-between.items-center.p-3.bg-white.shadow-sm.rounded-md.mb-4
    .flex.gap-4.items-center.text-lg
      span.font-semibold {{ 'documentCapture.indexationView.batchIdLabel' | translate }}
        span.text-blue-600 {{ batchId }}
      span {{ 'documentCapture.indexationView.totalBatchPages' | translate }}
        span.font-bold 22
      span {{ 'documentCapture.indexationView.indexedDocuments' | translate }}
        span.font-bold.text-green-600 {{ indexedDocs }}
      span {{ 'documentCapture.indexationView.bookmarkedDocuments' | translate }}
        span.font-bold.text-red-500 {{ bookmarkedDocs }}
    .flex.gap-3.ml-auto
      p-button(
        [label]="'documentCapture.indexationView.buttons.close' | translate",
        styleClass="p-button-text p-button-sm",
        (click)="cancelIndexation()"
      )
      p-button(
        [label]="'documentCapture.indexationView.buttons.saveBatch' | translate",
        icon="pi pi-file",
        styleClass="p-button-success p-button-sm",
        (click)="SaveBatch()"
      )

  // Main Panels Grid
  .grid(class="grid-cols-12 gap-3 h-[calc(100vh-220px)]")

    // LEFT PANEL — Doc list
    .col-span-3.bg-white.rounded-md.shadow-sm.flex.flex-col

      // Aligned top bar for left panel (empty for clean look)
      .h-12.border-b.bg-gray-50.flex.items-center.px-2
        .flex.gap-3
            p-button(
              [label]="'documentCapture.indexationView.buttons.merge' | translate",
              icon="pi pi-link", 
              severity="primary", 
              styleClass="p-button-sm", 
              [disabled]="selectedDocCount < 2",
              (click)="mergeSelectedDocuments()"
            )
            p-button(
              [label]="'documentCapture.indexationView.buttons.split' | translate",
              icon="pi pi-share-alt",
              severity="success",
              styleClass="p-button-sm",
              [disabled]="selectedDocCount !== 1",
              (click)="openSplitDialog()"
            )
            p-button(
              [label]="'documentCapture.indexationView.buttons.delete' | translate",
              icon="pi pi-trash", 
              severity="danger", 
              styleClass="p-button-sm",
              (click)="confirmDeleteDocument()", 
              [disabled]="selectedDocCount === 0"
            )

      .flex.items-center.justify-between.bg-yellow-50.border.border-yellow-200.px-3.py-2.rounded.mb-2(*ngIf="completedDocuments.size > 0")
          span.text-sm.text-yellow-700 {{ hiddenDocumentsCount }} documents hidden
          p-button(
            [icon]="showAllDocuments ? 'pi pi-eye-slash' : 'pi pi-eye'",
            [label]="showAllDocuments ? 'Show pending' : 'Show all'",
            severity="secondary",
            styleClass="p-button-text p-button-sm",
            (click)="toggleShowAllDocuments()",
            tooltipPosition="bottom"
          )

      .flex-1.overflow-auto.p-2
        div(
          *ngFor="let doc of visibleDocuments; let i = index"
          class="border rounded-md p-1 mb-2 cursor-pointer hover:bg-gray-100",
          [ngClass]="{'bg-blue-50 border-blue-500': selectedDoc===i}",
          (click)="selectDoc(i)"
        )
          .flex.justify-between.items-center
            .flex.items-center.gap-2
              span.text-xl.font-semibold {{ doc.documentNumber }}
              p-checkbox(
                  class="mr-2",
                  [ngModel]="selectedDocs.includes(i)",
                  (onChange)="toggleDocSelection(i)",
                  [binary]="true",
                  (click)="$event.stopPropagation()"
              )
              div.mt-2.text-sm.font-medium.text-gray-700.h-10.mb-4
                p-autoComplete(
                    [(ngModel)]="doc.name",
                    [suggestions]="filteredDocIds",
                    (completeMethod)="searchDocIds($event)",
                    [forceSelection]="false",
                    [dropdown]="false",
                    placeholder="file / document id ",
                    class="w-full text-xs",
                    (blur)="disableEditing(doc)",
                    (keydown.enter)="disableEditing(doc)",
                    [disabled]="completedDocuments.has(documents.indexOf(doc))",
                    (onSelect)="onDocNameSelected(i, $event)"
                ) 
            span.text-xs.text-gray-600 {{ doc.pages }}P
          
          div.text-blue-600.cursor-pointer.logo-hover.text-sm.font-medium.ml-9
            a(*ngIf="croppedImages.get(doc.name)", (click)="viewCroppedImage(doc, i)") 
              | {{ 'documentCapture.indexationView.documentLogoLabel' | translate }}
              p-button.ml-2(
                icon="pi pi-trash",
                styleClass="p-button-text p-button-sm text-gray-500 hover:text-gray-700",
                (click)="deleteCroppedImage(doc, i); $event.stopPropagation()",
                [pTooltip]="'documentCapture.indexationView.deleteLogo' | translate", tooltipPosition="right"
              )
            p-button.ml-2(
                *ngIf="doc.name && isTrademark(doc.name) && !croppedImages.get(doc.name)",
                [label]="'documentCapture.indexationView.attachLogo' | translate",
                icon="pi pi-upload",
                severity="secondary",
                styleClass="p-button-sm mt-1",
                (click)="attachLogo(doc)"
            )


    // MID PANEL — Thumbnails
    .bg-white.rounded-md.shadow-sm.flex.flex-col(
        [ngClass]="currentPage ? 'col-span-6' : 'col-span-9'"
    )

      // Top bar aligned with left & right
      .h-12.border-b.bg-gray-50.flex.justify-between.items-center.px-2
        span.font-medium.text-sm {{ 'documentCapture.indexationView.documentPages' | translate:{ name: selectedDocName } }}
        .flex.items-center.gap-4.ml-auto(*ngIf="!showSplitDialog")
            p-button(
              icon="pi pi-crop",
              [label]="'documentCapture.indexationView.buttons.crop' | translate",
              styleClass="p-button-sm p-button-warning",
              (click)="cropSelectedThumb()",
              [disabled]="selectedThumbCount !== 1"
            )
            p-button(
              icon="pi pi-trash",
              [label]="'documentCapture.indexationView.buttons.deletePage' | translate",
              styleClass="p-button-sm p-button-danger",
              (click)="deleteSelectedThumb($event)",
              [disabled]="selectedThumbCount === 0"
            )

        .flex.items-center.gap-4.ml-auto(*ngIf="showSplitDialog")
          .flex.items-center.gap-3
            i.pi.pi-cut.text-green-600.text-xl
            span.font-medium.text-green-700
              |   
            span.text-gray-700.font-semibold {{ 'documentCapture.indexationView.splitModeDividers' | translate:{ count: splitPoints.length } }}
            p-button(
              [label]="'documentCapture.indexationView.buttons.cancel' | translate",
              icon="pi pi-times",
              styleClass="p-button-text p-button-sm",
              (click)="cancelSplitMode()"
            )
            p-button(
              [label]="'documentCapture.indexationView.buttons.applySplit' | translate",
              icon="pi pi-check",
              styleClass="p-button-success p-button-sm",
              (click)="applySplit()"
            )

      .flex-1.overflow-auto.p-2
        .p-3.bg-green-50.text-green-700.text-sm.rounded-md.mb-3.flex.items-center.gap-2(*ngIf="showSplitDialog")
          i.pi.pi-info-circle.text-green-600
          span
            strong {{ 'documentCapture.indexationView.splitModeActiveTitle' | translate }}:
            |  {{ 'documentCapture.indexationView.splitModeDescription' | translate }}


        .grid.grid-cols-4.items-center(
            [ngClass]="showSplitDialog ? 'gap-16' : 'gap-4'"
          )
          ng-container(*ngFor="let page of pageList; let p = index")
           div.split-div
            div.relative.thumbnail-a4(
              (click)="selectThumb(p)",
              [ngClass]="{'border-blue-500 bg-blue-50': currentPage-1===p}"
            )
              p-checkbox(
                  *ngIf="page.type !== 'bookmark' && !showSplitDialog",
                  class="absolute top-1 left-1 z-10",
                  [(ngModel)]="selectedThumbs[p]",
                  [binary]="true",
                  (onChange)="onThumbChange()",
                  (click)="$event.stopPropagation()"
              )
              ng-container(*ngIf="page.type === 'page'; else bookmarkBlock")
                img(
                    [src]="getThumbnailUrl(p)",
                    alt="Page Thumbnail",
                    class="w-full h-40 object-contain bg-gray-50 border rounded-md cursor-pointer",
                    [pTooltip]="'documentCapture.indexationView.fullPageView' | translate"
                  )
                span.absolute.top-1.right-1.thumbnail-badge
                  | {{ getPageNumber(p) }}
                  
              ng-template(#bookmarkBlock)
                .relative.thumbnail-a4.bg-purple-50.rounded-2xl.flex.items-center.justify-center.text-purple-600.text-sm.font-semibold.overflow-hidden
                  // inner dashed layer
                  .absolute.inset-0.border-2.border-dashed.border-purple-400.rounded-2xl.pointer-events-none

                  // content
                  .flex.flex-col.items-center.justify-center.text-center.z-10
                    i.pi.pi-qrcode.text-3xl.mb-2
                    span {{ 'documentCapture.indexationView.bookmarkSheet' | translate }}
                    span.text-xs.text-purple-500 {{ page.bookmarkText }}

                  // label top-right
                  span.absolute.top-1.right-1.bg-purple-600.text-white.text-xs.font-semibold.rounded-md.px-2.py-1.z-10
                    | {{ 'documentCapture.indexationView.beforePageLabel' | translate:{ page: getNextPageNumber(p) } }}

                  // delete button bottom-right
                  button.absolute.bottom-1.right-1.bg-red-500.text-white.rounded-full.p-1.shadow-sm.z-10(
                    (click)="removeBookmark(p)"
                  )
                    i.pi.pi-trash.text-xs

              p-button.absolute.bottom-1.right-1(
                *ngIf="page.type !== 'bookmark'",
                icon="pi pi-plus",
                styleClass="p-button-rounded p-button-text p-button-sm shadow-sm bg-white text-gray-700",
                (click)="toggleBookmarkMenu($event, p)"
              )
            div.split-divider(
                *ngIf="showSplitDialog && p < pageList.length - 1",
                (click)="onSplitClick($event, p)",
                [ngClass]="{'active': splitPoints.includes(p)}"
              )
                i.pi.pi-scissors.mr-1
                |  {{ 'documentCapture.indexationView.split' | translate }}

    // RIGHT PANEL — Viewer
    .col-span-3.bg-white.rounded-md.shadow-sm.flex.flex-col.page-viewer(*ngIf="currentPage")

      // Top bar aligned
      .h-12.border-b.bg-gray-50.flex.justify-between.items-center.px-2
        span.font-semibold.text-sm {{ 'documentCapture.indexationView.pageViewerTitle' | translate }}
        span.text-xs {{ currentPage }} / {{ totalPages }}

      .flex.gap-2.p-2
        p-button(icon="pi pi-search-minus", (click)="zoomOut()")
        p-button(icon="pi pi-refresh", (click)="resetZoom()")
        p-button(icon="pi pi-search-plus", (click)="zoomIn()")
        p-button.ml-auto(icon="pi pi-times",(click)="closeViewer()", [pTooltip]="'documentCapture.indexationView.closeViewer' | translate", tooltipPosition="bottom")

      .flex-1.border.rounded-md.flex.bg-gray-50.m-2.relative
        .image-wrapper
          img(
            [src]="activePageUrl",
            class="zoom-img",
            [style.width.%]="zoomLevel * 100",
            [style.height.%]="zoomLevel * 100",
            (wheel)="onWheelZoom($event)"
          )

      //- .p-2.flex.gap-2.justify-center
      //-   p-button(icon="pi pi-chevron-left")
      //-   p-button(icon="pi pi-download")
      //-   p-button(icon="pi pi-print")
      //-   p-button(icon="pi pi-chevron-right")

p-popover(#bookmarkPopover, [dismissable]="true")
  .flex.flex-col.gap-1.p-2
    p-button(
      [label]="'documentCapture.indexationView.buttons.insertBookmarkAfter' | translate",
      icon="pi pi-qrcode",
      styleClass="p-button-text p-button-sm",
      (click)="insertBookmark('after')"
    )
    p-button(
      [label]="'documentCapture.indexationView.buttons.insertBookmarkBefore' | translate",
      icon="pi pi-qrcode",
      styleClass="p-button-text p-button-sm",
      (click)="insertBookmark('before')"
    )

p-dialog(
  [header]="'documentCapture.indexationView.confirmDeleteTitle' | translate",
  [(visible)]="showDeleteDialog",
  [modal]="true",
  [closable]="false",
  [dismissableMask]="true",
  styleClass="confirm-delete-dialog"
)
  p.text-sm.text-gray-600.mb-4
    | {{ deleteType === 'page' ? ('documentCapture.indexationView.confirmDeleteMessagePages' | translate:{ count: selectedThumbCount }) : ('documentCapture.indexationView.confirmDeleteMessageDocuments' | translate:{ count: selectedDocCount }) }}

  .flex.justify-end.gap-2
    p-button(
      [label]="'documentCapture.indexationView.buttons.cancel' | translate",
      styleClass="p-button-text p-button-sm",
      (click)="showDeleteDialog = false"
    )
    p-button(
      [label]="'documentCapture.indexationView.buttons.delete' | translate",
      icon="pi pi-trash",
      styleClass="p-button-danger p-button-sm",
      (click)="proceedDelete()"
    )


// Merge Dialog
p-dialog(
  [header]="'documentCapture.indexationView.mergeDialog.header' | translate",
  [(visible)]="showMergeDialog",
  [modal]="true",
  [closable]="true",
  (onHide)="cancelMerge()",
  [baseZIndex]="10000",
  [style]="{ width: '30rem', height: '25rem' }"
)
  .mb-4
    p.text-sm.text-gray-600.mb-3
      | {{ 'documentCapture.indexationView.mergeDialog.message' | translate }}

    p.text-sm.font-medium.mb-2
      | {{ 'documentCapture.indexationView.mergeDialog.selectDocumentId' | translate }}

    p-dropdown(
      [(ngModel)]="selectedMergeId",
      [options]="mergeDocIds",
      [showClear]="false",
      [styleClass]="'w-full'",
      placeholder="{{ 'documentCapture.indexationView.mergeDialog.selectPlaceholder' | translate }}"
    )

  ng-template(pTemplate="footer")
    .flex.justify-end.gap-2
      p-button(
        [label]="'documentCapture.indexationView.mergeDialog.cancel' | translate",
        styleClass="p-button-text p-button-sm",
        (click)="cancelMerge()"
      )
      p-button(
        [label]="'documentCapture.indexationView.mergeDialog.confirm' | translate",
        icon="pi pi-check",
        styleClass="p-button-success p-button-sm",
        (click)="confirmMerge()",
        [disabled]="!selectedMergeId"
      )

app-bookmark-dialog(#bookmarkDialog, (generate)="insertBookmark($event)")
app-crop-dialog(#cropDialog [imageUrl]="selectedImageUrl" [pageNumber]="currentPage", (imageSaved)="onImageSaved($event)", (numberExtracted)="onNumberExtracted($event)")