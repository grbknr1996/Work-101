//- CONTAINER
div(class="tw-panel w-full p-3 sm:p-4 mb-4 bg-[#e5f3f7] flex flex-wrap justify-between items-center gap-3")
    //- TITLE
    h2(class="tw-title w-full sm:w-auto text-center sm:text-left text-sm md:text-lg lg:text-xl font-semibold") {{ currentTheme }}
    //- FILTER + REFRESH
    div(class="tw-buttons flex flex-wrap flex-col sm:flex-row gap-3 w-full sm:w-auto justify-center sm:justify-end")
        button.p-button-text.tw-btn.relative(
            pButton,
            icon="pi pi-sliders-h",
            style="color: var(--p-button-outlined-secondary-color)",
            (click)="filter()"
        )
            span(*ngIf="filterBadge", class="absolute top-1 right-1 bg-red-500 rounded-full w-2 h-2")
        button.p-button-text.tw-btn(
            pButton,
            icon="pi pi-refresh",
            style="color: var(--p-button-outlined-secondary-color)",
            (click)="reset()"
        )