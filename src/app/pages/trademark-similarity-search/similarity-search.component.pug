app-layout
  app-breadcrumbs([items]="breadcrumbItems")

  .grid.grid-cols-12
    .col-span-3
      .flex.justify-between
        h1.pt-4.text-xl.ml-4 Trademark Similarity Search

      .mb-4
        .user-stats-container
          .user-stat-card.fixed-width.border.border-blue-200.bg-blue-50.rounded-lg.shadow-sm(
            *ngFor="let stat of userStats"
          )
            // Logo + Mark Name (same row)
            .flex.items-center.gap-4.mb-3
              .w-28.h-28.bg-white.rounded-md.flex.items-center.justify-center.shrink-0
                img(
                  *ngIf="stat.logoUrl",
                  [src]="stat.logoUrl",
                  alt="Logo",
                  class="max-w-full max-h-full object-contain"
                )
                i.pi.pi-image.text-gray-400.text-2xl(*ngIf="!stat.logoUrl")

              .text-base.font-semibold.text-gray-900.justify-end
                | {{ stat.markName }}

            // Application Number
            .flex.justify-between.text-sm.text-gray-700.mb-1
              span.font-medium Application No:
              span {{ stat.applicationNumber }}

            // Filing Date
            .flex.justify-between.text-sm.text-gray-700
              span.font-medium Filing Date:
              span {{ stat.filingDate }}

  // Main Layout Grid (Full Width Only)
  .grid(class="grid-cols-12 gap-3 h-[calc(100vh-220px)]")

    // ============================
    // RIGHT PANEL (Full Width)
    // ============================
    .col-span-12.bg-white.rounded-md.shadow-sm.p-4.flex.flex-col
      .grid.grid-cols-6.mt-2
        .col-span-6.grid.grid-cols-12.filter
          .col-span-3
            p-floatlabel(variant="on")
              p-iconfield
                p-inputicon.pi.pi-search
                // Right clickable icon (only for description)
                p-inputicon.pi.pi-arrow-right.search-action-icon(
                  *ngIf="searchMode === 'description'",
                  (click)="onDescriptionSearch()",
                )
                // Logo upload icon (NEW)
                p-inputicon.pi.pi-upload.search-action-icon(
                  *ngIf="searchMode === 'logo'",
                  (click)="triggerLogoUpload()",
                  pTooltip="Search by Logo",
                  tooltipPosition="bottom"
                )

                input.w-full#on_label(
                  pInputText,
                  [(ngModel)]="searchBar",
                  autocomplete="off",
                  (ngModelChange)="onSearchChange($event)",
                  [readonly]="searchMode === 'logo'"
                )
              label(for="on_label")
                | {{ getSearchLabel() }}

          .col-span-6.flex.items-center.justify-start.gap-5.filter-icons
            .relative.inline-block
              p-dropdown(
                [options]="searchOptions",
                [(ngModel)]="searchMode",
                (onChange)="onSearchModeChange($event.value)",
                placeholder="Search Type",
                class="w-full md:w-48",
              )
              p-multiselect(
                *ngIf="searchMode === 'name'",
                [filter]="false",
                [showToggleAll]="false",
                [options]="matchTypeOptions", 
                [(ngModel)]="selectedMatchTypes",
                optionLabel="label",
                optionValue="value",
                display="chip" ,
                (onChange)="onMatchTypeChange($event)",
                placeholder="Match Type",
                class="w-full md:w-40",
                pTooltip="MarkName Match Types",
                tooltipPosition="bottom"
              )
          .col-span-3.flex.justify-end.gap-5.filter-icons
            .relative.inline-block
              p-button(
                [label]="isShowingCited ? 'All' : ('Cited (' + citedCount + ')')",
                [icon]="isShowingCited ? 'pi pi-eye' : 'pi pi-file'",
                [rounded]="true",
                [text]="true",
                (click)="getSitedTrademarks()",
                styleClass="cited-toggle-btn"
              )
              // List View Button
              p-button(
                icon="pi pi-list",
                [rounded]="true",
                [outlined]="true",
                severity="secondary",
                (click)="switchToListView()"
              )

              // Table/Grid Switch Button
              p-button(
                [icon]="switchTabTable ? 'pi pi-table' : 'pi pi-th-large'",
                [rounded]="true",
                [text]="true",
                (click)="tabTableSwitch()"
              )

            app-configurable-filter(
              [filters]="filterConfigs",
              [showClearAll]="true",
              [showApplyButton]="true",
              [showFilterSelector]="true",
              [filterSelectorPlaceholder]="'Select filters to display'",
              (filterChange)="onFilterChange($event)",
              (filterCleared)="onFilterCleared()",
              (filterApplied)="onFilterApplied($event)",
              (appliedFiltersChange)="onAppliedFiltersChange($event)"
            )

      .mb-8.mt-1.w-full
        app-filter-chips(
          [appliedFilters]="appliedFilters",
          [showClearAll]="true",
          [clearAllLabel]="'Clear All'",
          (chipRemove)="removeFilterChip($event)",
          (clearAll)="clearAllFilters()"
        )

      // ============================
      // Results List
      // ============================
      .flex.flex-col.gap-4.mt-2
        div(*ngIf="switchListView", class="flex flex-col gap-4 mt-2") 
          p-paginator( 
            [rows]="listPageSize", 
            [first]="currentListPage * listPageSize", 
            [totalRecords]="totalRecords", 
            [rowsPerPageOptions]="[10, 25, 50, 100]", 
            (onPageChange)="onListPageChange($event)" 
            )
          div(
            *ngFor="let data of pagedListData",
            class="border rounded-lg p-4 shadow-sm bg-white hover-highlight cursor-pointer",
            (click)="openDrawer(data)"
            )
            .flex.gap-4.items-start
              // Description icon (logo search only)
              i.pi.pi-info-circle.text-blue-600.cursor-pointer.mt-4(
                *ngIf="isLogoSearch",
                (click)="$event.stopPropagation(); openDescription(data)"
                pTooltip="View similarity description"
                tooltipPosition="top"
              )
              // Logo
              .w-20.h-20.bg-gray-100.rounded-md.flex.items-center.justify-center.shrink-0.mr-12
                img(
                  [src]="data.logoUrl",
                  alt="Logo",
                  class="max-w-full max-h-full object-contain"
                )

              // Content
              .flex-1
                .grid.grid-cols-12.gap-4

                  // File ID
                  .col-span-3
                    .text-xs.text-gray-500 File ID
                    .text-sm.font-medium.text-gray-900 {{ data.regNumber }}

                  // Mark Name
                  .col-span-3
                    .text-xs.text-gray-500 Owner
                    .text-sm.text-gray-800 {{ data.applicantName }}
                  // Filing Date
                  .col-span-3
                    .text-xs.text-gray-500 Filing Date
                    .text-sm.text-gray-800 {{ data.filingDate }}

                  // Status
                  .col-span-3
                    .text-xs.text-gray-500 Status
                    p-tag(
                      [value]="data.status",
                      [severity]="getTagColorValue(data.status)?.severity"
                    )

                  // Name
                  .col-span-3
                    .text-xs.text-gray-500 Mark Name
                    .text-sm.font-semibold.text-gray-900 {{ data.markName }}

                  // Nice Classes
                  .col-span-3
                    .text-xs.text-gray-500 Nice Classes
                    .text-sm.text-gray-800 {{ data.classes }}
          p-paginator( 
            [rows]="listPageSize", 
            [totalRecords]="totalRecords", 
            [first]="currentListPage * listPageSize", 
            [rowsPerPageOptions]="[10, 25, 50, 100]", 
            (onPageChange)="onListPageChange($event)", 
            )

        // TABLE VIEW
        .grid.grid-cols-6.mt-2
          .col-span-6
            app-table(
              *ngIf="!switchTabTable && !switchListView",
              [columns]="tableColumns",
              [data]="pagedTableData",
              [showSearchButton]="false",
              [showClearButton]="false",
              [paginator]="true",
              [lazy]="true",
              [rows]="pageSize",
              [totalRecords]="totalRecords",
              [rowsPerPageOptions]="[10, 25, 50, 100]",
              [showCurrentPageReport]="true",
              [currentPageReportTemplate]="'Showing {first} to {last} of {totalRecords} publications'",
              (actionClick)="onActionClick($event.action, $event.item)",
              (onLazyLoad)="onLazyLoad($event)"
            )

        // GRID CARD VIEW
        .grid.grid-cols-12.gap-4(*ngIf="switchTabTable && !switchListView")
          p-paginator(
            [rows]="cardPageSize",
            [totalRecords]="totalRecords",
            [first]="currentCardPage * cardPageSize",
            [rowsPerPageOptions]="[20, 50, 100, 200]",
            (onPageChange)="onCardPageChange($event)"
            class="col-span-12"
          )
          ng-container(*ngFor="let data of pagedCardData", (click)="openDrawer(data)")
            .col-span-4
              p-card
                .flex.justify-start.gap-2
                  p-avatar(
                    [image]="data.logoUrl",
                    styleClass="big-avatar"
                  )
                  .w-full
                    .flex.justify-between
                      .text-lg.font-bold {{ data.regNumber }}
                      .text-lg
                        p-tag(
                          [value]="getTagColorValue(data.status)?.value",
                          [severity]="data.status ? getTagColorValue(data.status)?.severity : 'secondary'"
                        )
                    .mt-2.mb-1.font-semibold.text-base {{ data.markName }}
                    p-tag([value]="data.applicantName")
                hr.mt-2.mb-2
                .grid.grid-cols-12.gap-2
                  .col-span-6
                    .font-light Classes
                    .font-semibold.text-base {{ data.classes }}
                  .col-span-6
                    .font-light Applied:
                    .font-semibold.text-base {{ data.filingDate }}
                  .col-span-6
                    .font-light type
                    .font-semibold.text-base International

                hr.mt-1.mb-2
                ng-template(#footer="")
                    .flex.gap-4.mt-1
                        p-button(
                            label="Details",
                            icon="pi pi-download",
                            severity="secondary", 
                            class="w-full", 
                            [outlined]="true", 
                            styleClass="w-full",
                            (click)="showTrademarkDetails(data)"
                        )
          p-paginator(
            [rows]="cardPageSize",
            [totalRecords]="totalRecords",
            [first]="currentCardPage * cardPageSize",
            [rowsPerPageOptions]="[20, 50, 100, 200]",
            (onPageChange)="onCardPageChange($event)"
            class="col-span-12"
          )

p-drawer(
  [(visible)]="drawerVisible",
  [position]="'right'",
  styleClass="trademark-drawer !w-full md:!w-96 lg:!w-[50rem]",
  [closable]="false"
)
  // Drawer Header
  .flex.items-center.justify-between.border-b
    .flex.items-center.gap-3
      button.p-button.p-button-text.p-0(
        (click)="drawerVisible = false"
      )
        i.pi.pi-chevron-left.text-xl
        i.pi.pi-chevron-right.text-xl
    .text-center.flex-1
      h2.text-xl.font-semibold Trademark Details
      p.text-sm.text-blue-600.mt-1 Registration: {{ selectedRecord?.regNumber }}
    button.p-button.p-button-text.p-0(
      (click)="drawerVisible = false"
    )
      i.pi.pi-times.text-xl

  // Drawer Content
  .p-4( class="overflow-y-auto max-h-[calc(100vh-150px)]" )

    // Thumbnail
    .flex.justify-center
      img(
        [src]="selectedRecord?.logoUrl",
        class="w-32 h-32 object-cover rounded-md shadow"
      )

    // Mark Name + Status
    .mt-4.text-center
      h2.text-2xl.font-bold {{ selectedRecord?.markName }}

      p-tag.mt-2(
        [value]="selectedRecord?.status",
        [severity]="getTagColorValue(selectedRecord?.status)?.severity"
      )

    hr.my-4

    // ============= Application & Registration Details ============
    h3.text-lg.font-semibold.mb-2 Application & Registration Details

    .flex.items-start.gap-3.mb-3
      i.pi.pi-calendar.text-xl.text-gray-600
      .flex.flex-col
        span.font-medium Application Date
        span.text-gray-700 {{ selectedRecord?.applicationDate }}

    .flex.items-start.gap-3.mb-3
      i.pi.pi-book.text-xl.text-gray-600
      .flex.flex-col
        span.font-medium Registration Date
        span.text-gray-700 {{ selectedRecord?.registrationDate }}

    .flex.items-start.gap-3.mb-3
      i.pi.pi-refresh.text-xl.text-gray-600
      .flex.flex-col
        span.font-medium Renewal Date
        span.text-gray-700 {{ selectedRecord?.renewalDate }}

    hr.my-4

    // ==================== Owner Info ====================
    h3.text-lg.font-semibold.mb-2 Owner Information

    .flex.items-start.gap-3.mb-3
      i.pi.pi-building.text-xl.text-gray-600
      .flex.flex-col
        span.font-medium Owner
        span.text-gray-700 {{ selectedRecord?.applicantName }}

    hr.my-4

    // ==================== Goods & Services ====================
    h3.text-lg.font-semibold.mb-2 Goods & Services
    p.text-gray-700.leading-relaxed 
      | {{ selectedRecord?.goodsAndServices }}

  // Bottom Sticky CTA Button
  .drawer-footer.fixed.bottom-0.left-0.right-0.bg-white.p-4.border-t.text-center
    p-button(
      [label]="isCited(selectedRecord) ? 'Remove from cited' : 'Select as cited mark'",
      icon="pi pi-exclamation-triangle",
      severity="contrast",
      class="w-full py-3 text-lg",
      (click)="selectAsCitedMark(selectedRecord)"
    )

  input(
    type="file",
    #logoInput,
    hidden,
    accept="image/*",
    (change)="onImageSelect($event)",
    [disabled]="isLoadingImageSearch"
  )

p-dialog(
  header="Logo Similarity Analysis",
  [(visible)]="showDescriptionDialog",
  [modal]="true",
  [closable]="true",
  [draggable]="false",
  [resizable]="false",
  [style]="{ width: '40vw' }",
  [breakpoints]="{ '1200px': '70vw', '960px': '90vw' }",
)

  // Subtitle
  p.text-sm.text-gray-600.mb-6
    | Detailed comparison between your uploaded logo and the selected trademark

  // Logos section
  .grid.grid-cols-2.gap-6.mb-6
    ng-container(*ngIf="searchMode === 'logo'; else descriptionBox")
      // Uploaded Logo
      .text-center
        .font-semibold.mb-2 Your Uploaded Logo
        .border.rounded-lg.p-4.flex.justify-center.items-center.h-48.bg-gray-50
          img(
            [src]="uploadedLogoUrl",
            alt="Uploaded Logo",
            class="max-h-full max-w-full object-contain"
          )
      // Description search → SAME SIZE box
    ng-template(#descriptionBox)
      .text-center
        .font-semibold.mb-2 Your Description
        .border.rounded-lg.p-4.h-48.bg-gray-50.flex.items-center.justify-center
          textarea.w-full.h-full.p-2.border-0.bg-transparent.text-sm.text-gray-700.resize-none(
            [value]="searchedDescription"
            readonly
          )


    // Matched Trademark
    .text-center
      .font-semibold.mb-2 Matched Trademark
      .border.rounded-lg.p-4.flex.justify-center.items-center.h-48.bg-gray-50
        img(
          [src]="matchedLogoUrl",
          alt="Matched Logo",
          class="max-h-full max-w-full object-contain"
        )
      .mt-2.font-semibold {{ matchedTrademarkName }}
      .text-sm.text-gray-500 {{ matchedTrademarkNumber }}

  // Similarity Score Card
  .bg-blue-50.border.border-blue-200.rounded-lg.p-4.mb-6
    .flex.justify-between.items-center.mb-2
      .font-semibold Overall Similarity Score
      .text-2xl.font-bold.text-red-600 {{ similarityScore }}%

    // Progress bar
    p-progressBar(
      [value]="similarityScore",
      [showValue]="false",
      styleClass="h-3"
    )

    p.text-sm.text-gray-600.mt-3
      | {{ similaritySummary }}

