app-layout
  app-breadcrumbs([items]="breadcrumbItems")
  .p-4
    // Header Section
    .mb-6
      h1.text-3xl.font-bold.text-gray-800 {{ isEditMode ? ('userManagement.groupForm.editGroup' | translate) : ('userManagement.groupForm.createGroup' | translate) }}
      p.text-gray-600
        | {{ isEditMode ? ('userManagement.groupForm.updateGroupInfo' | translate) : ('userManagement.groupForm.createNewGroup' | translate) }}

    // Form Content
    .bg-white.rounded-lg.shadow-sm.p-6
      app-configurable-stepper(
        [steps]="steps",
        [activeStep]="activeIndex",
        (stepChange)="onStepChange($event)"
      )

      // Basic Info Step
      div(*ngIf="activeIndex === 0" class="mt-6")
        .grid.grid-cols-1.gap-6(class="md:grid-cols-2")
          div
            .field.mb-4
              label.font-semibold.mb-1.block(for="groupName") {{ 'userManagement.groupForm.groupName' | translate }}
              input#groupName(
                type="text",
                pInputText,
                [(ngModel)]="formData.groupName",
                required,
                class="w-full"
              )
            .field.mb-4
              label.font-semibold.mb-1.block(for="groupType") {{ 'userManagement.groupForm.groupType' | translate }}
              p-dropdown#groupType(
                [options]="groupTypes",
                [(ngModel)]="formData.groupType",
                class="w-full"
              )
          div
            .field.mb-4
              label.font-semibold.mb-1.block(for="description") {{ 'userManagement.groupForm.description' | translate }}
              textarea#description(
                pInputTextarea,
                [(ngModel)]="formData.description",
                class="w-full",
                rows="4",
                placeholder="Enter group description..."
              )
            .field.mb-4
              label.font-semibold.mb-1.block {{ 'userManagement.groupForm.status' | translate }}
              .flex.items-center.gap-4.mt-2
                div(
                  (click)="formData.status = 'active'; formData.isActive = true",
                  [class]='"px-4 py-2 rounded-full text-sm cursor-pointer flex items-center gap-2 transition-colors duration-200 " + (formData.status === "active" ? "bg-green-100 text-green-800 font-medium" : "bg-gray-100 text-gray-600 hover:bg-gray-200")'
                )
                  i.pi.pi-check.text-xs(*ngIf="formData.status === 'active'")
                  | {{ 'userManagement.groupForm.active' | translate }}

                div(
                  (click)="formData.status = 'inactive'; formData.isActive = false",
                  [class]='"px-4 py-2 rounded-full text-sm cursor-pointer flex items-center gap-2 transition-colors duration-200 " + (formData.status === "inactive" ? "bg-red-100 text-red-800 font-medium" : "bg-gray-100 text-gray-600 hover:bg-gray-200")'
                )
                  i.pi.pi-check.text-xs(*ngIf="formData.status === 'inactive'")
                  | {{ 'userManagement.groupForm.inactive' | translate }}

      // Members Step
      div(*ngIf="activeIndex === 1" class="mt-6")
        .mb-4
          h3.font-semibold.text-lg.text-gray-800 {{ 'userManagement.groupForm.manageGroupMembers' | translate }}
          p.text-sm.text-gray-600 {{ 'userManagement.groupForm.selectUsersDescription' | translate }}
        
        .grid.grid-cols-2.gap-4
          // Available Users
          div
            h4.font-semibold.mb-2 {{ 'userManagement.groupForm.availableUsers' | translate }}
            .mb-3
              .flex.gap-2
                input(
                  pInputText,
                  type="text",
                  [(ngModel)]="availableUsersSearchTerm",
                  (ngModelChange)="onAvailableUsersSearchChange()",
                  [placeholder]="'userManagement.groupForm.searchUsers' | translate",
                  class="flex-1"
                )
                button(
                  *ngIf="availableUsersSearchTerm",
                  pButton,
                  icon="pi pi-times",
                  class="p-button-text p-button-sm",
                  (click)="clearSearch()",
                  [pTooltip]="'userManagement.groupForm.clearSearch' | translate"
                )
            .space-y-2
              .flex.justify-between.items-center.p-2.bg-gray-50.rounded-t
                .flex.gap-4
                  button.text-sm.font-medium.flex.items-center.gap-1(
                    class="hover:text-primary",
                    (click)="sortAvailableUsers('username')"
                  )
                    | {{ 'userManagement.groupForm.username' | translate }}
                    i.pi.pi-sort-alt(
                      [ngClass]='{' +
                        '"pi-sort-amount-up": availableUsersSortField === "username" && availableUsersSortOrder === 1,' +
                        '"pi-sort-amount-down": availableUsersSortField === "username" && availableUsersSortOrder === -1' +
                      '}'
                    )
                  button.text-sm.font-medium.flex.items-center.gap-1(
                    class="hover:text-primary",
                    (click)="sortAvailableUsers('email')"
                  )
                    | {{ 'userManagement.groupForm.email' | translate }}
                    i.pi.pi-sort-alt(
                      [ngClass]='{' +
                        '"pi-sort-amount-up": availableUsersSortField === "email" && availableUsersSortOrder === 1,' +
                        '"pi-sort-amount-down": availableUsersSortField === "email" && availableUsersSortOrder === -1' +
                      '}'
                    )
              .p-2.bg-blue-50.rounded.flex.justify-between.items-center
                .flex.items-center.gap-2
                  button(
                    pButton,
                    [label]="areAllAvailableUsersSelected() ? ('userManagement.groupForm.deselectAll' | translate) : ('userManagement.groupForm.selectAll' | translate)",
                    [icon]="areAllAvailableUsersSelected() ? 'pi pi-times' : 'pi pi-check'",
                    class="p-button-text p-button-sm",
                    (click)="areAllAvailableUsersSelected() ? deselectAllAvailableUsers() : selectAllAvailableUsers()"
                  )
                  span.text-sm.text-blue-700(*ngIf="selectedUsers.length > 0") {{ selectedUsers.length }} {{ 'userManagement.groupForm.selected' | translate }}
                button(
                  pButton,
                  [label]="'userManagement.groupForm.addSelected' | translate",
                  icon="pi pi-plus",
                  class="p-button-success p-button-sm",
                  [disabled]="selectedUsers.length === 0",
                  (click)="addSelectedMembers()"
                )
            // Users list
            .space-y-2
              .p-3.bg-white.rounded-lg.shadow-sm.flex.justify-between.items-center(*ngFor="let user of filterAvailableUsers()")
                .flex.items-center.gap-3
                  p-checkbox(
                    [value]="user",
                    [(ngModel)]="selectedUsers",
                    [multiple]="true"
                  )
                  div
                    .font-medium {{ user.userName }}
                    .flex.items-center.gap-2.text-sm.text-gray-600
                      i.pi.pi-envelope.text-gray-400
                      span {{ user.email }}
                button(
                  pButton,
                  icon="pi pi-plus",
                  class="p-button-rounded p-button-success p-button-text",
                  (click)="addMember(user)",
                  [pTooltip]="'userManagement.groupForm.addMember' | translate"
                )
              
              // Empty state
              .text-center.p-3.text-gray-500(*ngIf="availableUsers.length === 0")
                | {{ 'userManagement.groupForm.noUsersFound' | translate }}
            
            // Pagination
            .mt-4(*ngIf="totalUsers > rowsPerPage")
              p-paginator(
                [rows]="rowsPerPage",
                [totalRecords]="totalUsers",
                [rowsPerPageOptions]="rowsPerPageOptions",
                (onPageChange)="onPageChange($event)",
                [showCurrentPageReport]="true",
                [currentPageReportTemplate]="'userManagement.groupForm.showingUsers' | translate"
              )

          // Current Members
          div
            h4.font-semibold.mb-2 {{ 'userManagement.groupForm.currentMembers' | translate }}
            .mb-3
              input(
                pInputText,
                type="text",
                [(ngModel)]="membersSearchTerm",
                [placeholder]="'userManagement.groupForm.searchMembers' | translate",
                class="w-full"
              )
            .space-y-2
              .flex.justify-between.items-center.p-2.bg-gray-50.rounded-t
                .flex.gap-4
                  button.text-sm.font-medium.flex.items-center.gap-1(
                    class="hover:text-primary",
                    (click)="sortMembers('username')"
                  )
                    | {{ 'userManagement.groupForm.username' | translate }}
                    i.pi.pi-sort-alt(
                      [ngClass]='{' +
                        '"pi-sort-amount-up": membersSortField === "username" && membersSortOrder === 1,' +
                        '"pi-sort-amount-down": membersSortField === "username" && membersSortOrder === -1' +
                      '}'
                    )
                  button.text-sm.font-medium.flex.items-center.gap-1(
                    class="hover:text-primary",
                    (click)="sortMembers('email')"
                  )
                    | {{ 'userManagement.groupForm.email' | translate }}
                    i.pi.pi-sort-alt(
                      [ngClass]='{' +
                        '"pi-sort-amount-up": membersSortField === "email" && membersSortOrder === 1,' +
                        '"pi-sort-amount-down": membersSortField === "email" && membersSortOrder === -1' +
                      '}'
                    )
              .p-2.bg-blue-50.rounded.flex.justify-between.items-center
                .flex.items-center.gap-2
                  button(
                    pButton,
                    [label]="areAllCurrentMembersSelected() ? ('userManagement.groupForm.deselectAll' | translate) : ('userManagement.groupForm.selectAll' | translate)",
                    [icon]="areAllCurrentMembersSelected() ? 'pi pi-times' : 'pi pi-check'",
                    class="p-button-text p-button-sm",
                    (click)="areAllCurrentMembersSelected() ? deselectAllCurrentMembers() : selectAllCurrentMembers()"
                  )
                  span.text-sm.text-blue-700(*ngIf="selectedMembers.length > 0") {{ selectedMembers.length }} {{ 'userManagement.groupForm.selected' | translate }}
                button(
                  pButton,
                  [label]="'userManagement.groupForm.removeSelected' | translate",
                  icon="pi pi-times",
                  class="p-button-danger p-button-sm",
                  [disabled]="selectedMembers.length === 0",
                  (click)="removeSelectedMembers()"
                )
              .p-3.bg-white.rounded-lg.shadow-sm.flex.justify-between.items-center(*ngFor="let member of filterMembers()")
                .flex.items-center.gap-3
                  p-checkbox(
                    [value]="member",
                    [(ngModel)]="selectedMembers",
                    [multiple]="true"
                  )
                  div
                    .font-medium {{ member.userName }}
                    .flex.items-center.gap-2.text-sm.text-gray-600
                      i.pi.pi-envelope.text-gray-400
                      span {{ member.email }}
                button(
                  pButton,
                  icon="pi pi-times",
                  class="p-button-rounded p-button-danger p-button-text",
                  (click)="removeMember(member)",
                  [pTooltip]="'userManagement.groupForm.removeMember' | translate"
                )
            
            // Pagination for Current Members
            .mt-4(*ngIf="totalMembers > membersRowsPerPage")
              p-paginator(
                [rows]="membersRowsPerPage",
                [totalRecords]="totalMembers",
                [rowsPerPageOptions]="membersRowsPerPageOptions",
                (onPageChange)="onMembersPageChange($event)",
                [showCurrentPageReport]="true",
                [currentPageReportTemplate]="'userManagement.groupForm.showingMembers' | translate"
              )

      // Review Step
      div(*ngIf="activeIndex === 2" class="mt-6")
        .bg-gray-50.p-6.rounded-lg
          h3.font-bold.text-xl.mb-6 {{ 'userManagement.groupForm.reviewGroupInfo' | translate }}
          
          // Basic Info Review
          .mb-6
            h4.font-semibold.text-lg.mb-3.text-blue-600 {{ 'userManagement.groupForm.basicInformation' | translate }}
            .grid.grid-cols-1.gap-4(class="md:grid-cols-2")
              .bg-white.p-4.rounded-lg
                .text-sm.text-gray-600 {{ 'userManagement.groupForm.groupName' | translate }}
                .font-medium {{ formData.groupName }}
              .bg-white.p-4.rounded-lg
                .text-sm.text-gray-600 {{ 'userManagement.groupForm.groupType' | translate }}
                .font-medium {{ formData.groupType }}
              .bg-white.p-4.rounded-lg
                .text-sm.text-gray-600 {{ 'userManagement.groupForm.description' | translate }}
                .font-medium {{ formData.description || ('userManagement.groupForm.noDescriptionProvided' | translate) }}
              .bg-white.p-4.rounded-lg
                .text-sm.text-gray-600 {{ 'userManagement.groupForm.status' | translate }}
                .font-medium([class]="formData.status === 'active' ? 'text-green-600' : 'text-red-600'") {{ formData.status === 'active' ? ('userManagement.groupForm.active' | translate) : ('userManagement.groupForm.inactive' | translate) }}
          
          // Members Review
          .mb-6
            h4.font-semibold.text-lg.mb-3.text-blue-600 {{ 'userManagement.groupForm.members' | translate }}
            .bg-white.p-4.rounded-lg
              .mt-3(*ngIf="groupMembers.length > 0")
                .text-sm.text-gray-600.mb-2 {{ 'userManagement.groupForm.addedMembers' | translate }}
                .space-y-1
                  .p-2.bg-gray-50.rounded(*ngFor="let member of groupMembers")
                    .flex.items-center.gap-2.mb-1
                      i.pi.pi-user.text-gray-400
                      span.font-medium {{ member.userName }}
                    .text-sm.text-gray-500.ml-6 {{ member.email }}
              .mt-3(*ngIf="groupMembers.length === 0")
                .text-sm.text-gray-500 {{ 'userManagement.groupForm.noMembersAdded' | translate }}

    // Action Buttons
    .mt-6.flex.justify-between.items-center
      div
        button(
          *ngIf="activeIndex === 0",
          pButton,
          pRipple,
          [label]="'userManagement.groupForm.cancel' | translate",
          icon="pi pi-times",
          (click)="onCancel()"
        )
        button(
          *ngIf="activeIndex > 0",
          pButton,
          pRipple,
          [label]="'userManagement.groupForm.previous' | translate",
          icon="pi pi-arrow-left",
          (click)="onPreviousStep()"
        )
      div
        button(
          *ngIf="activeIndex < 2",
          pButton,
          pRipple,
          [label]="'userManagement.groupForm.next' | translate",
          icon="pi pi-arrow-right",
          iconPos="right",
          [disabled]="!canProceedToNext()",
          (click)="onNextStep()"
        )
        button(
          *ngIf="activeIndex === 2",
          pButton,
          pRipple,
          [label]="isEditMode ? ('userManagement.groupForm.save' | translate) : ('userManagement.groupForm.createGroup' | translate)",
          icon="pi pi-save",
          class="p-button-primary",
          (click)="onSave()"
        )