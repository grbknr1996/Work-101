app-layout
  app-breadcrumbs([items]="breadcrumbItems")
  .p-4
    // Header Section
    .mb-4.flex.justify-between.items-center
      div
        h1.text-2xl.font-bold.text-gray-800 User Groups
        p.text-gray-600
          | Manage and view all user groups in the system
      button(
        class="p-button-primary",
        pButton,
        label="Create Group",
        icon="pi pi-plus",
        (click)="openCreateGroupDialog()"
      )

    // Filter Section with Button
    .mb-4.flex.justify-end.items-center
      .flex.items-center.gap-3
        app-configurable-filter(
          #configurableFilter,
          [filters]="filterConfigs",
          (filterChange)="onFilterChange($event)",
          (filterCleared)="onFilterCleared()",
          (filterApplied)="onFilterApplied($event)",
          (searchChange)="onSearchChange($event)",
          (appliedFiltersChange)="onAppliedFiltersChange($event)"
        )
        button(
          pButton,
          icon="pi pi-download",
          class="p-button-text"
          style="color:var(--p-button-outlined-secondary-color)"
        )

    // Filter Chips Section with Gradient Background
    .mb-4
      app-filter-chips(
        [appliedFilters]="appliedFilters",
        [showClearAll]="true",
        [clearAllLabel]="'Clear All'",
        [getDisplayValue]="getFilterDisplayValue.bind(this)",
        (chipRemove)="removeFilterChip($event)",
        (clearAll)="clearAllFilters()"
      )

    // Table Section
    .relative
      p-table(
        class="shadow-lg rounded-lg overflow-hidden",
        [value]="filteredGroups",
        [loading]="loading",
        [paginator]="true",
        [rows]="10",
        [showCurrentPageReport]="true",
        currentPageReportTemplate="Showing {first} to {last} of {totalRecords} groups",
        [rowsPerPageOptions]="[10, 25, 50]",
        [sortField]="sortField",
        [sortOrder]="sortOrder",
        (onSort)="onSort($event)",
        styleClass="p-datatable-sm"
      )
        ng-template(pTemplate="header")
          tr
            th.text-left(pSortableColumn="groupName")
              | Group Name
              p-sortIcon(field="groupName")
            th.text-left(pSortableColumn="groupType")
              | Type
              p-sortIcon(field="groupType")
            th.text-left(pSortableColumn="description")
              | Description
              p-sortIcon(field="description")
            th.text-left(pSortableColumn="isActive")
              | Status
              p-sortIcon(field="isActive")
            th.text-left(pSortableColumn="createdBy")
              | Created By
              p-sortIcon(field="createdBy")
            th.text-left(pSortableColumn="createdDate")
              | Created Date
              p-sortIcon(field="createdDate")
            th.text-left Actions

        ng-template(pTemplate="body", let-group)
          tr
            td {{ group.groupName }}
            td
              span(
                [class]="'px-2 py-1 rounded-full text-xs ' + (group.groupType === 'business' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800')"
              ) {{ group.groupType }}
            td {{ group.description }}
            td
              span(
                [class]="'px-2 py-1 rounded-full text-xs ' + (group.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800')"
              ) {{ group.isActive ? "Active" : "Inactive" }}
            td {{ group.createdBy }}
            td {{ group.createdDate }}
            td
              .flex.gap-2
                button(
                  class="p-button-rounded p-button-text",
                  pButton,
                  icon="pi pi-pencil",
                  (click)="openEditGroupDialog(group)",
                  pTooltip="Edit Group"
                )
                button(
                  class="p-button-rounded p-button-danger p-button-text",
                  pButton,
                  icon="pi pi-trash",
                  (click)="openDeleteGroupDialog(group)",
                  pTooltip="Delete Group"
                )

        ng-template(pTemplate="emptymessage")
          tr
            td.text-center.p-4(colspan="7")
              .text-gray-500 No groups found

      // Delete Group Confirmation Dialog
      p-dialog(
        header="Delete Group",
        [(visible)]="deleteGroupDialog",
        [style]="{ width: '450px' }",
        [modal]="true"
      )
        .p-fluid(*ngIf="selectedGroup")
          .mb-4
            p.text-lg
              | Are you sure you want to delete the group "{{ selectedGroup.groupName }}"?
            p.text-red-600.mt-2
              | This action cannot be undone. All members will be removed from this group.

        ng-template(pTemplate="footer")
          button(
            class="p-button-text",
            pButton,
            pRipple,
            label="Cancel",
            icon="pi pi-times",
            (click)="deleteGroupDialog = false"
          )
          button(
            class="p-button-danger",
            pButton,
            pRipple,
            label="Delete",
            icon="pi pi-trash",
            (click)="deleteGroup()"
          )

      // Group Form Component
      app-group-form(
        *ngIf="groupFormVisible",
        [group]="selectedGroup",
        [(visible)]="groupFormVisible",
        (save)="onGroupSave($event)",
        [key]="selectedGroup ? selectedGroup.groupIdentifier : 'new'"
      )