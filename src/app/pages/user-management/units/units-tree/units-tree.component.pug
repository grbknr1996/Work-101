.units-tree-container
  p-tree(
    [value]="treeNodes",
    selectionMode="single",
    [(selection)]="selectedNode",
    (onNodeSelect)="onNodeSelect($event)",
    (onNodeUnselect)="onNodeUnselect($event)",
    [style]="{ width: '100%', height: '80vh' }",
    [filter]="true",
    filterPlaceholder="Search units...",
    styleClass="units-tree-scrollable"
  )
    ng-template(pTemplate="header")
      button(
        (click)="toggleExpandCollapse()",
        [title]="allExpanded ? 'Collapse All' : 'Expand All'",
        style="margin-left: 0.5rem"
      )
        i.pi.pi-sitemap(
          [ngStyle]="{ color: allExpanded ? '#1976d2' : '#b0b0b0' }"
        )
      span(style="font-size: 0.8em; color: #888; margin-left: 0.5rem; vertical-align: middle") {{ allExpanded ? 'Collapse all' : 'Expand all' }}
    
    ng-template(
      let-node,
      pTemplate="default"
    )
      div(style="display: flex; align-items: center; gap: 0.5rem; width: 100%")
        // Main Content Area
        div(style="flex: 1; display: flex; flex-direction: column; gap: 0.25rem")
          // Unit Name with Icon
          div(style="display: flex; align-items: center; gap: 0.5rem")
            i.pi([ngClass]="getLevelChipInfo(node).iconClass", style="font-size: 0.8rem; color: var(--p-primary-color)")
            span(
              [style.font-weight]="selectedNode?.key === node.key ? '700' : '500'",
              style="font-size: 0.8rem; color: var(--p-primary-color)"
            ) {{ node.label }}
          
          // Sub-text with count
          div(style="display: flex; align-items: center; gap: 0.5rem")
            span(style="font-size: 0.7rem; color: #666; font-style: italic") {{ getSubUnitCountText(node) }}
        
        // Action Buttons
        div(style="display: flex; gap: 0.25rem")
          // Add Button (only show if not Section level)
          button.p-button-text.p-button-sm(
            *ngIf="getLevelChipInfo(node).iconClass !== 'pi pi-list'",
            pButton,
            icon="pi pi-plus",
            (click)="addNode(node, $event)",
            title="Add Sub-unit",
            style="min-width: 24px; height: 24px"
          )
          
          // Delete Button
          button.p-button-text.p-button-sm(
            pButton,
            icon="pi pi-trash",
            (click)="deleteNode(node, $event)",
            title="Delete Unit",
            style="min-width: 24px; height: 24px;color:red"
          )

style.
  .units-tree-scrollable {
    height: 80vh !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
  }
  
  .units-tree-scrollable .p-tree {
    height: 100% !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
  }
  
          .units-tree-scrollable .p-tree-container {
            height: 100% !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
          }

