.units-tree-container
  p-tree(
    [value]="treeNodes",
    selectionMode="single",
    [(selection)]="selectedNode",
    (onNodeSelect)="onNodeSelect($event)",
    (onNodeUnselect)="onNodeUnselect($event)",
    [filter]="true",
    [filterPlaceholder]="'userManagement.units.searchUnits' | translate",
    styleClass="units-tree-scrollable"
  )
    ng-template(pTemplate="header")
      button.units-tree-header(
        (click)="toggleExpandCollapse()",
        [title]="allExpanded ? ('userManagement.units.collapseAll' | translate) : ('userManagement.units.expandAll' | translate)"
      )
        i.pi.pi-sitemap(
          [ngClass]="allExpanded ? 'units-tree-expand-icon' : 'units-tree-collapse-icon'"
        )
      span.units-tree-header-text {{ allExpanded ? ('userManagement.units.collapseAllText' | translate) : ('userManagement.units.expandAllText' | translate) }}
    
    ng-template(
      let-node,
      pTemplate="default"
    )
      div.units-tree-node-container
        // Main Content Area
        div.units-tree-main-content
          // Unit Name with Icon
          div.units-tree-name-container
            i.pi.units-tree-icon([ngClass]="getLevelChipInfo(node).iconClass")
            span.units-tree-label(
              [ngClass]="selectedNode?.key === node.key ? 'units-tree-label-selected' : 'units-tree-label-unselected'"
            ) {{ node.label }}
          
          // Sub-text with count
          div.units-tree-subtext-container
            span.units-tree-subtext {{ getSubUnitCountText(node) }}
        
        // Action Buttons
        div.units-tree-actions
          // Add Button (only show if not Section level)
          button.p-button-text.p-button-sm.units-tree-action-btn(
            *ngIf="getLevelChipInfo(node).iconClass !== 'pi pi-list'",
            pButton,
            icon="pi pi-plus",
            (click)="addNode(node, $event)",
            [title]="'userManagement.units.addSubUnit' | translate"
          )
          
          // Delete Button (only show if node has no children)
          button.p-button-text.p-button-sm.units-tree-delete-btn(
            *ngIf="!node.children || node.children.length === 0",
            pButton,
            icon="pi pi-trash",
            (click)="deleteNode(node, $event)",
            [title]="'userManagement.units.deleteUnit' | translate"
          )



// Confirmation Dialog
p-confirmDialog