app-layout
  app-breadcrumbs(
    [items]="breadcrumbItems",
    style="margin-top: 1.5rem; margin-bottom: 1rem"
  )

  .create-unit-container(
    [formGroup]="unitForm",
    style="width: 100%; margin: 2rem 0; padding: 2rem; background: #fff; border-radius: 1rem; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);"
  )
    // Unit Header
    .unit-header(
      style="margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #e0e0e0"
    )
      div(style="display: flex; justify-content: space-between; align-items: center")
        div
          h2(style="margin: 0 0 0.5rem 0; color: #333; font-size: 1.5rem; font-weight: 600") Create New Unit
          div(style="display: flex; gap: 1rem; align-items: center")
            span(
              style="background: #e3f2fd; color: #1976d2; padding: 0.25rem 0.75rem; border-radius: 1rem; font-size: 0.875rem; font-weight: 500;"
            ) {{ getUnitCategoryLabel() }}
            span(
              style="color: #666; font-size: 0.875rem",
              *ngIf="parentUnitInfo"
            ) Parent: {{ parentUnitInfo.name }} ({{ parentUnitInfo.category }})

    // Unit Information Section
    .mb-6(
      style="display: flex; gap: 1.5rem; align-items: flex-start; flex-wrap: nowrap; margin-bottom: 2rem;"
    )
      div(style="flex: 1 1 0")
        .p-field
          label.block.mb-2.font-medium Type
          span.text-gray-600 {{ getUnitCategoryLabel() }}
      
      div(style="flex: 1 1 0")
        .p-field
          label.block.mb-2.font-medium Category
          span.text-gray-600 {{ unitForm.get('unitCategory')?.value || 'N/A' }}
      
      div(style="flex: 1 1 0")
        .p-field
          label.block.mb-2.font-medium Parent
          span.text-gray-600 {{ parentUnitInfo?.name || 'N/A' }}
      
      div(style="flex: 2 1 0")
        .p-field
          label(
            for="unitName",
            class="block mb-2 font-medium"
          ) Unit Name 
            span.text-red-500 *
          input#unitName(
            type="text",
            pInputText,
            formControlName="unitName",
            placeholder="Type the Unit name here.",
            [class.p-invalid]="unitForm.get('unitName')?.invalid && unitForm.get('unitName')?.touched",
            style="width: 100%"
          )
          small.p-error(
            *ngIf="getFieldError('unitName')",
            style="display: block; margin-top: 0.25rem"
          ) {{ getFieldError('unitName') }}

    // Role Selector
    .role-selector(
      style="display: flex; gap: 1rem; margin-bottom: 2rem; justify-content: flex-start"
    )
      p-buttonGroup
        button(
          pButton,
          *ngFor="let role of roleLabels; let i = index",
          [label]="role.label",
          [class.p-button-outlined]="selectedRoleIndex !== i",
          [class.p-button-primary]="selectedRoleIndex === i",
          (click)="selectRole(i)",
          style="min-width: 120px; font-weight: 500"
        )

    // Tabs for Users, Permissions, Actions
    p-tabView(
      [(activeIndex)]="selectedTabIndex",
      style="margin-top: 1rem"
    )
      // Users Tab
      p-tabPanel(header="Users")
        button.p-button-sm.p-button-primary(
          pButton,
          icon="pi pi-plus",
          [label]="selectedRole === 'head' && getSelectedRoleUsers().length > 0 ? 'Change Head User' : 'Add User'",
          style="margin-bottom: 1rem",
          (click)="openUserSelectionDialog()"
        )
        p-table([value]="getSelectedRoleUsers()")
          ng-template(pTemplate="header")
            tr
              th Name
              th Email
              th(style="width: 60px") Actions
          ng-template(
            pTemplate="body",
            let-user,
            let-i="rowIndex"
          )
            tr
              td {{ user.userName }}
              td {{ user.email || user.login }}
              td
                button.p-button-text.p-button-sm.p-button-danger(
                  pButton,
                  icon="pi pi-times",
                  title="Remove User",
                  (click)="removeUser(i)"
                )
          ng-template(pTemplate="emptymessage")
            tr
              td.text-center(colspan="3") No users assigned to this role

      // Permissions Tab
      p-tabPanel(header="Permissions")
        .grid
          .col-12
            label.block.mb-2.font-medium Permission Sets
            p-multiSelect.w-full(
              [options]="availablePermissions",
              [(ngModel)]="selectedPermissions",
              (onChange)="onRolePermissionChange($event.value)",
              optionLabel="label",
              [filter]="true",
              placeholder="Select Permission Sets",
              [panelStyle]="{minWidth: '600px', width: '80vw', maxWidth: '700px', maxHeight: '400px', overflowX: 'auto'}",
              [virtualScroll]="true",
              [virtualScrollItemSize]="34",
              [showToggleAll]="true",
              appendTo="body"
            )
              ng-template(
                let-permission,
                pTemplate="item"
              )
                .flex.items-center.justify-between.p-2(style="min-width: 350px")
                  span.font-semibold {{ permission.label }}
          
          .col-12.mt-4
            .bg-gray-50.p-4.rounded-lg
              h4.font-semibold.mb-4 Selected Permissions
              .flex.flex-wrap.gap-2
                span.inline-block.bg-blue-100.text-blue-800.px-2.py-1.rounded-full.text-xs(
                  *ngFor="let permission of selectedPermissions"
                ) {{ permission.label }}

      // Actions Tab
      p-tabPanel(header="Actions")
        app-process-actions(
          [selectedRole]="selectedRole",
          [selectedActions]="getSelectedRoleActions()",
          [isEditMode]="true",
          [showSummary]="true",
          (actionsChange)="onActionsChange($event)"
        )

    // User Selection Dialog
    app-user-selection-dialog(
      [(visible)]="userSelectionDialogVisible",
      [currentMembers]="getSelectedRoleUsers()",
      [role]="selectedRole",
      (membersSelected)="onUsersSelected($event)"
    )

    // Form Actions
    .flex.justify-content-center.gap-2.mt-6(style="margin-top: 2rem")
      button(
        type="button",
        pButton,
        label="Cancel",
        icon="pi pi-times",
        class="p-button-outlined",
        (click)="onCancel()",
        [disabled]="loading"
      )
      button(
        type="button",
        pButton,
        label="Save",
        icon="pi pi-check",
        class="p-button-primary",
        (click)="onSubmit()",
        [loading]="loading",
        [disabled]="unitForm.invalid || assignedUsers.head.length === 0",
        title="Save the unit"
      )