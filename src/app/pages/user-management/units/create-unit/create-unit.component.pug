app-layout
  app-breadcrumbs(
    [items]="breadcrumbItems",
    class="breadcrumbs-container"
  )

  .create-unit-container(
    [formGroup]="unitForm",
    class="create-unit-container"
  )
    // Unit Header
    .unit-header
      .header-content
        div
          h2.unit-title {{ 'userManagement.units.createUnit.title' | translate }}
          .header-info
            span.category-badge {{ getUnitCategoryLabel() }}
            span.parent-info(
              *ngIf="parentUnitInfo"
            ) Parent: {{ parentUnitInfo.name }} ({{ parentUnitInfo.category }})

    // Unit Information Section
    .unit-info-section
      .info-field
        .p-field
          label.block.mb-2.font-medium {{ 'userManagement.units.createUnit.type' | translate }}
          span.text-gray-600 {{ getUnitCategoryLabel() }}
      
      .info-field
        .p-field
          label.block.mb-2.font-medium {{ 'userManagement.units.createUnit.category' | translate }}
          span.text-gray-600 {{ unitForm.get('unitCategory')?.value || 'N/A' }}
      
      .info-field
        .p-field
          label.block.mb-2.font-medium {{ 'userManagement.units.createUnit.parent' | translate }}
          span.text-gray-600 {{ parentUnitInfo?.name || 'N/A' }}
      
      .unit-name-field
        .p-field
          label(
            for="unitName",
            class="block mb-2 font-medium"
          ) {{ 'userManagement.units.createUnit.unitName' | translate }}
            span.text-red-500 *
          input#unitName(
            type="text",
            pInputText,
            formControlName="unitName",
            [placeholder]="'userManagement.units.createUnit.unitNamePlaceholder' | translate",
            [class.p-invalid]="unitForm.get('unitName')?.invalid && unitForm.get('unitName')?.touched",
            class="unit-name-input"
          )
          app-validation-errors([control]="unitForm.get('unitName')")

    // Role Selector
    .role-selector
      // Desktop: Button Group
      p-buttonGroup.role-buttons-desktop(*ngIf="!ms.isMobileView")
        button(
          pButton,
          *ngFor="let role of roleLabels; let i = index",
          [label]="role.label",
          [class.p-button-outlined]="selectedRoleIndex !== i",
          [class.p-button-primary]="selectedRoleIndex === i",
          (click)="selectRole(i)",
          class="role-button"
        )
      
      // Mobile: Dropdown
      .role-dropdown-mobile(*ngIf="ms.isMobileView")
        p-dropdown(
          [options]="roleLabels",
          [(ngModel)]="selectedRoleLabel",
          optionLabel="label",
          (onChange)="onRoleDropdownChange($event)",
          placeholder="Select Role",
          styleClass="w-full",
          [style]="{ width: '100%' }"
        )

    // Tabs for Users, Permissions, Actions
    p-tabs([value]="selectedTabIndex", (onChange)="onTabChange($event)", class="tabs-container")
      p-tablist
        p-tab(value="0") {{ 'userManagement.units.createUnit.tabs.users' | translate }}
        p-tab(value="1") {{ 'userManagement.units.createUnit.tabs.permissions' | translate }}
        p-tab(value="2") {{ 'userManagement.units.createUnit.tabs.actions' | translate }}

      p-tabpanels
        // Users Tab
        p-tabpanel(value="0")
          button.p-button-sm.p-button-primary(
            pButton,
            icon="pi pi-plus",
            [label]="selectedRole === 'head' && getSelectedRoleUsers().length > 0 ? 'Change Head User' : 'Add User'",
            class="add-user-button",
            (click)="openUserSelectionDialog()"
          )
          p-table([value]="getSelectedRoleUsers()")
            ng-template(pTemplate="header")
              tr
                th {{ 'userManagement.units.name' | translate }}
                th {{ 'userManagement.units.email' | translate }}
                th.actions-column {{ 'userManagement.units.actions' | translate }}
            ng-template(
              pTemplate="body",
              let-user,
              let-i="rowIndex"
            )
              tr
                td {{ user.userName }}
                td {{ user.email || user.login }}
                td
                  button.p-button-text.p-button-sm.p-button-danger(
                    pButton,
                    icon="pi pi-times",
                    [title]="'userManagement.units.removeUser' | translate",
                    (click)="removeUser(i)"
                  )
            ng-template(pTemplate="emptymessage")
              tr
                td.text-center(colspan="3") {{ 'userManagement.units.createUnit.noUsersAssigned' | translate }}
        // Permissions Tab
        p-tabpanel(value="1")
          .grid
            .col-12
              label.block.mb-2.font-medium {{ 'userManagement.units.permissionSets' | translate }}
              p-multiSelect.w-full(
                [options]="availablePermissions",
                [(ngModel)]="currentRolePermissions",
                [ngModelOptions]="{standalone: true}",
                (onChange)="onRolePermissionChange($event.value)",
                optionLabel="label",
                [filter]="true",
                [placeholder]="'userManagement.units.selectPermissionSets' | translate",
                [panelStyle]="{minWidth: '600px', width: '80vw', maxWidth: '700px', maxHeight: '400px', overflowX: 'auto'}",
                [virtualScroll]="true",
                [virtualScrollItemSize]="34",
                [showToggleAll]="true",
                appendTo="body"
              )
                ng-template(
                  let-permission,
                  pTemplate="item"
                )
                  .flex.items-center.justify-between.p-2.permission-item
                    span.font-semibold {{ permission.label }}
            
            .col-12.mt-4
              .bg-gray-50.p-4.rounded-lg(*ngIf="getSelectedRolePermissions().length>0")
                h4.font-semibold.mb-4 {{ 'userManagement.units.selectedPermissions' | translate }}
                .flex.flex-wrap.gap-2
                  span.inline-block.bg-blue-100.text-blue-800.px-2.py-1.rounded-full.text-xs(
                    *ngFor="let permission of getSelectedRolePermissions()"
                  ) {{ permission.label }}
        // Actions Tab
        p-tabpanel(value="2")
          app-process-actions(
            [selectedRole]="selectedRole",
            [selectedActions]="getSelectedRoleActions()",
            [isEditMode]="true",
            [showSummary]="true",
            (actionsChange)="onActionsChange($event)"
          )


    // User Selection Dialog
    app-user-selection-dialog(
      [(visible)]="userSelectionDialogVisible",
      [currentMembers]="getSelectedRoleUsers()",
      [role]="selectedRole",
      (membersSelected)="onUsersSelected($event)"
    )

    // Form Actions
    .flex.justify-content-center.gap-2.mt-6.form-actions
      button(
        type="button",
        pButton,
        [label]="'userManagement.units.cancel' | translate",
        icon="pi pi-times",
        class="p-button-outlined",
        (click)="onCancel()",
        [disabled]="loading"
      )
      button(
        type="button",
        pButton,
        [label]="'userManagement.units.save' | translate",
        icon="pi pi-check",
        class="p-button-primary",
        (click)="onSubmit()",
        [loading]="loading",
        [disabled]="unitForm.invalid || assignedUsers.head.length === 0",
        [title]="'userManagement.units.createUnit.saveUnit' | translate"
      )