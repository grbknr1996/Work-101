app-layout
  app-breadcrumbs(
    [items]="breadcrumbItems",
    style="margin-top: 1.5rem; margin-bottom: 1rem"
  )
  
  // Mobile hamburger menu
  .mobile-menu-btn(
    *ngIf="isMobile",
    (click)="toggleMobileMenu()",
    style="display: none; margin: 1rem 0; background: var(--p-primary-color); color: white; border: none; border-radius: 8px; padding: 0.75rem 1rem; box-shadow: 0 2px 8px rgba(0,0,0,0.15); cursor: pointer;"
  )
    i.pi.pi-bars(style="font-size: 1rem; margin-right: 0.5rem")
    span Units Tree
  
  // Mobile overlay
  .mobile-overlay(
    *ngIf="isMobile && showTree",
    (click)="closeMobileMenu()",
    style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 999;"
  )
  
  div(style="display: flex; flex-direction: row; height: 100%; min-height: 80vh")
    // Desktop sidebar (always rendered, conditionally shown)
    .units-sidebar(
      *ngIf="!isMobile",
      [style.display]="showTree ? 'flex' : 'none'",
      style="flex-direction: column; min-width: 320px; max-width: 350px; position: relative; height: 100%; box-sizing: border-box;"
    )
      // Units Tree Title
      h1(style="margin: 0 0 1rem 0; padding: 1rem 1rem 0 1rem; color: var(--p-primary-color); font-size: 1.2rem; font-weight: 600") Units Tree
      
      div(style="padding: 0 1rem 1rem 1rem; border-bottom: 1px solid #e5e7eb")
        button.p-button-sm.p-button-primary(
          pButton,
          icon="pi pi-plus",
          label="New Root Unit",
          style="width: 100%",
          (click)="createNewRootUnit()"
        )
      
      div(style="flex: 1; overflow-y: auto; overflow-x: hidden; width: 100%; box-sizing: border-box")
        app-units-tree#unitsTree(
          [searchText]="searchText",
          [filter]="false",
          (nodeSelected)="onNodeSelected($event)"
        )
    
    // Mobile sidebar (mobile only)
    .units-sidebar(
      *ngIf="isMobile",
      [class.mobile-sidebar]="isMobile",
      [class.show]="isMobile && showTree",
      style="flex-direction: column; min-width: 320px; max-width: 350px; position: relative; height: 100%; box-sizing: border-box;"
    )
      // Mobile close button
      .mobile-close-btn(
        (click)="closeMobileMenu()",
        style="position: absolute; top: 1rem; right: 1rem; z-index: 1002; background: #f3f4f6; border: none; border-radius: 50%; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer;"
      )
        i.pi.pi-times(style="font-size: 1rem; color: #6b7280")
      
      // Units Tree Title
      h1(style="margin: 0 0 1rem 0; padding: 1rem 1rem 0 1rem; color: var(--p-primary-color); font-size: 1.2rem; font-weight: 600") Units Tree
      
      div(style="padding: 0 1rem 1rem 1rem; border-bottom: 1px solid #e5e7eb")
        button.p-button-sm.p-button-primary(
          pButton,
          icon="pi pi-plus",
          label="New Root Unit",
          style="width: 100%",
          (click)="createNewRootUnit()"
        )
      
      div(style="flex: 1; overflow-y: auto; overflow-x: hidden; width: 100%; box-sizing: border-box")
        app-units-tree#unitsTree(
          [searchText]="searchText",
          [filter]="false",
          (nodeSelected)="onNodeSelected($event)"
        )
    
    // Toggle button and divider (desktop only)
    div(
      *ngIf="!isMobile",
      style="position: relative; display: flex; align-items: center;  flex-shrink: 0;"
    )
      p-divider(layout="vertical")
      button.sidebar-toggle-btn(
        (click)="showTree = !showTree",
        style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); background: #fff; border: 1px solid #e5e7eb; border-radius: 50%; width: 32px; height: 32px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04); display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 2;"
      )
        i.pi.pi-arrow-right-arrow-left
    
    // Main content area - takes full width when tree is hidden
    div.main-content(
      [style.width]="showTree ? 'auto' : '100%'",
      style="flex: 1; padding: 2.5rem 2rem 2rem 2.5rem; min-width: 0; align-items: center; justify-content: center;"
    )
      ng-container(*ngIf="selectedUnit; else noSelection")
        app-unit-details(
          [unit]="selectedUnit",
          [unitCategory]="selectedUnitCategory"
        )
      
      ng-template(#noSelection)
        div(style="color: #888; font-size: 1.2rem; text-align: center") Select a node to view details

style.
  /* Mobile responsive styles */
  @media (max-width: 768px) {
    .mobile-menu-btn {
      display: block !important;
    }
    
    .units-sidebar {
      display: none !important;
    }
    
    .units-sidebar.mobile-sidebar {
      display: flex !important;
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      width: 280px !important;
      height: 100vh !important;
      z-index: 1001 !important;
      background: white !important;
      box-shadow: 2px 0 10px rgba(0,0,0,0.1) !important;
      transform: translateX(0) !important;
      transition: transform 0.3s ease !important;
    }
    
    .units-sidebar.mobile-sidebar:not(.show) {
      transform: translateX(-100%) !important;
    }
    
    .sidebar-toggle-btn {
      display: none !important;
    }
    
    p-divider {
      display: none !important;
    }
    
    .main-content {
      width: 100% !important;
      padding: 1rem !important;
    }
  }
  
  @media (min-width: 769px) {
    .mobile-menu-btn {
      display: none !important;
    }
    
    .mobile-overlay {
      display: none !important;
    }
    
    .sidebar-toggle-btn {
      display: flex !important;
    }
    
    p-divider {
      display: block !important;
    }
  }