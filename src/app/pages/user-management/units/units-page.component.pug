app-layout
  app-breadcrumbs(
    [items]="breadcrumbItems"
  )
  
  // Mobile hamburger menu
  .mobile-menu-btn(
    *ngIf="isMobile",
    (click)="toggleMobileMenu()"
  )
    i.pi.pi-bars
    span {{ 'userManagement.units.unitsTree' | translate }}
  
  // Mobile overlay
  .mobile-overlay(
    *ngIf="isMobile && showTree",
    (click)="closeMobileMenu()"
  )
  
  .units-page-container
    // Desktop sidebar (always rendered, conditionally shown)
    .units-sidebar(
      *ngIf="!isMobile",
      [style.display]="showTree ? 'flex' : 'none'"
    )
      // Units Tree Title
      h1 {{ 'userManagement.units.unitsTree' | translate }}
      
      .button-container
        button.p-button-sm.p-button-primary(
          pButton,
          icon="pi pi-plus",
          [label]="'userManagement.units.newRootUnit' | translate",
          (click)="createNewRootUnit()"
        )
      
      .tree-container
        app-units-tree(
          #unitsTree,
          [searchText]="searchText",
          [filter]="false",
          (nodeSelected)="onNodeSelected($event)"
        )
    
    // Mobile sidebar (mobile only)
    .units-sidebar(
      *ngIf="isMobile",
      [class.mobile-sidebar]="isMobile",
      [class.show]="isMobile && showTree"
    )
      // Mobile close button
      .mobile-close-btn(
        (click)="closeMobileMenu()"
      )
        i.pi.pi-times
      
      // Units Tree Title
      h1 {{ 'userManagement.units.unitsTree' | translate }}
      
      .button-container
        button.p-button-sm.p-button-primary(
          pButton,
          icon="pi pi-plus",
          [label]="'userManagement.units.newRootUnit' | translate",
          (click)="createNewRootUnit()"
        )
      
      .tree-container
        app-units-tree(
          #unitsTree,
          [searchText]="searchText",
          [filter]="false",
          (nodeSelected)="onNodeSelected($event)"
        )
    
    // Toggle button and divider (desktop only)
    .toggle-container(
      *ngIf="!isMobile"
    )
      p-divider(layout="vertical")
      button.sidebar-toggle-btn(
        (click)="showTree = !showTree"
      )
        i.pi.pi-arrow-right-arrow-left
    
    // Main content area - takes full width when tree is hidden
    .main-content(
      [style.width]="showTree ? 'auto' : '100%'"
    )
      ng-container(*ngIf="selectedUnit; else noSelection")
        app-unit-details(
          [unit]="selectedUnit",
          [unitCategory]="selectedUnitCategory",
          (unitUpdated)="onUnitUpdated()"
        )
      
      ng-template(#noSelection)
        .no-selection-message {{ 'userManagement.units.selectNodeToView' | translate }}
