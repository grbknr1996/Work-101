.unit-details-container(style="max-width: 1100px; margin: 2rem auto; padding: 2rem; background: #fff; border-radius: 1rem; box-shadow: 0 2px 8px rgba(0,0,0,0.04);")
  .role-selector(style="display: flex; gap: 1rem; margin-bottom: 1.5rem; justify-content: flex-start;")
    p-buttonGroup
      button(
        pButton,
        *ngFor="let role of roleLabels; let i = index",
        [label]="role.label",
        [class.p-button-outlined]="selectedRoleIndex !== i",
        [class.p-button-primary]="selectedRoleIndex === i",
        (click)="selectRole(i)",
        style="min-width: 120px; font-weight: 500;",
      )
  
  p-tabView([(activeIndex)]="selectedTabIndex")
    p-tabPanel(header="Users")
      button(
        pButton,
        icon="pi pi-plus",
        label="Add User",
        class="p-button-sm p-button-primary",
        style="margin-bottom: 1rem;",
        (click)="openAddUserDialog()",
      )
      
      p-table([value]="getSelectedRoleUsers()", *ngIf="unit")
        ng-template(pTemplate="header")
          tr
            th Name
            th Email
            th(style="width: 60px;") Actions
        ng-template(pTemplate="body" let-user let-i="rowIndex")
          tr
            td {{ user.name }}
            td {{ user.email }}
            td
              button(
                pButton,
                icon="pi pi-times",
                class="p-button-text p-button-sm",
                (click)="removeUser(selectedRole, i)",
              )
      
      p-dialog(
        header="Add User",
        [(visible)]="addUserDialogVisible",
        [modal]="true",
        [style]="{ width: '400px' }",
      )
        .p-fluid
          .p-field
            label(for="userName") Name
            input#userName(
              type="text",
              pInputText,
              [(ngModel)]="newUser.name",
            )
          .p-field
            label(for="userEmail") Email
            input#userEmail(
              type="email",
              pInputText,
              [(ngModel)]="newUser.email",
            )
        ng-template(pTemplate="footer")
          button(
            pButton,
            label="Cancel",
            class="p-button-text",
            (click)="addUserDialogVisible = false",
          )
          button(
            pButton,
            label="Add",
            class="p-button-primary",
            (click)="addUserConfirm()",
          )
    
    p-tabPanel(header="Permissions")
      .grid
        .col-12
          label.block.mb-2.font-medium Permission Sets
          p-multiSelect.w-full(
             [options]="availablePermissions",
             [(ngModel)]="selectedPermissions",
             optionLabel="label",
             [filter]="true",
             placeholder="Select Permission Sets",
             [panelStyle]="{ minWidth: '600px', width: '80vw', maxWidth: '700px', maxHeight: '400px', overflowX: 'auto' }",
             [virtualScroll]="true",
             [virtualScrollItemSize]="34",
             [showToggleAll]="true",
             appendTo="body",
           )
            ng-template(let-permission pTemplate="item")
              .flex.items-center.justify-between.p-2(style="min-width: 350px")
                span.font-semibold {{ permission.label }}
                span.text-gray-500.text-xs.ml-4.whitespace-nowrap
                  | {{ permission.permissions.length }} permission{{
                  | permission.permissions.length > 1 ? "s" : ""
                  | }}
        
        .col-12.mt-4
          .bg-gray-50.p-4.rounded-lg
            h4.font-semibold.mb-4 Selected Permissions
            .grid.grid-cols-1.gap-4(class="md:grid-cols-2 lg:grid-cols-3")
              .p-4.bg-white.rounded-lg.shadow-sm(*ngFor="let permission of selectedPermissions")
                .font-medium.text-lg.mb-2 {{ permission.label }}
                .text-sm.text-gray-600
                  .flex.flex-wrap.gap-2
                    span.inline-block.bg-blue-100.text-blue-800.px-2.py-1.rounded-full.text-xs(
                      *ngFor="let perm of permission.permissions",
                    ) {{ perm }}
    
    p-tabPanel(header="Actions")
      app-unit-actions-assignment(
        [processes]="processes",
        [selectedActions]="selectedActions",
        (selectedActionsChange)="onSelectedActionsChange($event)",
      )

ng-template(#noUnit) 