.unit-details-container
  // Unit Header
  .unit-header(
    *ngIf="unit"
  )
    div.unit-header-row
      div.unit-header-info
        // Unit Name Display/Edit
        div.unit-name-wrapper(*ngIf="!isEditMode")
          h2.unit-name {{ unit.name }}
        
        div.unit-name-edit-wrapper(
          *ngIf="isEditMode",
          [formGroup]="unitForm"
        )
          .unit-name-input-container
            input.unit-name-input(
              type="text",
              formControlName="unitName",
              placeholder="Enter unit name",
              [class.p-invalid]="unitForm.get('unitName')?.invalid && unitForm.get('unitName')?.touched"
            )
          small.p-error.unit-name-error(
            *ngIf="unitForm.get('unitName')?.invalid && unitForm.get('unitName')?.touched"
          ) {{ 'userManagement.units.unitNameRequired' | translate }}
        
        div.unit-meta-info
          span.unit-category-badge {{ unitCategory || 'Unit' }}
          span.unit-id-text ID: {{ unit.id }}
      
      div.header-actions
        // View Mode Buttons
        ng-container(*ngIf="!isEditMode")
          button.p-button-outlined.p-button-sm(
            pButton,
            icon="pi pi-pencil",
            (click)="editUnit()",
            [title]="'userManagement.units.editUnit' | translate",
            class="header-action-btn"
          )
          button.p-button-outlined.p-button-sm(
            *ngIf="unitCategory !== 'Section'",
            pButton,
            icon="pi pi-plus",
            [title]="'userManagement.units.addSubUnit' | translate",
            class="header-action-btn",
            (click)="createSubUnit()"
          )
        
        // Edit Mode Buttons
        ng-container(*ngIf="isEditMode")
          button.p-button-success.p-button-sm(
            pButton,
            [label]="'userManagement.units.save' | translate",
            (click)="saveUnit()",
            title="Save Changes",
            class="header-primary-btn"
          )
          button.p-button-outlined.p-button-sm(
            pButton,
            [label]="'userManagement.units.cancel' | translate",
            (click)="cancelEdit()",
            title="Cancel Edit",
            class="header-primary-btn"
          )

  .role-selector
    // Desktop: Button Group
    p-buttonGroup.role-buttons-desktop
      button(
        pButton,
        *ngFor="let role of roleLabels; let i = index",
        [label]="role.label",
        [class.p-button-outlined]="selectedRoleIndex !== i",
        [class.p-button-primary]="selectedRoleIndex === i",
        (click)="selectRole(i)"
      )
    
    // Mobile: Dropdown
    .role-dropdown-mobile
      p-dropdown(
        [options]="roleLabels",
        [(ngModel)]="selectedRoleLabel",
        optionLabel="label",
        (onChange)="onRoleDropdownChange($event)",
        placeholder="Select Role",
        styleClass="w-full",
        [style]="{ width: '100%' }"
      )

  p-tabs([(value)]="selectedTabIndex")
    p-tablist
      p-tab([value]="0") {{ 'userManagement.units.users' | translate }}
      p-tab([value]="1") {{ 'userManagement.units.permissions' | translate }}
      p-tab([value]="2") {{ 'userManagement.units.actions' | translate }}
    
    p-tabpanels
      p-tabpanel([value]="0")
        button.p-button-sm.p-button-primary(
          *ngIf="isEditMode",
          pButton,
          icon="pi pi-plus",
          [label]="selectedRole === 'head' && getSelectedRoleUsers().length > 0 ? ('userManagement.units.changeHeadUser' | translate) : ('userManagement.units.addUser' | translate)",
          style="margin-bottom: 1rem",
          (click)="openAddUserDialog()"
        )
        
        // Users Table
        ng-container(*ngIf="getSelectedRoleUsers().length > 0")
          p-table(
            [value]="getSelectedRoleUsers()",
            *ngIf="unit"
          )
            ng-template(pTemplate="header")
              tr
                th {{ 'userManagement.units.name' | translate }}
                th {{ 'userManagement.units.email' | translate }}
                th.actions-col-60 {{ 'userManagement.units.actions' | translate }}
            
            ng-template(
              pTemplate="body",
              let-user,
              let-i="rowIndex"
            )
              tr
                td {{ user.userName }}
                td {{ user.email || user.login }}
                td
                  // View Mode: Show View button
                  button.p-button-text.p-button-sm(
                    *ngIf="!isEditMode",
                    pButton,
                    icon="pi pi-eye",
                    [title]="'userManagement.units.viewUser' | translate",
                    (click)="viewUser(user)"
                  )
                  
                  // Edit Mode: Show View and Delete buttons
                  div.row-actions(
                    *ngIf="isEditMode"
                  )
                    button.p-button-text.p-button-sm(
                      pButton,
                      icon="pi pi-eye",
                      [title]="'userManagement.units.viewUser' | translate",
                      (click)="viewUser(user)"
                    )
                    button.p-button-text.p-button-sm.p-button-danger(
                      pButton,
                      icon="pi pi-times",
                      [title]="'userManagement.units.removeUser' | translate",
                      (click)="removeUser(selectedRole, i)"
                    )
        
        // Empty State for Users
        .empty-state-container(*ngIf="getSelectedRoleUsers().length === 0")
          i.pi.pi-users.empty-state-icon
          h3.empty-state-title {{ 'userManagement.units.noUsersForRole' | translate: { role: (selectedRole | titlecase) } }}
          p.empty-state-description {{ 'userManagement.units.noUsersDescription' | translate }}
          button.p-button-sm.p-button-primary(
            *ngIf="isEditMode",
            pButton,
            icon="pi pi-plus",
            [label]="'userManagement.units.addUser' | translate",
            (click)="openAddUserDialog()",
            style="margin-top: 1rem"
          )
        
        // User Selection Dialog
        app-user-selection-dialog(
          [(visible)]="userSelectionDialogVisible",
          [currentMembers]="getSelectedRoleUsers()",
          [role]="selectedRole",
          (membersSelected)="onUsersSelected($event)"
        )

      p-tabpanel([value]="1")
        .grid
          .col-12
            // View mode: chips only
            div(*ngIf="!isEditMode")
              .flex.flex-wrap.gap-2(*ngIf="cleanSelectedRolePermissions.length > 0")
                span.inline-block.bg-blue-100.text-blue-800.px-2.py-1.rounded-full.text-xs(
                  *ngFor="let permission of cleanSelectedRolePermissions"
                ) {{ permission.label }}
              // Empty state for permissions in view mode
              .empty-state-container(*ngIf="cleanSelectedRolePermissions.length === 0")
                i.pi.pi-lock.empty-state-icon
                h3.empty-state-title {{ 'userManagement.units.noPermissionsForRole' | translate: { role: (selectedRole | titlecase) } }}
                p.empty-state-description {{ 'userManagement.units.noPermissionsDescription' | translate }}
            // Edit mode: multiselect
            div(*ngIf="isEditMode")
              p-multiSelect.w-full(
                [options]="availablePermissions",
                [(ngModel)]="selectedPermissions",
                (onChange)="onPermissionSelectionChange($event)",
                optionLabel="label",
                [filter]="true",
                [placeholder]="'userManagement.units.selectPermissionSets' | translate",
                [panelStyle]="{minWidth: '600px', width: '80vw', maxWidth: '700px', maxHeight: '400px', overflowX: 'auto'}",
                [virtualScroll]="true",
                [virtualScrollItemSize]="34",
                [showToggleAll]="true",
                appendTo="body"
              )
                ng-template(
                  let-permission,
                  pTemplate="item"
                )
                  .flex.items-center.justify-between.p-2(style="min-width: 350px")
                    span.font-semibold {{ permission.label }}
              // Empty state message when no permissions selected in edit mode
              .empty-state-container(*ngIf="cleanSelectedRolePermissions.length === 0 && selectedPermissions.length === 0")
                i.pi.pi-lock.empty-state-icon
                p.empty-state-description {{ 'userManagement.units.noPermissionsSelected' | translate }}

      p-tabpanel([value]="2")
        app-process-actions(
          [selectedRole]="selectedRole",
          [selectedActions]="getSelectedRoleActions()",
          [isEditMode]="isEditMode",
          [showSummary]="true",
          (actionsChange)="onActionsChange($event)"
        )

// No unit selected state
.no-unit-selected(
  *ngIf="!unit"
)
  i.pi.pi-building.no-unit-icon
  h3.no-unit-title {{ 'userManagement.units.noUnitSelected' | translate }}
  p.no-unit-desc {{ 'userManagement.units.selectUnitFromTree' | translate }}
app-view-user-details(
  [(visible)]="showViewUserDialog",
  [loginId]="selectedUserLoginId"
)

  