form([formGroup]="formGroup")
  .basic-info-card
    .card-header
      h2 {{ 'userManagement.basicInfoForm.basicInformation' | translate }}
    .card-content
      .profile-upload-section
        label.section-title {{ 'userManagement.basicInfoForm.profilePicture' | translate }}
        .profile-upload-wrapper
          label.profile-upload-label(for="profilePicture")
            img.profile-picture-preview(*ngIf="formGroup.get('profilePicture').value; else placeholder", [src]="formGroup.get('profilePicture').value", alt="Profile Picture Preview")
            ng-template(#placeholder)
              span.profile-placeholder-icon.pi.pi-user
            input(type="file", id="profilePicture", accept="image/*", (change)="onProfilePictureChange($event)", hidden)
      
      .form-fields-2col
        .form-fields-col
          .form-field-row
            label(for="username")
              i.pi.pi-user.input-label-icon
              | {{ 'userManagement.basicInfoForm.username' | translate }}
              span.required *
            input(pInputText, id="username", formControlName="username", [ngClass]="{ 'ng-invalid': formGroup.get('username')?.invalid && formGroup.get('username')?.touched }")
            app-validation-errors([control]="formGroup.get('username')")
          
          .form-field-row
            label(for="email")
              i.pi.pi-envelope.input-label-icon
              | {{ 'userManagement.basicInfoForm.email' | translate }}
              span.required *
            input(pInputText, id="email", formControlName="email", [ngClass]="{ 'ng-invalid': formGroup.get('email')?.invalid && formGroup.get('email')?.touched }")
            app-validation-errors([control]="formGroup.get('email')")
          
          .form-field-row
            label(for="telephone")
              i.pi.pi-phone.input-label-icon
              | {{ 'userManagement.basicInfoForm.telephone' | translate }}
            input(pInputText, id="telephone", formControlName="telephone", [ngClass]="{ 'ng-invalid': formGroup.get('telephone')?.invalid && formGroup.get('telephone')?.touched }")
            app-validation-errors([control]="formGroup.get('telephone')")
        
        .form-fields-col
          .form-field-row
            label(for="clientId")
              i.pi.pi-id-card.input-label-icon
              | {{ 'userManagement.basicInfoForm.clientId' | translate }}
            input(pInputText, id="clientId", formControlName="clientId", [ngClass]="{ 'ng-invalid': formGroup.get('clientId')?.invalid && formGroup.get('clientId')?.touched }")
            app-validation-errors([control]="formGroup.get('clientId')")
          
          .form-field-row
            label(for="loginAlias")
              i.pi.pi-user-edit.input-label-icon
              | {{ 'userManagement.basicInfoForm.loginAlias' | translate }}
            input(pInputText, id="loginAlias", formControlName="loginAlias", [ngClass]="{ 'ng-invalid': formGroup.get('loginAlias')?.invalid && formGroup.get('loginAlias')?.touched }")
            app-validation-errors([control]="formGroup.get('loginAlias')")
          
          .toggle-row
            .toggle-field
              label(for="userType")
                i.pi.pi-user-edit.input-label-icon
                | {{ 'userManagement.basicInfoForm.userType' | translate }}
              .flex.items-center.gap-3
                p-toggleSwitch(
                  formControlName="userType", 
                  [trueValue]="true", 
                  [falseValue]="false", 
                  [disabled]="isEditMode", 
                  [style.pointer-events]="isEditMode ? 'none' : 'auto'", 
                  styleClass="user-type-toggle"
                )
                span.text-sm.font-medium.text-gray-700 {{ formGroup.get('userType')?.value ? ('userManagement.basicInfoForm.externalUser' | translate) : ('userManagement.basicInfoForm.officeUser' | translate) }}
              app-validation-errors([control]="formGroup.get('userType')")
            
            .toggle-field
              label(for="isActive")
                i.pi.pi-check-circle.input-label-icon
                | {{ 'userManagement.basicInfoForm.status' | translate }}
              .flex.items-center.gap-3
                p-toggleSwitch(
                  formControlName="isActive", 
                  [trueValue]="true", 
                  [falseValue]="false", 
                  styleClass="status-toggle"
                  [ngClass]="formGroup.get('isActive')?.value ? 'toggle-active' : 'toggle-inactive'"
                )
                span.text-sm.font-medium(
                  [ngClass]="formGroup.get('isActive')?.value ? 'text-green-600' : 'text-red-600'"
                ) {{ formGroup.get('isActive')?.value ? ('userManagement.basicInfoForm.active' | translate) : ('userManagement.basicInfoForm.inactive' | translate) }}
              app-validation-errors([control]="formGroup.get('isActive')")
      
      .signature-section
        label.section-title {{ 'userManagement.basicInfoForm.signatureUpload' | translate }}
        .signature-upload-wrapper
          label.signature-upload-label(for="signaturePicture")
            span.signature-upload-icon.pi.pi-upload
            img.signature-preview(*ngIf="formGroup.get('signaturePicture').value", [src]="formGroup.get('signaturePicture').value", alt="Signature Preview")
            input(type="file", id="signaturePicture", accept="image/*", (change)="onSignatureChange($event)", hidden)