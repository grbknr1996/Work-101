app-layout
  app-breadcrumbs([items]="breadcrumbItems")
  .create-user-container
    h1.form-title {{ isEditMode ? ('userManagement.createUserAccount.editUser' | translate) : ('userManagement.createUserAccount.createUser' | translate) }}
    app-configurable-stepper([steps]="steps", [activeStep]="activeStep", (stepChange)="onStepChange($event)")
    form([formGroup]="userForm")
      .step-content
        ng-container([ngSwitch]="activeStep")
          app-basic-info-form(*ngSwitchCase="0", [formGroup]="userForm.get('basicInfo')", [isEditMode]="isEditMode")
          app-group-assignment(
            *ngSwitchCase="1",
            [availableGroups]="filteredAvailableGroups",
            [assignedGroups]="userForm.get('assignedGroups').value",
            [currentAvailablePage]="currentGroupsPage",
            [totalAvailablePages]="totalGroupsPages",
            [totalAvailableGroups]="totalGroupsCount",
            [currentSearchTerm]="groupsSearchTerm",
            [currentFilterType]="groupsFilterType",
            [currentSortBy]="groupsSortBy",
            [currentSortOrder]="groupsSortOrder",
            (assignedGroupsChange)="onAssignedGroupsChange($event)",
            (availablePageChange)="onGroupsPageChange($event)",
            (searchChange)="onGroupsSearch($event)",
            (filterTypeChange)="onGroupsFilter($event)",
            (sortChange)="onGroupsSort($event.sortBy, $event.sortOrder)"
          )
            .loading-groups(*ngIf="isLoadingGroups")
              p {{ 'userManagement.createUserAccount.loadingGroups' | translate }}
            .error-groups(*ngIf="groupsLoadError")
              p {{ 'userManagement.createUserAccount.failedToLoadGroups' | translate }}
              button.p-button-sm(pButton, type="button", [label]="'userManagement.createUserAccount.retry' | translate", icon="pi pi-refresh", (click)="retryLoadGroups()")

          .security-step-card(*ngSwitchCase="2", [formGroup]="userForm.get('security')")
            .card-header
              h2 {{ 'userManagement.createUserAccount.securitySettings' | translate }}
            .card-content
              .form-field
                label.checkbox-label
                  input(type="checkbox", formControlName="enableTwoFactor")
                  span.checkbox-text {{ 'userManagement.createUserAccount.enableTwoFactor' | translate }}
          app-review-step(
            *ngSwitchCase="3",
            [basicInfo]="userForm.get('basicInfo').value",
            [assignedGroups]="userForm.get('assignedGroups').value",
            [security]="userForm.get('security').value"
          )
      .step-actions
        .step-actions-left
          button.p-button-secondary(
            pButton,
            type="button",
            [label]="'userManagement.createUserAccount.previous' | translate",
            (click)="prevStep()",
            *ngIf="activeStep > 0"
          )
        .step-actions-divider(*ngIf="activeStep > 0 && activeStep < steps.length - 1")
        .step-actions-right
          button.p-button-primary(
            pButton,
            type="button",
            [label]="'userManagement.createUserAccount.next' | translate",
            (click)="nextStep()",
            *ngIf="activeStep < steps.length - 1",
            [disabled]="!canProceed()"
          )
          button.p-button-success(
            pButton,
            type="button",
            [label]="isEditMode ? ('userManagement.createUserAccount.updateUser' | translate) : ('userManagement.createUserAccount.createUser' | translate)",
            (click)="saveUser()",
            *ngIf="activeStep === steps.length - 1"
          )
