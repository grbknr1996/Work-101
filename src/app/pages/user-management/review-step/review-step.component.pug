.review-step
  .card-header
    h2 {{ 'userManagement.reviewStep.reviewUserInfo' | translate }}
  .card-content
    .review-section
      h3 {{ 'userManagement.reviewStep.basicInformation' | translate }}
      .review-grid
        .review-item
          label {{ 'userManagement.reviewStep.username' | translate }}
          span {{ basicInfo?.username }}
        .review-item
          label {{ 'userManagement.reviewStep.email' | translate }}
          span {{ basicInfo?.email }}
        .review-item
          label {{ 'userManagement.reviewStep.telephone' | translate }}
          span {{ basicInfo?.telephone }}
        .review-item
          label {{ 'userManagement.reviewStep.clientId' | translate }}
          span {{ basicInfo?.clientId }}
        .review-item(*ngIf="isEditMode")
          label {{ 'userManagement.reviewStep.loginId' | translate }}
          span {{ basicInfo?.loginId }}

    .review-section
      h3 {{ 'userManagement.reviewStep.assignedGroups' | translate }}
      .review-groups
        .group-chip(*ngFor="let group of assignedGroups")
          | {{ group.name }}
          span.group-type ({{ group.type }})

    .review-section
      h3 {{ 'userManagement.reviewStep.securitySettings' | translate }}
      .review-grid
        .review-item
          label {{ 'userManagement.reviewStep.twoFactorAuth' | translate }}
          span {{ security?.enableTwoFactor ? ('userManagement.reviewStep.enabled' | translate) : ('userManagement.reviewStep.disabled' | translate) }}
