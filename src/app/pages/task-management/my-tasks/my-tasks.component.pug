app-layout
  app-breadcrumbs([items]="breadcrumbItems")

  .grid.grid-cols-1(class="md:grid-cols-4 gap-4 mb-6")
    p-card.w-full.text-center
      .font-semibold.text-sm.mb-2 My Tasks
      .text-3xl.font-bold.text-orange-600 42
    p-card.w-full.text-center
      .font-semibold.text-sm.mb-2 Overdue Tasks
      .text-3xl.font-bold.text-red-600 5
    p-card.w-full.text-center
      .font-semibold.text-sm.mb-2 Overdue Soon
      .text-3xl.font-bold.text-yellow-600 2
    p-card.w-full.text-center
      .font-semibold.text-sm.mb-2 Average age
      .text-3xl.font-bold.text-purple-600 45

  .grid.grid-cols-6.mt-2
    .col-span-6.grid.grid-cols-12.filter
      .col-span-4
        p-floatlabel(variant="on")
          p-iconfield
            p-inputicon.pi.pi-search
            input.w-full#on_label(pInputText [(ngModel)]="searchBar", (ngModelChange)="applyFilters(appliedFilters)", autocomplete="off")
          label(for="on_label") Search
      .col-span-8.flex.justify-end.gap-5.filter-icons
        p-button(
          icon="pi pi-list",
          [outlined]="true",
          [text]="true",
          (click)="myTasksList()",
          pTooltip="My Tasks",
          tooltipPosition="bottom"
        )
        .relative.inline-block
          p-button(
            icon="pi pi-cart-plus",
            [outlined]="true",
            [text]="true",
            (click)="approvalbucketList()",
            pTooltip="Approval Bucket",
            tooltipPosition="bottom"
          )
          p-badge(
            *ngIf="approvalBucket.length > 0",
            [value]="approvalBucket.length",
            severity="danger",
            styleClass="absolute -top-2 -right-2 rounded-full"
          )
          
        app-configurable-filter(
          [filters]="filterConfigs",
          [showClearAll]="false",
          [showApplyButton]="true",
          [showFilterSelector]="false",
          (filterChange)="onFilterChange($event)",
          (filterCleared)="onFilterCleared()",
          (filterApplied)="onFilterApplied($event)",
          (appliedFiltersChange)="onAppliedFiltersChange($event)"
        )

  .mb-8.mt-1.w-full
    app-filter-chips(
      [appliedFilters]="appliedFilters",
      [showClearAll]="true",
      [clearAllLabel]="'Clear All'",
      (chipRemove)="removeFilterChip($event)",
      (clearAll)="clearAllFilters()"
    )

    h3.text-lg.font-semibold.mb-3(*ngIf="showApprovalBucket", , style="margin-top: 1.5rem;") Approval Bucket List
    app-table(
      [columns]="tableColumns",
      [paginator]="true",
      [rows]="10",
      [totalRecords]="showApprovalBucket ? approvalBucket.length : tableData.length",
      [rowsPerPageOptions]="[10, 25, 50, 100]",
      [showCurrentPageReport]="true",
      [currentPageReportTemplate]="'Showing {first} to {last} of {totalRecords} tasks'",
      [dataKey]="'documentId'",
      [data]="showApprovalBucket ? approvalBucket : tableData",
      (selectionChange)="onSelectionChange($event)",
      (actionClick)="onActionClick($event.action, $event.item)"
    )

    p-sidebar.custom-sidebar(
        [(visible)]="showSlider",
        position="right",
        [showCloseIcon]="false",
        [dismissible]="false",
        [ngClass]="{ 'sidebar-maximized': isMaximized }",
        [appendTo]="'app-layout'"
    )

      .sidebar-header.flex.items-center.justify-between.p-3
        h2.text-lg.font-semibold {{ sliderTitle }}
        .flex.gap-2
          p-button(
            [icon]="isMaximized ? 'pi pi-window-minimize' : 'pi pi-window-maximize'",
            [rounded]="true",
            [outlined]="true",
            severity="secondary",
            (onClick)="toggleMaximize()",
            styleClass="p-button-text p-button-sm"
          )
          p-button(
            icon="pi pi-times",
            [rounded]="true",
            [outlined]="true",
            severity="secondary",
            (onClick)="closeSlider()",
            styleClass="p-button-text p-button-sm"
          )
        
      .sidebar-content.p-4
        ng-container([ngSwitch]="sliderAction")
          div(*ngSwitchCase="'approve'")
            app-record-actions([taskId]="selectedTask?.documentId",[showLayout]="false", (close)="closeSlider()")
          div(*ngSwitchCase="'history'")
            app-task-history([taskId]="selectedTask?.documentId",[showLayout]="false", (close)="closeSlider()")
          div(*ngSwitchDefault)
            | No action selected.

  .flex.justify-end.mt-2
    p-button(*ngIf="selectedTasks.length > 0 && showApprovalBucket && !showSlider", label="Bulk Approve", icon="pi pi-check-circle", styleClass="p-button-success", (onClick)="bulkApprove()")
