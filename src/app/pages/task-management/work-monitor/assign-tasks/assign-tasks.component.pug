app-layout
  app-breadcrumbs([items]="breadcrumbItems")

  .grid.grid-cols-1(class="md:grid-cols-4 gap-4 mb-6")
    p-card.w-full
      .font-semibold.text-lg.mb-2 {{ 'taskManagement.assigntasks.labels.process' | translate }}
      .text-sm {{ selectedProcessName }}

    //- Status
    p-card.w-full
      .font-semibold.text-lg.mb-2 {{ 'taskManagement.assigntasks.labels.status' | translate }}
      .text-sm {{ stageLabel }}

    p-card.w-full
      .font-semibold.text-lg.mb-2 {{ 'taskManagement.assigntasks.labels.pendingTasks' | translate }}
      .text-sm {{ tasksToDistribute }}

    //- Total Tasks
    p-card.w-full
      .font-semibold.text-lg.mb-2 {{ 'taskManagement.assigntasks.labels.totalTasks' | translate }}
      .text-sm {{ totalTasks }}

  .grid.grid-cols-6.mt-2
    .col-span-6.grid.grid-cols-12.filter
      .col-span-4
        p-floatlabel(variant="on")
          p-iconfield
            p-inputicon(class="pi pi-search")
            input.w-full#on_label(
              pInputText
              [(ngModel)]="searchBar",
              (ngModelChange)="applyFilters(appliedFilters)",
              autocomplete="off"
            )
          label(for="on_label") Search

      .col-span-8.flex.justify-end.gap-2.filter-icons
        app-configurable-filter(
          [filters]="filterConfigs",
          [showClearAll]="false",
          [showApplyButton]="true",
          [showFilterSelector]="false",
          (filterChange)="onFilterChange($event)",
          (filterCleared)="onFilterCleared()",
          (filterApplied)="onFilterApplied($event)",
          (appliedFiltersChange)="onAppliedFiltersChange($event)"
        )

  app-table(
    [columns]="tableColumns",
    [data]="filteredGroups",
    [paginator]="true",
    [rows]="10",
    [totalRecords]="totalRecords",
    [rowsPerPageOptions]="[10, 25, 50, 100]",
    [showCurrentPageReport]="true",
    [currentPageReportTemplate]="'Showing {first} to {last} of {totalRecords} tasks'",
    [showClearButton]="false",
    [dataKey]="'documentId'",
    (selectionChange)="onSelectionChange($event)",
    (actionClick)="onActionClick($event.action, $event.item)"
  )

  div(*ngIf="selectedTasks.length > 0").flex.flex-wrap.items-start.gap-4
    //- Select User Unit
    .flex.flex-col.flex-1
      label.block.text-sm.font-medium.mb-1 {{ 'taskManagement.assigntasks.labels.selectUnit' | translate }}
      p-dropdown.w-full.border.rounded-md(
        [options]="unitWithMembers",
        optionLabel="unitName",
        optionValue="id",
        [placeholder]="'taskManagement.assigntasks.placeholders.selectUnit' | translate",
        (onChange)="onUnitChange($event.value)"
      )

    //- Select User
    .flex.flex-col.flex-1
      label.block.text-sm.font-medium.mb-1 {{ 'taskManagement.assigntasks.labels.selectUser' | translate }}
      p-dropdown.w-full.border.rounded-md(
        [options]="members"
        optionLabel="name"
        optionValue="id"
        [placeholder]="'taskManagement.assigntasks.placeholders.selectUser' | translate"
        [(ngModel)]="selectedMemberId",
        (onChange)="selectedMemberId = $event.value"
      )

    //- Actions
    .flex.flex-col.flex-1
      label.block.text-sm.font-medium.mb-1 {{ 'taskManagement.assigntasks.labels.actions' | translate }}
      .flex.gap-2
        p-button([label]="'taskManagement.assigntasks.buttons.confirm' | translate", (onClick)="Assign()", [disabled]="!selectedMemberId")
        button.p-button-danger(
          *ngIf="isAssignedView && selectedTasks.length > 0",
          pButton,
          type="button",
          [label]="'taskManagement.assigntasks.buttons.unassign' | translate",
          icon="pi pi-user-minus",
          (click)="unassignTasks()"
        )
