app-layout
  app-breadcrumbs([items]="breadcrumbItems")

  //- Top Stat Cards: 3x2 grid for Work Monitor
  .grid.grid-cols-1(class="md:grid-cols-5 gap-6 mb-6")
    .col-span-3
      .grid.grid-cols-1(class="md:grid-cols-3 gap-4")
        ng-container(*ngFor="let cat of categoriess")
          .stat-cards.bg-white.shadow.rounded.p-4.flex.flex-col.justify-between.h-full.max-w-sm.w-full.cursor-pointer.transition.border(
            [class.bg-blue-50]="selectedProcess === cat.processName",
            [class.border-blue-500]="selectedProcess === cat.processName",
            (click)="selectProcess(cat.processName)"
          )
            .font-semibold.text-lg.mb-6 {{cat.processName}}
            .flex.justify-between.mb-1
              span.font-semibold Total: {{cat.total}}
              span.text-red-600 Pending: {{cat.pending}}
            .text-sm Average age: {{cat.avgAge}} days

  //- Filters Section
  .grid.grid-cols-6.mt-2
    .col-span-6.grid.grid-cols-12.filter
      .col-span-4
        p-floatlabel(variant="on")
          p-iconfield
            p-inputicon.pi.pi-search
            input.w-full#on_label(
              pInputText
              [(ngModel)]="searchBar",
              (ngModelChange)="applyFilters(appliedFilters)",
              autocomplete="off"
            )
          label(for="on_label") Search
      .col-span-8.flex.justify-end.gap-2.filter-icons
        p-button(
          [icon]="viewType === 'card' ? 'pi pi-list' : 'pi pi-th-large'",
          [outlined]="true",
          [text]="true",
          (click)="toggleView()",
          [pTooltip]="viewType === 'card' ? 'List View' : 'Card View'",
          tooltipPosition="bottom"
        )
        app-configurable-filter(
          *ngIf="filterConfigs.length",
          [filters]="filterConfigs",
          [showClearAll]="true",
          [showApplyButton]="true",
          [showFilterSelector]="false",
          (filterChange)="onFilterChange($event)",
          (filterApplied)="onFilterApplied($event)",
          (appliedFiltersChange)="onAppliedFiltersChange($event)"
        )

  //- Tabs Section
  .col-span-6
    p-tabs([(value)]="selectedProcess", (valueChange)="selectProcess($event)")
      p-tablist
        ng-container(*ngFor="let processGroup of processGroupByName; trackBy: trackByName")
          p-tab([value]="processGroup.name")
            .category-label {{ processGroup.name | capitalizeWords }}
            p-badge([value]="processGroup.list.length")

      p-tabpanels
        ng-container(*ngFor="let processGroup of processGroupByName; trackBy: trackByName")
          p-tabpanel([value]="processGroup.name")
            //- Card view
            div(*ngIf="viewType === 'card'").grid.grid-cols-12.gap-3
              ng-container(*ngFor="let process of tableData; trackBy: trackByProcessId")
                .col-span-12(class="sm:col-span-6 md:col-span-3 mt-3")
                  p-card.w-full
                    .flex.items-center.justify-between.text-base.font-bold.mb-2
                      span {{ process.processName }}
                      .flex.space-x-2
                        p-button(
                          icon="pi pi-arrows-alt",
                          [outlined]="true",
                          [text]="true",
                          (click)="navigateToDistributionScreen(process)",
                          pTooltip="Task Distribution",
                          tooltipPosition="bottom"
                        )
                        p-button(
                          icon="pi pi-user-plus",
                          [outlined]="true",
                          [text]="true",
                          (click)="navigateToUserAssignmentScreen(process.id)",
                          pTooltip="User Assignment",
                          tooltipPosition="bottom"
                        )

                    .font-semibold.mb-3.bg-white.border.rounded-md.text-center.shadow-sm.cursor-pointer.inline-block.py-1.px-2
                       | {{ process.status }}


                    .flex.justify-between.mb-1
                      span.text-green-800.font-bold Assigned: {{ process.assignedTasks }}
                      span.text-red-600.font-bold Unassigned: {{ process.unassignedTasks }}

                    .flex.items-center.text-xs.text-blue-700
                      span.pi.pi-clock.mr-1
                      | {{ process.averageAge }} days

            //- List view
            div(*ngIf="viewType === 'list'")
              app-table(
                [paginator]="true",
                [rows]="10",
                [totalRecords]="tableData.length",
                [rowsPerPageOptions]="[10, 25, 50, 100]",
                [showCurrentPageReport]="true",
                [currentPageReportTemplate]="'Showing {first} to {last} of {totalRecords} process statuses'",
                [columns]="tableColumns",
                [showClearButton]="false",
                [data]="tableData",
                (actionClick)="onActionClick($event.action, $event.item)"
              )