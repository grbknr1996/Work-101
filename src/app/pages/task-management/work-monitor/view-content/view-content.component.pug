app-layout
  app-breadcrumbs([items]="breadcrumbItems")
  p-toolbar.mb-3
    .w-full.flex.justify-between.items-center
      .text-lg.font-medium.text-gray-800 File Content Viewer:
      .flex.items-center.gap-2(style="display: flex; align-items: center;")
        p-button(severity="secondary", text, (click)="changeLayout('four')")
            img(src='assets/icons/fourPanel.svg', alt="Four Panel", style="width: 24px; height: 24px;")
        p-button(severity="secondary", text (click)="changeLayout('three-hv')")
            img(src='assets/icons/threeColumn-firstSplit.svg', alt="Three Horizontal Vertical", style="width: 24px; height: 24px;")
        p-button(severity="secondary", text (click)="changeLayout('three-v')")
            img(src='assets/icons/threePanelsView.svg', alt="Three Vertical", style="width: 24px; height: 24px;")
        p-button(severity="secondary", text (click)="changeLayout('two')")
            img(src='assets/icons/twoPanels.svg', alt="Two Panel", style="width: 24px; height: 24px;")
        p-button(icon="pi pi-arrow-right-arrow-left", pTooltip="Switch Sides",tooltipPosition="bottom", severity="secondary", text (click)="switchSides()")

  ng-container(*ngIf="expandedPanelIndex === null; else expandedPanelView")
    ng-container([ngSwitch]="layoutMode")
      div(*ngSwitchCase="'four'").grid.h-screen.four-panel-grid
        .col-6.flex.flex-column
          div(*ngFor="let panel of panelContents.slice(0,2); let i = index").flex-1.border.surface-border.m-2.p-3.panel-scrollable
            app-panel-header-icons([panelName]="panel", [panelIndex]="i", [panelTypes]="panelTypes", (switchContent)="switchPanelContent(i, $event.content)", (expandPanel)="toggleExpandPanel(i)", [isExpanded]="expandedPanelIndex === i")
            app-biblio-data(*ngIf="panel === 'Bibliographic Data'")
            app-record-actions(*ngIf="panel === 'Action Recorder'", [showLayout]="false")
            app-task-history(*ngIf="panel === 'File History'", [showLayout]="false")
        .col-6.flex.flex-column
          div(*ngFor="let panel of panelContents.slice(2,4); let i = index").flex-1.border.surface-border.m-2.p-3.panel-scrollable
            app-panel-header-icons([panelName]="panel", [panelIndex]="i + 2", [panelTypes]="panelTypes", (switchContent)="switchPanelContent(i + 2, $event.content)", [isExpanded]="expandedPanelIndex === i", (expandPanel)="toggleExpandPanel(i + 2)")
            app-biblio-data(*ngIf="panel === 'Bibliographic Data'")
            app-record-actions(*ngIf="panel === 'Action Recorder'", [showLayout]="false")
            app-task-history(*ngIf="panel === 'File History'", [showLayout]="false")

      div(*ngIf="expandedPanelIndex !== null").expanded-panel-overlay
        .expanded-panel-content
          app-panel-header-icons([panelName]="panelContents[expandedPanelIndex!]", [panelIndex]="expandedPanelIndex", [panelTypes]="panelTypes", (switchContent)="switchPanelContent(expandedPanelIndex!, $event.content)", (expandPanel)="expandPanel(i)")
          app-biblio-data(*ngIf="panelContents[expandedPanelIndex!] === 'Bibliographic Data'")
          app-record-actions(*ngIf="panelContents[expandedPanelIndex!] === 'Action Recorder'", [showLayout]="false")
          app-task-history(*ngIf="panelContents[expandedPanelIndex!] === 'File History'", [showLayout]="false")
          button.close-btn((click)="closeExpandedPanel()") Close

      div.flex.h-screen.three-hv(
        *ngSwitchCase="'three-hv'" 
        style="display: flex; flex-direction: row;"
        )
        div(style="flex: 1; display: flex; flex-direction: column; height: 100%;")
          div(*ngFor="let panel of panelContents.slice(0,2); let i = index", style="flex: 1;").border.surface-border.m-2.p-3.panel-scrollable
            app-panel-header-icons([panelName]="panel", [panelIndex]="i", [panelTypes]="panelTypes", (switchContent)="switchPanelContent(i, $event.content)", (expandPanel)="expandPanel(i)")
            app-biblio-data(*ngIf="panel === 'Bibliographic Data'")
            app-record-actions(*ngIf="panel === 'Action Recorder'", [showLayout]="false")
            app-task-history(*ngIf="panel === 'File History'", [showLayout]="false")
        div(style="flex: 1; height: 100%; display: flex; flex-direction: column;").border.surface-border.m-2.p-3.panel-scrollable
          app-panel-header-icons([panelName]="panelContents[2]", [panelIndex]="2", [panelTypes]="panelTypes", (switchContent)="switchPanelContent(2, $event.content)", (expandPanel)="expandPanel(2)")
          app-biblio-data(*ngIf="panelContents[2] === 'Bibliographic Data'")
          app-record-actions(*ngIf="panelContents[2] === 'Action Recorder'", [showLayout]="false")
          app-task-history(*ngIf="panelContents[2] === 'File History'", [showLayout]="false")

      div(*ngSwitchCase="'three-v'").flex.h-screen.three-v
        div(*ngFor="let panel of panelContents; let i= index").flex-1.border.surface-border.m-2.p-3.panel-scrollable
          app-panel-header-icons([panelName]="panel", [panelIndex]="i", [panelTypes]="panelTypes", (switchContent)="switchPanelContent($event.index, $event.content)", (expandPanel)="expandPanel(i)")
          .panel-body
            app-biblio-data(*ngIf="panel === 'Bibliographic Data'")
            app-record-actions(*ngIf="panel === 'Action Recorder'", [showLayout]="false")
            app-task-history(*ngIf="panel === 'File History'", [showLayout]="false")

      div(*ngSwitchCase="'two'").flex.h-screen.two-panel
        div(*ngFor="let panel of panelContents; let i = index").flex-1.border.surface-border.m-2.p-3.panel-scrollable
          app-panel-header-icons([panelName]="panel", [panelIndex]="i", [panelTypes]="panelTypes", (switchContent)="switchPanelContent(i, $event.content)", (expandPanel)="expandPanel(i)")
          app-biblio-data(*ngIf="panel === 'Bibliographic Data'")
          app-record-actions(*ngIf="panel === 'Action Recorder'", [showLayout]="false")
          app-task-history(*ngIf="panel === 'File History'", [showLayout]="false")

  ng-template(#expandedPanelView)
    .full-screen-panel
      app-panel-header-icons([panelName]="panelContents[expandedPanelIndex!]", [panelIndex]="expandedPanelIndex", [isExpanded]="true", [panelTypes]="panelTypes", (switchContent)="switchPanelContent(expandedPanelIndex!, $event.content)", (expandPanel)="toggleExpandPanel(expandedPanelIndex!)")
      app-biblio-data(*ngIf="panelContents[expandedPanelIndex!] === 'Bibliographic Data'")
      app-record-actions(*ngIf="panelContents[expandedPanelIndex!] === 'Action Recorder'", [showLayout]="false")
      app-task-history(*ngIf="panelContents[expandedPanelIndex!] === 'File History'", [showLayout]="false")