ng-container(*ngIf="showLayout")
  app-layout
    ng-container(*ngTemplateOutlet="mainHistoryContent")

ng-container(*ngIf="!showLayout")
  ng-container(*ngTemplateOutlet="mainHistoryContent")

ng-template(#mainHistoryContent)
  div(class="relative")
    div(class="absolute top-0 left-9 w-0.5 bg-gray-300 h-full")

    ng-container(*ngFor="let step of workflowTree")
      ng-container(*ngTemplateOutlet="stepTemplate; context: {$implicit: step, level: 0}")

  ng-template(#stepTemplate let-step let-level="level")
    div(class="relative mb-6", [ngStyle]="{'margin-left.px': level * 40}")
      div(class="flex items-center gap-2 cursor-pointer", (click)="step.expanded = !step.expanded")
        i.pi(
          class="w-4 text-gray-400 text-sm",
          [ngClass]="{'pi-chevron-right': !step.expanded, 'pi-chevron-down': step.expanded, 'opacity-50 pointer-events-none': !step.children?.length}"
        )

        span(
          class="w-7 h-7 flex items-center justify-center rounded-full text-white font-semibold text-sm transition-all duration-200",
          [ngClass]="getDotClass(step)"
        ) •

        span(class="font-medium text-base") {{ step.label }}
        span(*ngIf="step.data?.isCurrent", class="ml-2 px-2 py-0.5 text-xs rounded bg-blue-100 text-blue-800 font-semibold border border-blue-300") Current
        span(
          *ngIf="hasAssignedSubtask(step) && !step.expanded",
          class="ml-2 px-2 py-0.5 text-xs rounded bg-blue-100 text-blue-800 font-semibold border border-blue-300"
        ) Assigned to you

      div(*ngIf="step.expanded", class="mt-3 ml-6 p-4 rounded-lg bg-gray-50 border border-gray-200")

        div(class="flex items-center gap-2 text-sm mb-3")
          span(
            [ngClass]="{'text-green-600': step.data?.status === 'Completed', 'text-blue-600': step.data?.status === 'In Progress', 'text-gray-500': step.data?.status === 'Not Started', 'text-gray-500': step.data?.status === 'Pending'}"
          ) Status: {{ step.data?.status }}
          span(*ngIf="step.data?.duration", class="text-gray-500") • {{ step.data.duration }}

        div(class="flex items-center gap-2 mb-2")
          ng-container(*ngIf="step.data?.assignees?.length; else singleAssignee")
            div(class="flex -space-x-2")
              span(
                *ngFor="let user of step.data.assignees",
                class="w-8 h-8 flex items-center justify-center rounded-full bg-blue-600 text-white text-sm"
              ) {{ user }}
            span(class="text-sm text-gray-700") {{ step.data.users }} total users

          ng-template(#singleAssignee)
            span(
              *ngIf="step.data?.assignee",
              class="px-3 py-1 rounded-full bg-blue-600 text-white text-xs font-medium"
            ) {{ step.data.assignee }}
            span(
              *ngIf="step.data?.assignedToMe && step.data?.status === 'In Progress'",
              class="ml-2 px-2 py-0.5 text-xs rounded bg-blue-100 text-blue-800 font-semibold border border-blue-300"
            ) Assigned to you

        p(*ngIf="step.data?.description", class="text-sm text-gray-700 mb-3") {{ step.data.description }}

        div(class="flex gap-3 mb-3")
          button(pButton, type="button", label="Document", icon="pi pi-file", class="p-button-outlined p-button-sm")
          button(pButton, type="button", label="Comment", icon="pi pi-comment", class="p-button-outlined p-button-sm", (click)="toggleComments(step)")

        div(*ngIf="step.showComments", class="mt-2 p-3 rounded-md bg-white border border-gray-200")
          ng-container(*ngIf="step.data && step.data.comments && step.data.comments.length > 0; else noComments")
            div(*ngFor="let comment of step.data.comments", class="text-sm text-gray-700 mb-2 border-b border-gray-100 pb-1") {{ comment }}
          ng-template(#noComments)
            div(class="text-sm text-gray-500 italic") No comments

        div(*ngIf="step.data?.date", class="text-xs text-gray-500 flex items-center")
          i(class="pi pi-clock mr-1")
          | {{ step.data?.date }}

        div(*ngIf="step.children?.length", class="mt-4")
          ng-container(*ngFor="let child of step.children")
            ng-container(*ngTemplateOutlet="stepTemplate; context: {$implicit: child, level: level + 1}")