.approval-review-container

  p-card(*ngFor="let item of approvalReviewData" class="mb-3 shadow-2 border-round-md")

    // ---- CARD TITLE ----
    ng-template(pTemplate="title")
      .flex.w-full.align-items-center

        .flex-1
          span.text-lg.font-semibold.text-gray-900 {{ item.reviewerName }}
        .flex.justify-content-end(style="min-width: 150px;")
          span.text-sm.text-gray-600(*ngIf="item.reviewDate") {{ item.reviewDate }}

    ng-template(pTemplate="content")

      // Legal Background
      div(*ngIf="item.legalBackground" class="mb-3")
        .font-semibold.mb-1 {{ 'taskManagement.approval.backgroundTitle' | translate }}
        .text-700 {{ item.legalBackground }}
      p-divider(*ngIf="item.legalBackground")

      // Review Comments
      div(*ngIf="item.reviewComments" class="mb-3")
        .font-semibold.mb-1 {{ 'taskManagement.approval.comments' | translate }}
        .text-700 {{ item.reviewComments }}
      p-divider(*ngIf="item.reviewComments")

      // Actions to Overcome
      div(*ngIf="item.actionsToOvercome" class="mb-3")
        .font-semibold.mb-1 {{ 'taskManagement.approval.outcomes' | translate }}
        .text-700 {{ item.actionsToOvercome }}
