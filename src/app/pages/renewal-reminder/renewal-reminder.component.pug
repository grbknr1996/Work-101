app-layout([config]="layoutConfig")
  app-breadcrumbs([items]="breadcrumbItems")
  .user-accounts-header
    h1 {{"renewal.title"|translate}}
  app-multiple-stats([multipleStats]="packageStats",
    (statSelected)="onStatSelect($event)",
    [selectedStat]="statSelected")
  app-configurable-filter-bar(
          [filters]="filterConfigs",
          [showClearAll]="true",
          [showApplyButton]="true",
          [showFilterSelector]="true",
          (filterChange)="onFilterChange($event)",
          (filterCleared)="onFilterCleared()",
          (filterApplied)="onFilterApplied($event)",
          (appliedFiltersChange)="onAppliedFiltersChange($event)",
          [showDateSearchBar]="true",
          (filterDateSearch)="filterSearch($event)",
          [appliedFilters]="appliedFilters",
          [clearAllLabel]="'common.components.filter.clearAll'|translate",
          [getDisplayValue]="getFilterDisplayValue.bind(this)",
          (chipRemove)="removeFilterChip($event)",
          (clearAll)="clearAllFilters()",
          (removeDefaultFilter)="removeDefaultFilter($event)",
        )
  div.flex.justify-between.items-center(style="padding:5px 5px 0 0")
      div
      button.p-button-primary(
        pButton,
        [disabled]="selectedItems.length == 0"
        [label]="'renewal.button.sendNotification'|translate",
        icon="pi pi-envelope",
        (click)="onSendMail()"
      )
  div([style]="tableData.length > 0 ? '' : 'display:none;'")
    app-table([columns]="tableColumns", [data]="tableData", (selectionChange)="onSelectionChange($event)", (actionClick)="onActionClick($event.action, $event.item)", [showClearButton]="false", [showSearch]="false") 
  div([style]="tableData.length == 0 ? 'align-self:center' : 'display:none;'")
    h5 {{"renewal.table.emptyMessage"|translate}}