app-layout([config]="layoutConfig")
  app-breadcrumbs([items]="getBreadcrumbItems()")
  
  .data-exchange-config-heading.pb-10
    h1 {{'Data Exchange Configuration' | translate }}
    p
      {'Click on any of the cards above to navigate to the respective configuration section.' | translate }
  
  .summary-stats
    .stat-card(
      *ngFor="let card of summaryCards",
      (click)="onSummaryCardClick(card)",
      [style.cursor]="card.clickable ? 'pointer' : 'default'"
    )
      .stat-content
        .stat-icon(
          [ngStyle]="{'background': 'linear-gradient(135deg, ' + card.color + ' 0%, ' + card.color + 'dd 100%)'}"
        )
          i([class]="card.icon")
        .stat-info
          .stat-number(*ngIf="card.count !== null") {{ card.count }}
          .stat-label {{ card.title | translate }}