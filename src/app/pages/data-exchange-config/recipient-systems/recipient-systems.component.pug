app-layout([config]="layoutConfig")
  app-breadcrumbs([items]="getBreadcrumbItems()")

  // Page Header
  .page-header
    .header-content
      .header-title
        h1 Recipient Systems
        p Configure systems that receive data from IP offices
      .header-actions
        button(
          pButton,
          type="button",
          label="Import Systems",
          icon="pi pi-upload",
          class="p-button-outlined"
        )
        button(
          pButton,
          type="button",
          label="Add System",
          icon="pi pi-plus",
          (click)="onAddSystem()"
        )

  // Statistics Cards
  .stats-section
    p-card(styleClass="stat-card")
      .stat-content
        .stat-icon
          i.pi.pi-database
        .stat-info
          .stat-number {{ filteredSystems().length }}
          .stat-label Total Systems

    p-card(styleClass="stat-card")
      .stat-content
        .stat-icon
          i.pi.pi-check-circle
        .stat-info
          .stat-number {{ activeSystemsCount() }}
          .stat-label Active Systems

    p-card(styleClass="stat-card")
      .stat-content
        .stat-icon
          i.pi.pi-globe
        .stat-info
          .stat-number {{ globalSystemsCount() }}
          .stat-label Global Systems

    p-card(styleClass="stat-card")
      .stat-content
        .stat-icon
          i.pi.pi-shield
        .stat-info
          .stat-number {{ totalRulesCount() }}
          .stat-label Total Rules

  // Systems Table
  .table-section
    p-card(header="Recipient Systems", styleClass="table-card")
      app-table(
        [columns]="columns",
        [data]="filteredSystems()",
        [rows]="10",
        [paginator]="true",
        [loading]="loading",
        (actionClick)="onActionClick($event)"
      )
        // Status Template
        ng-template(#statusTemplate, let-row)
          span.status-badge([ngClass]="getStatusClass(row.status)") {{ row.status }}

        // Data Types Template
        ng-template(#dataTypesTemplate, let-row)
          .data-types
            span.data-type-badge(*ngFor="let type of row.dataTypes") {{ getDataTypesLabel([type]) }}

  // Add System Dialog
  p-dialog(
    header="Add Recipient System",
    [(visible)]="showAddDialog",
    [modal]="true",
    [style]="{ width: '700px' }",
    [draggable]="false",
    [resizable]="false"
  )
    form([formGroup]="systemForm", class="system-form")
      .form-grid
        .form-field
          label(for="code") System Code *
          input(
            id="code",
            type="text",
            pInputText,
            formControlName="code",
            placeholder="e.g., PATENTSCOPE, GBDB",
            maxlength="20"
          )
          small.p-error(
            *ngIf="systemForm.get('code')?.invalid && systemForm.get('code')?.touched"
          )
            | System code is required and must be 20 characters or less

        .form-field
          label(for="name") System Name *
          input(
            id="name",
            type="text",
            pInputText,
            formControlName="name",
            placeholder="e.g., WIPO PATENTSCOPE"
          )
          small.p-error(
            *ngIf="systemForm.get('name')?.invalid && systemForm.get('name')?.touched"
          )
            | System name is required and must be at least 3 characters

        .form-field
          label(for="type") System Type *
          p-dropdown(
            id="type",
            [options]="systemTypes",
            formControlName="type",
            placeholder="Select Type",
            optionLabel="label",
            optionValue="value"
          )
          small.p-error(
            *ngIf="systemForm.get('type')?.invalid && systemForm.get('type')?.touched"
          )
            | System type is required

        .form-field
          label(for="status") Status *
          p-dropdown(
            id="status",
            [options]="[{ label: 'Active', value: 'active' }, { label: 'Inactive', value: 'inactive' }]",
            formControlName="status",
            placeholder="Select Status",
            optionLabel="label",
            optionValue="value"
          )

        .form-field.full-width
          label(for="endpoint") API Endpoint
          input(
            id="endpoint",
            type="url",
            pInputText,
            formControlName="endpoint",
            placeholder="https://api.wipo.int/system-name"
          )
          small.p-error(
            *ngIf="systemForm.get('endpoint')?.invalid && systemForm.get('endpoint')?.touched"
          )
            | Please enter a valid URL starting with http:// or https://

        .form-field.full-width
          label(for="dataTypes") Data Types *
          p-multiselect(
            id="dataTypes",
            [options]="dataTypes",
            formControlName="dataTypes",
            placeholder="Select Data Types",
            optionLabel="label",
            optionValue="value",
            display="chip"
          )
          small.p-error(
            *ngIf="systemForm.get('dataTypes')?.invalid && systemForm.get('dataTypes')?.touched"
          )
            | At least one data type must be selected

    ng-template(pTemplate="footer")
      button(
        pButton,
        type="button",
        label="Cancel",
        class="p-button-text",
        (click)="onCancel()"
      )
      button(
        pButton,
        type="button",
        label="Save",
        (click)="onSaveSystem()",
        [disabled]="!systemForm.valid"
      )

  // Edit System Dialog
  p-dialog(
    header="Edit Recipient System",
    [(visible)]="showEditDialog",
    [modal]="true",
    [style]="{ width: '700px' }",
    [draggable]="false",
    [resizable]="false"
  )
    form([formGroup]="systemForm", class="system-form")
      .form-grid
        .form-field
          label(for="edit-code") System Code *
          input(
            id="edit-code",
            type="text",
            pInputText,
            formControlName="code",
            placeholder="e.g., PATENTSCOPE, GBDB",
            maxlength="20"
          )
          small.p-error(
            *ngIf="systemForm.get('code')?.invalid && systemForm.get('code')?.touched"
          )
            | System code is required and must be 20 characters or less

        .form-field
          label(for="edit-name") System Name *
          input(
            id="edit-name",
            type="text",
            pInputText,
            formControlName="name",
            placeholder="e.g., WIPO PATENTSCOPE"
          )
          small.p-error(
            *ngIf="systemForm.get('name')?.invalid && systemForm.get('name')?.touched"
          )
            | System name is required and must be at least 3 characters

        .form-field
          label(for="edit-type") System Type *
          p-dropdown(
            id="edit-type",
            [options]="systemTypes",
            formControlName="type",
            placeholder="Select Type",
            optionLabel="label",
            optionValue="value"
          )
          small.p-error(
            *ngIf="systemForm.get('type')?.invalid && systemForm.get('type')?.touched"
          )
            | System type is required

        .form-field
          label(for="edit-status") Status *
          p-dropdown(
            id="edit-status",
            [options]="[{ label: 'Active', value: 'active' }, { label: 'Inactive', value: 'inactive' }]",
            formControlName="status",
            placeholder="Select Status",
            optionLabel="label",
            optionValue="value"
          )

        .form-field.full-width
          label(for="edit-endpoint") API Endpoint
          input(
            id="edit-endpoint",
            type="url",
            pInputText,
            formControlName="endpoint",
            placeholder="https://api.wipo.int/system-name"
          )
          small.p-error(
            *ngIf="systemForm.get('endpoint')?.invalid && systemForm.get('endpoint')?.touched"
          )
            | Please enter a valid URL starting with http:// or https://

        .form-field.full-width
          label(for="edit-dataTypes") Data Types *
          p-multiselect(
            id="edit-dataTypes",
            [options]="dataTypes",
            formControlName="dataTypes",
            placeholder="Select Data Types",
            optionLabel="label",
            optionValue="value",
            display="chip"
          )
          small.p-error(
            *ngIf="systemForm.get('dataTypes')?.invalid && systemForm.get('dataTypes')?.touched"
          )
            | At least one data type must be selected

    ng-template(pTemplate="footer")
      button(
        pButton,
        type="button",
        label="Cancel",
        class="p-button-text",
        (click)="onCancel()"
      )
      button(
        pButton,
        type="button",
        label="Update",
        (click)="onSaveSystem()",
        [disabled]="!systemForm.valid"
      )

  // Confirmation Dialog
  p-confirmDialog
