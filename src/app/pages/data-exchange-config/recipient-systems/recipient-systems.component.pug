app-layout([config]="layoutConfig")
  app-breadcrumbs([items]="getBreadcrumbItems()")

  // Page Header
  .mb-8
    .flex.justify-between.items-center.mb-4
      div
        h1.text-2xl.font-semibold.text-gray-800.mb-2 Recipient Systems
        p.text-gray-600.text-sm Configure systems that receive data from IP offices
      .flex.gap-3
        button(
          pButton,
          type="button",
          icon="pi pi-info-circle",
          class="p-button-text p-button-rounded",
          (click)="showInfoMessage()",
          pTooltip="Click for information about updating recipient systems",
          tooltipPosition="bottom"
        )

  // Statistics Cards
  .stats-section
    p-card(styleClass="stat-card")
      .stat-content
        .stat-icon
          i.pi.pi-database
        .stat-info
          .stat-number {{ totalSystemsCount() }}
          .stat-label Total Recipients

    p-card(styleClass="stat-card")
      .stat-content
        .stat-icon
          i.pi.pi-tags
        .stat-info
          .stat-number {{ totalIpTypesCount() }}
          .stat-label IP Types

    p-card(styleClass="stat-card")
      .stat-content
        .stat-icon
          i.pi.pi-calendar
        .stat-info
          .stat-number {{ totalEventTypesCount() }}
          .stat-label Event Types

    p-card(styleClass="stat-card")
      .stat-content
        .stat-icon
          i.pi.pi-file
        .stat-info
          .stat-number {{ totalDocumentTypesCount() }}
          .stat-label Document Types

  // Systems Table
  .mb-8
    p-card(styleClass="bg-white rounded-lg shadow-sm border border-gray-200")
      p-table(
        [value]="filteredSystems()",
        [rows]="10",
        [paginator]="true",
        [loading]="loading",
        [showCurrentPageReport]="true",
        currentPageReportTemplate="Showing {first} to {last} of {totalRecords} entries",
        [rowsPerPageOptions]="[10, 25, 50]",
        styleClass="p-datatable-sm",
        [dataKey]="'recipientCode'"
      )
        // IP Types Column
        ng-template(pTemplate="header")
          tr
            th.w-12
            th Recipient Name
            th IP Types
            th Event Types
            th Document Types

        ng-template(pTemplate="body", let-row)
          tr
            td
              button(
                pButton,
                type="button",
                [icon]="isRowExpanded(row.recipientCode) ? 'pi pi-chevron-down' : 'pi pi-chevron-right'",
                class="p-button-text p-button-rounded p-button-sm",
                (click)="toggleRowExpansion(row.recipientCode)",
                pTooltip="Click to expand/collapse details",
                tooltipPosition="top"
              )

            td {{ row.recipientName }}
            td
              .flex.flex-wrap.gap-2
                span.inline-flex.items-center.px-3.py-1.rounded-full.text-xs.font-medium.bg-blue-50.text-blue-700.border.border-blue-200(
                  *ngFor="let category of row.ipTypeCategoryBag"
                )
                  | {{ category.ipTypeLabel }}

            td
              .flex.flex-wrap.gap-2
                span.inline-flex.items-center.px-3.py-1.rounded-full.text-xs.font-medium.bg-purple-50.text-purple-700.border.border-purple-200(
                  *ngFor="let category of row.ipTypeCategoryBag",
                  [pTooltip]="getEventTypesTooltip(category)",
                  tooltipPosition="top",
                  [tooltipOptions]="tooltipOptions"
                )
                  span.mr-1 {{ category.ipTypeLabel }}:
                  span(class="bg-white bg-opacity-70 rounded-full px-2 py-0.5 text-xs font-semibold min-w-4 text-center")
                    | {{ category.eventTypes.length }}

            td
              .flex.flex-wrap.gap-2
                span.inline-flex.items-center.px-3.py-1.rounded-full.text-xs.font-medium.bg-green-50.text-green-700.border.border-green-200(
                  *ngFor="let category of row.ipTypeCategoryBag",
                  [pTooltip]="getDocumentTypesTooltip(category)",
                  tooltipPosition="top",
                  [tooltipOptions]="tooltipOptions"
                )
                  span.mr-1 {{ category.ipTypeLabel }}:
                  span(class="bg-white bg-opacity-70 rounded-full px-2 py-0.5 text-xs font-semibold min-w-4 text-center")
                    | {{ category.documentTypeBag.length }}

          // Expanded Row Content
          tr.bg-gray-50.border-l-4.border-blue-500(
            *ngIf="isRowExpanded(row.recipientCode)"
          )
            td(colspan="6")
              .p-4
                div(
                  class="mb-5 last:mb-0",
                  *ngFor="let category of row.ipTypeCategoryBag"
                )
                  .mb-3
                    h4(class="text-blue-600 font-semibold text-sm border-b-2 border-blue-100 pb-2")
                      | {{ category.ipTypeLabel }}

                  div(class="grid gap-4")
                    // Event Types Section
                    div
                      h5.flex.items-center.gap-2.mb-3.text-gray-800.font-semibold.text-sm
                        i.pi.pi-calendar.text-blue-500.text-xs
                        | Event Types ({{ category.eventTypes.length }})
                      div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2")
                        div(
                          class="flex items-center p-2 rounded border border-gray-200 bg-white hover:shadow-sm hover:-translate-y-0.5 transition-all duration-200 border-l-2 border-l-purple-500",
                          *ngFor="let event of category.eventTypes"
                        )
                          span.bg-gray-100.text-gray-600.px-2.py-1.rounded.text-xs.font-mono.font-semibold.mr-3.min-w-12.text-center
                            | {{ event.eventCode }}
                          span.text-gray-700.text-sm.font-medium.flex-1
                            | {{ event.eventLabel }}

                    // Document Types Section
                    div
                      h5.flex.items-center.gap-2.mb-3.text-gray-800.font-semibold.text-sm
                        i.pi.pi-file.text-blue-500.text-xs
                        | Document Types ({{ category.documentTypeBag.length }})
                      div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2")
                        div(
                          class="flex items-center p-2 rounded border border-gray-200 bg-white hover:shadow-sm hover:-translate-y-0.5 transition-all duration-200 border-l-2 border-l-green-500",
                          *ngFor="let doc of category.documentTypeBag"
                        )
                          span.bg-gray-100.text-gray-600.px-2.py-1.rounded.text-xs.font-mono.font-semibold.mr-3.min-w-12.text-center
                            | {{ doc.documentCode }}
                          span.text-gray-700.text-sm.font-medium.flex-1
                            | {{ doc.documentName }}

  // Reusable Modal Component
  app-modal(
    [(visible)]="showInfoDialog",
    [config]="modalConfig"
  )