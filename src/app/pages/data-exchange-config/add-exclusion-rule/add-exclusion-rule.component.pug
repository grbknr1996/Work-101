app-layout([config]="layoutConfig")
  app-breadcrumbs([items]="getBreadcrumbItems()")
  h2 Create Distribution Exclusion Rule

  app-configurable-stepper.p-mb-4(
    [steps]="steps",
    [activeStep]="step",
    (stepChange)="onStepChange($event)"
  )

  //- Step 0
  div(*ngIf="step === 0")
    form([formGroup]="sourceCategoriesForm")
      .p-grid.p-formgrid
        .p-col-6
          label Originating Office
          p-dropdown(
            [options]="originatingOffices()",
            formControlName="office",
            placeholder="Select Office",
            [disabled]="true"
          )
          small.p-text-secondary This is automatically set to your current office
        .p-col-6
          label Recipient System
          p-dropdown(
            [options]="recipientOffices()",
            formControlName="system",
            placeholder="Select System",
            (onChange)="onRecipientSystemChange()"
          )
      .p-mt-3
        label IP Category Types
        p-multiSelect(
          [options]="ipCategories()",
          formControlName="categories",
          defaultLabel="Select IP Categories",
          display="chip"
        )
        p-message(
          *ngIf="sourceCategoriesForm.value.categories.length",
          severity="success",
          text="You have selected {{ sourceCategoriesForm.value.categories.length }} IP categories. Each category can have its own specific exclusion rules."
        )
      .p-mt-4.p-d-flex.p-jc-between
        button.p-button-secondary(
          pButton,
          type="button",
          label="Cancel",
          (click)="cancel()"
        )
        button(
          pButton,
          type="button",
          label="Next",
          (click)="nextStep()",
          [disabled]="!sourceCategoriesForm.valid"
        )

  //- Step 1
  div(*ngIf="step === 1")
    p-tabView
      p-tabPanel(
        *ngFor="let cat of selectedCategories",
        [header]="getCategoryLabel(cat)"
      )
        .p-mb-3
          b Status Exclusions for {{ getCategoryLabel(cat) }}
        .p-grid
          .p-col-6
            p-checkbox(
              [(ngModel)]="statusExclusions[cat].unpublished",
              binary="true",
              inputId="unpublished-{{ cat }}"
            )
            label.p-ml-2(for="unpublished-{{ cat }}") Exclude Unpublished Applications
            .p-ml-4.p-mt-1.p-text-secondary
              | Unpublished {{ getCategoryLabel(cat) }} applications will not be shared.
          .p-col-6
            p-checkbox(
              [(ngModel)]="statusExclusions[cat].unregistered",
              binary="true",
              inputId="unregistered-{{ cat }}"
            )
            label.p-ml-2(for="unregistered-{{ cat }}") Exclude Unregistered Rights
            .p-ml-4.p-mt-1.p-text-secondary
              | Ungranted/unregistered {{ getCategoryLabel(cat) }} rights will not be shared.
    .p-mt-4.p-d-flex.p-jc-between
      button.p-button-secondary(pButton, type="button", label="Back", (click)="prevStep()")
      button(pButton, type="button", label="Next", (click)="nextStep()")

  //- Step 2
  div(*ngIf="step === 2")
    p-tabView
      p-tabPanel(
        *ngFor="let cat of selectedCategories",
        [header]="getCategoryLabel(cat)"
      )
        .p-mb-3
          b Configure Exclusion Rules for {{ getCategoryLabel(cat) }}
        p-accordion
          p-accordionTab(header="Application Types to Exclude")
            .p-text-secondary (Demo section for application types)

          p-accordionTab(header="Event Code Exclusions")
            .p-mb-2
              | Select event codes to exclude from data sharing for {{ getCategoryLabel(cat) }}.
            .p-grid
              .p-col-6(
                *ngFor="let event of getEventCodesForCategory(cat); let i = index"
              )
                p-checkbox(
                  [(ngModel)]="eventExclusions[cat]",
                  [value]="event.code",
                  [binary]="false",
                  inputId="event-{{ cat }}-{{ event.code }}"
                )
                label.p-ml-2(for="event-{{ cat }}-{{ event.code }}")
                  | {{ event.code }}: {{ event.label }}

          p-accordionTab(header="Document Exclusions")
            p-checkbox(
              [(ngModel)]="enableDocumentExclusions[cat]",
              binary="true",
              inputId="enable-doc-{{ cat }}"
            )
            label.p-ml-2(for="enable-doc-{{ cat }}") Enable Document Exclusions
            .p-mt-2(*ngIf="enableDocumentExclusions[cat]")
              label Select Document Types to Exclude
              p-multiSelect(
                [options]="getDocumentTypesForCategory(cat)",
                [(ngModel)]="documentExclusions[cat]",
                defaultLabel="Select Document Types",
                display="chip"
              )
    .p-mt-4.p-d-flex.p-jc-between
      button.p-button-secondary(pButton, type="button", label="Back", (click)="prevStep()")
      button(pButton, type="button", label="Next", (click)="nextStep()")

  //- Step 3
  div(*ngIf="step === 3")
    h3 Review Your Exclusion Rule Configuration

    .p-card.p-mb-3
      h4 Basic Configuration
      .p-grid
        .p-col-6
          b Originating Office:
          br
          | {{ getOfficeLabel(sourceCategoriesForm.value.office) }}
        .p-col-6
          b Recipient System:
          br
          | {{ getSystemLabel(sourceCategoriesForm.value.system) }}
        .p-col-12.p-mt-2
          b IP Category Types:
          br
          span.p-chip.p-mr-2.p-mb-2(*ngFor="let cat of selectedCategories")
            | {{ getCategoryLabel(cat) }}

    .p-card.p-mb-3(*ngFor="let cat of selectedCategories")
      h4 {{ getCategoryLabel(cat) }} Exclusions
      .p-mb-3
        h5 Status Exclusions
        .p-grid
          .p-col-6
            i.pi([ngClass]="statusExclusions[cat]?.unpublished ? 'pi-check-circle text-green' : 'pi-times-circle text-red'")
            span.p-ml-2 Exclude Unpublished Applications: 
              b {{ statusExclusions[cat]?.unpublished ? 'Yes' : 'No' }}
          .p-col-6
            i.pi([ngClass]="statusExclusions[cat]?.unregistered ? 'pi-check-circle text-green' : 'pi-times-circle text-red'")
            span.p-ml-2 Exclude Unregistered Rights: 
              b {{ statusExclusions[cat]?.unregistered ? 'Yes' : 'No' }}

      .p-mb-3(*ngIf="eventExclusions[cat]?.length > 0")
        h5 Event Code Exclusions ({{ eventExclusions[cat]?.length }} selected)
        .p-grid
          .p-col-6(*ngFor="let eventCode of eventExclusions[cat]")
            i.pi.pi-ban.text-red
            span.p-ml-2 {{ getEventCodeLabel(eventCode) }}

      .p-mb-3(*ngIf="!eventExclusions[cat]?.length")
        h5 Event Code Exclusions
        p.p-text-secondary No event codes excluded for this category.

      .p-mb-3(*ngIf="enableDocumentExclusions[cat]")
        h5 Document Exclusions ({{ documentExclusions[cat]?.length || 0 }} selected)
        .p-grid(*ngIf="documentExclusions[cat]?.length > 0")
          .p-col-6(*ngFor="let docCode of documentExclusions[cat]")
            i.pi.pi-ban.text-red
            span.p-ml-2 {{ getDocumentTypeLabel(docCode) }}
        p.p-text-secondary(*ngIf="!documentExclusions[cat]?.length")
          | No document types selected for exclusion.

      .p-mb-3(*ngIf="!enableDocumentExclusions[cat]")
        h5 Document Exclusions
        p.p-text-secondary Document exclusions are disabled for this category.

    .p-card.p-mb-3
      h4 Configuration Summary
      table.p-datatable-table
        thead
          tr
            th IP Category
            th Unpublished Apps
            th Unregistered Rights
            th Events Excluded
            th Documents Excluded
        tbody
          tr(*ngFor="let cat of selectedCategories")
            td
              b {{ getCategoryLabel(cat) }}
            td
              i.pi([ngClass]="statusExclusions[cat]?.unpublished ? 'pi-check-circle text-green' : 'pi-times-circle text-red'")
              | {{ statusExclusions[cat]?.unpublished ? 'Yes' : 'No' }}
            td
              i.pi([ngClass]="statusExclusions[cat]?.unregistered ? 'pi-check-circle text-green' : 'pi-times-circle text-red'")
              | {{ statusExclusions[cat]?.unregistered ? 'Yes' : 'No' }}
            td
              span.p-badge([ngClass]="eventExclusions[cat]?.length ? 'p-badge-warning' : 'p-badge-success'")
                | {{ eventExclusions[cat]?.length || 0 }}
            td
              span.p-badge([ngClass]="enableDocumentExclusions[cat] && documentExclusions[cat]?.length ? 'p-badge-warning' : 'p-badge-success'")
                | {{ enableDocumentExclusions[cat] ? documentExclusions[cat]?.length || 0 : 0 }}

    .p-mt-4.p-d-flex.p-jc-between
      button.p-button-secondary(pButton, type="button", label="Back", (click)="prevStep()")
      button.p-button-success(pButton, type="button", label="Add Rule", (click)="addRule()")
