app-layout([config]="layoutConfig")
  app-breadcrumbs([items]="getBreadcrumbItems()")
  h2.text-2xl.font-bold.text-blue-800.mb-6 {{ "addExclusionRules.title" |  translate }}

  app-configurable-stepper.mb-8(
    [steps]="steps",
    [activeStep]="step",
    (stepChange)="onStepChange($event)"
  )

  div(*ngIf="step === 0").w-full
    form([formGroup]="sourceCategoriesForm").w-full
      .w-full.grid.grid-cols-1.gap-6(class="md:grid-cols-2")
        .col-span-1
          label.block.text-sm.font-medium.text-gray-700.mb-2 {{ "addExclusionRules.formFields.originatingOffice" |  translate }}
          p-dropdown.w-full(
            [options]="originatingOffices()",
            formControlName="office",
            [placeholder]="ms.translate('addExclusionRules.formFields.originatingOfficePlaceholder')"
          )
          small.text-sm.text-gray-500.mt-1.block {{ "addExclusionRules.formFields.originatingOfficeValidationMessage" |  translate }}
        .col-span-1
          label.block.text-sm.font-medium.text-gray-700.mb-2 {{ "addExclusionRules.formFields.recipientSystem" |  translate }}
          p-dropdown.w-full(
            [options]="recipientOffices()",
            formControlName="system",
            [placeholder]="ms.translate('addExclusionRules.formFields.recipientSystemPlaceholder')",
            (onChange)="onRecipientSystemChange()"
          )
      .w-full.mt-6.grid.grid-cols-1.gap-6(class="md:grid-cols-2")
        .col-span-1
          label.block.text-sm.font-medium.text-gray-700.mb-2 {{ "addExclusionRules.formFields.IPTypeCategory" |  translate }}
          p-dropdown.w-full(
            [options]="ipCategories()",
            formControlName="categories",
            [placeholder]="ms.translate('addExclusionRules.formFields.IPTypeCategoryPlaceholder')",
            (onChange)="onIpCategoryChange()"
          )
          p-message(
            *ngIf="sourceCategoriesForm.value.categories",
            severity="success",
            [text]="ms.translate('addExclusionRules.formFields.IPTypeCategoryValidationMessage1') + ' ' + getCategoryLabel(sourceCategoriesForm.value.categories) + '. ' + ms.translate('addExclusionRules.formFields.IPTypeCategoryValidationMessage2') + '.'"
          )
        
        .col-span-1
          label.block.text-sm.font-medium.text-gray-700.mb-2 {{ "addExclusionRules.formFields.recipientClientID" |  translate }}
          input.w-full.px-3.py-2.border.border-gray-300.rounded-md.shadow-sm(
            type="text",
            formControlName="recipientClientId",
            [placeholder]="ms.translate('addExclusionRules.formFields.recipientClientIDPlaceholder')",
            class="focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
          )
          small.text-sm.text-gray-500.mt-1.block {{ "addExclusionRules.formFields.recipientClientIdValidationMessage1" |  translate }}
          small.p-error.text-red-600.text-sm.mt-1.block(
            *ngIf="sourceCategoriesForm.get('recipientClientId')?.invalid && sourceCategoriesForm.get('recipientClientId')?.touched"
          )
            | {{ "addExclusionRules.formFields.recipientClientIdValidationMessage2" |  translate }}
      
      .w-full.mt-6
        .w-full.flex.items-start
          p-checkbox(
            [(ngModel)]="includeUnpublishedApplications",
            [ngModelOptions]="{standalone: true}",
            binary="true",
            inputId="include-unpublished"
          )
          .ml-3.flex-1
            label.text-sm.text-gray-700(for="include-unpublished") {{ "addExclusionRules.formFields.publishOrUnpublishCheckbox" |  translate }}
            .mt-1.text-sm.text-gray-500
              | {{ "addExclusionRules.formFields.publishOrUnpublishCheckboxMessaage" |  translate }}.
      
      .w-full.mt-8.flex.justify-center.gap-4
        button.bg-gray-500.text-white.px-6.py-2.rounded-lg.transition-colors(
          class="hover:bg-gray-600",
          pButton,
          type="button",
          [label]="ms.translate('addExclusionRules.button.cancel')",
          (click)="cancel()"
        )
        button.bg-blue-600.text-white.px-6.py-2.rounded-lg.transition-colors(
          class="hover:bg-blue-700",
          pButton,
          type="button",
          [label]="ms.translate('addExclusionRules.button.next')",
          (click)="nextStep()",
          [disabled]="!sourceCategoriesForm.valid"
        )

  div(*ngIf="step === 1").w-full
    p-tabs.w-full
      p-tablist
        p-tab(*ngFor="let cat of selectedCategories") {{getCategoryLabel(cat)}}

      p-tabpanels
        p-tabpanel(*ngFor="let cat of selectedCategories")
          .mb-6
            b.text-lg.font-semibold.text-gray-800 {{ "addExclusionRules.categoryAndDistributionStep.configureRules" |  translate }} {{ getCategoryLabel(cat) }}
          p-accordion
            p-accordionTab(header="Event Code Inclusion")
              .flex.flex-row.mb-4.text-sm.text-gray-600.gap-2
                div {{ "addExclusionRules.categoryAndDistributionStep.chooseRules" |  translate }} {{ getCategoryLabel(cat) }}.
                div
                  p-checkbox(
                      [ngModel]="isAllSelected(cat)",
                      [binary]="true",
                      (onChange)="toggleSelectAll($event, cat)",
                      inputId="selectedAllEvents-{{ cat }}"
                    )
                    label.ml-3.text-sm.text-gray-700(for="selectedAllEvents-{{ cat }}")
                      | {{ "addExclusionRules.categoryAndDistributionStep.selectAllRules" |  translate }}
              .grid.grid-cols-1.gap-4(class="md:grid-cols-2")
                .col-span-1(
                  *ngFor="let event of getEventCodesForCategory(cat); let i = index"
                )
                  .flex.items-center
                    p-checkbox(
                      [(ngModel)]="eventExclusions[cat]",
                      [value]="event.code",
                      [binary]="false",
                      inputId="event-{{ cat }}-{{ event.code }}"
                    )
                    label.ml-3.text-sm.text-gray-700(for="event-{{ cat }}-{{ event.code }}")
                      | {{ event.code }}: {{ event.label }}

            p-accordionTab(header="Document Inclusion")
              .flex.items-center
                p-checkbox(
                [(ngModel)]="enableDocumentExclusions[cat]",
                binary="true",
                inputId="enable-doc-{{ cat }}"
                )
                label.ml-3.text-sm.text-gray-700(for="enable-doc-{{ cat }}") {{ "addExclusionRules.categoryAndDistributionStep.documentInclusionChecbox.label" |  translate }}
              .ml-6.mt-2.text-sm.text-gray-500
                | {{ "addExclusionRules.categoryAndDistributionStep.documentInclusionChecbox.message" |  translate }}.
              .mt-4(*ngIf="enableDocumentExclusions[cat]")
                label.block.text-sm.font-medium.text-gray-700.mb-2 {{ "addExclusionRules.categoryAndDistributionStep.documentInclusionMultiSelect.label" |  translate }}
                p-multiSelect(
                  [options]="getDocumentTypesForCategory(cat)",
                  [(ngModel)]="documentExclusions[cat]",
                  [defaultLabel]="ms.translate('addExclusionRules.documentInclusionMultiSelect.label2')",
                  display="chip"
                )

    .mt-8.flex.justify-center.gap-4
      button.bg-gray-500.text-white.px-6.py-2.rounded-lg.transition-colors(
        class="hover:bg-gray-600",
        pButton,
        type="button",
        [label]="ms.translate('addExclusionRules.button.back')",
        (click)="prevStep()"
      )
      button.bg-blue-600.text-white.px-6.py-2.rounded-lg.transition-colors(
        class="hover:bg-blue-700",
        pButton,
        type="button",
        [label]="ms.translate('addExclusionRules.button.next')",
        (click)="nextStep()"
      )

  div(*ngIf="step === 2")
    h3.text-2xl.font-bold.text-gray-800.mb-6 {{ "addExclusionRules.reviewStep.title" |  translate }}

    .grid.grid-cols-1.gap-6(class="lg:grid-cols-2")
      .bg-white.rounded-lg.shadow-md.p-6
        h4.text-lg.font-semibold.text-gray-700.mb-4 {{ "addExclusionRules.reviewStep.basicConfiguration" |  translate }}
        .grid.grid-cols-1.gap-6(class="md:grid-cols-[auto_auto_1fr]")
          .col-span-1
            b.text-base.text-gray-700 {{ "addExclusionRules.reviewStep.originatingOffice" |  translate }}:
            br
            .text-lg {{ sourceCategoriesForm.get('office').value }}
          .col-span-1
            b.text-base.text-gray-700 {{ "addExclusionRules.reviewStep.recipientSystem" |  translate }}:
            br
            .text-lg {{ getSystemLabel(sourceCategoriesForm.get('system').value) }}
          .col-span-1
            b.text-base.text-gray-700 {{ "addExclusionRules.reviewStep.recipientClientID" |  translate }}:
            br
            .text-lg {{ sourceCategoriesForm.get('recipientClientId').value }}
          .mt-4(class="md:col-span-3 col-span-1")
            b.text-base.text-gray-700 {{ "addExclusionRules.reviewStep.IPCategoryTypes" |  translate }}:
            br
            br
            span.inline-block.bg-blue-100.text-blue-800.text-sm.px-3.py-1.rounded-full.mr-2.mb-2(*ngFor="let cat of selectedCategories")
              | {{ getCategoryLabel(cat) }}
          .mt-4(class="md:col-span-3 col-span-1")
            b.text-base.text-gray-700 {{ "addExclusionRules.reviewStep.includeUnpublishedApplications" |  translate }}:
            br
            br
            i.pi([ngClass]="includeUnpublishedApplications ? 'pi-check-circle text-green-600' : 'pi-times-circle text-red-600'")
            span.ml-2.text-sm.text-gray-700 {{ includeUnpublishedApplications ? ms.translate('addExclusionRules.reviewStep.yes') : ms.translate('addExclusionRules.reviewStep.no') }}

      .bg-white.rounded-lg.shadow-md.p-6(*ngIf="selectedCategories?.length")
        ng-container(*ngIf="selectedCategories?.length")
          ng-container(*ngIf="selectedCategories[0] as cat")

            .mb-6(*ngIf="eventExclusions[cat]?.length > 0")
              h5.text-md.font-medium.text-gray-600.mb-3 {{ "addExclusionRules.reviewStep.eventCodeInclusion" |  translate }} ({{ eventExclusions[cat]?.length }} {{ "addExclusionRules.reviewStep.selected" |  translate }})
              .grid.grid-cols-1.gap-6(class="md:grid-cols-3")
                .col-span-1(*ngFor="let eventCode of eventExclusions[cat]")
                  i.pi.pi-check-circle.text-green-600
                  span.ml-2.text-sm.text-gray-700 {{ getEventCodeLabel(eventCode) }}

            .mb-6(*ngIf="!eventExclusions[cat]?.length")
              h5.text-md.font-medium.text-gray-600.mb-3  {{ "addExclusionRules.reviewStep.eventCodeInclusion" |  translate }}
              p.text-sm.text-gray-500  {{ "addExclusionRules.reviewStep.noEventCodes" |  translate }}.

            .mb-6(*ngIf="enableDocumentExclusions[cat]")
              h5.text-md.font-medium.text-gray-600.mb-3 {{ "addExclusionRules.reviewStep.documentInclusion" |  translate }} ({{ documentExclusions[cat]?.length || 0 }} {{ "addExclusionRules.reviewStep.selected" |  translate }})
              .grid.grid-cols-1.gap-6(*ngIf="documentExclusions[cat]?.length > 0" class="md:grid-cols-2")
                .col-span-1(*ngFor="let docCode of documentExclusions[cat]")
                  i.pi.pi-check-circle.text-green-600
                  span.ml-2.text-sm.text-gray-700 {{ getDocumentTypeLabel(docCode) }}
              p.text-sm.text-gray-500(*ngIf="!documentExclusions[cat]?.length")
                | {{ "addExclusionRules.reviewStep.noDocuments" |  translate }}.

            .mb-6(*ngIf="!enableDocumentExclusions[cat]")
              h5.text-md.font-medium.text-gray-600.mb-3 {{ "addExclusionRules.reviewStep.documentInclusion" |  translate }}
              p.text-sm.text-gray-500 {{ "addExclusionRules.reviewStep.documentInclusionMessage" |  translate }}.

    .mt-8.flex.justify-center.gap-4
      button.bg-gray-500.text-white.px-6.py-2.rounded-lg.transition-colors(
        class="hover:bg-gray-600",
        pButton,
        type="button",
        [label]="ms.translate('addExclusionRules.button.back')",
        (click)="prevStep()"
      )
      button.bg-green-600.text-white.px-6.py-2.rounded-lg.transition-colors(
        class="hover:bg-green-700",
        pButton,
        type="button",
        [label]="ms.translate('addExclusionRules.button.addRule')",
        (click)="addRule()"
      )