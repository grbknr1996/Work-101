app-layout([config]="layoutConfig")
  app-breadcrumbs([items]="getBreadcrumbItems()")

  .flex.justify-between.py-4
    h1.pt-4.text-xl.ml-4.col-span-3 {{ "distributionRules.title" | translate }}
    .flex.gap-2
      p-button(
        [label]="ms.translate('distributionRules.addRuleButton')", 
        icon="pi pi-plus",
        (click)="addRule()"
        )
      p-button(
        *ngIf="isWipoAdmin",
        [label]="ms.translate('distributionRules.addRecipientButton')", 
        icon="pi pi-plus",
        (click)="addRecipient()"
      )
  
