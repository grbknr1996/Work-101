app-layout([config]="layoutConfig")
  app-breadcrumbs([items]="getBreadcrumbItems()")

  // Summary Stats Section
  .summary-stats
    .stat-card
      .stat-content
        .stat-icon(
          style="background: linear-gradient(135deg, #0d47a1 0%, #0d47a1dd 100%);"
        )
          i.pi.pi-shield
        .stat-info
          .stat-number {{ activeRulesCount() }}
          .stat-label Active Rules

    .stat-card
      .stat-content
        .stat-icon(
          style="background: linear-gradient(135deg, #1565c0 0%, #1565c0dd 100%);"
        )
          i.pi.pi-building
        .stat-info
          .stat-number {{ officesCoveredCount() }}
          .stat-label Offices Covered

    .stat-card
      .stat-content
        .stat-icon(
          style="background: linear-gradient(135deg, #1976d2 0%, #1976d2dd 100%);"
        )
          i.pi.pi-list
        .stat-info
          .stat-number {{ totalRulesCount() }}
          .stat-label Total Rules

  // Main Content
  .distribution-rules-header
    h2 Distribution Rules
    button.add-rule-btn(type="button", (click)="addRule()")
      i.pi.pi-plus
      |  Add Rule

  // Loading State
  .loading-container(*ngIf="loading")
    p Loading distribution rules...

  // Table Content
  div(*ngIf="!loading")
    .card
      p-table(
        #dt,
        [value]="distributionRulesData()",
        [rowHover]="true",
        [rows]="10",
        [rowsPerPageOptions]="[10, 25, 50]",
        [loading]="loading",
        [paginator]="true",
        [globalFilterFields]="['originatingOffice', 'recipientName']",
        [showCurrentPageReport]="true",
        currentPageReportTemplate="Showing {first} to {last} of {totalRecords} entries",
        [resizableColumns]="false",
        [reorderableColumns]="false",
        [responsive]="true",
        styleClass="p-datatable-sm"
      )
        ng-template(pTemplate="caption")
          .flex-search-bar
            button.p-button-outlined(
              pButton,
              label="Clear",
              icon="pi pi-filter-slash",
              (click)="clear(dt)"
            )
            .ml-auto
              p-iconField(iconPosition="left")
                p-inputIcon
                  i.pi.pi-search
                input(
                  pInputText,
                  type="text",
                  (input)="dt.filterGlobal($event.target.value, 'contains')",
                  placeholder="Search keyword"
                )

        ng-template(pTemplate="header")
          tr
            th(pSortableColumn="originatingOffice", style="width: 15%")
              .flex.items-center
                | Originating Office
                p-sortIcon(field="originatingOffice")
            th(pSortableColumn="recipientName", style="width: 15%")
              .flex.items-center
                | Recipient Name
                p-sortIcon(field="recipientName")
            th(style="width: 15%") IP Category Types
            th(style="width: 15%") Application Status
            th(style="width: 15%") Excluded Event Codes
            th(style="width: 15%") Excluded Documents
            th(pSortableColumn="status", style="width: 10%")
              .flex.items-center
                | Status
                p-sortIcon(field="status")
            th(style="width: 10%") Actions

        ng-template(pTemplate="body", let-rowData)
          tr
            td {{ rowData.originatingOffice }}
            td {{ rowData.recipientName }}
            td
              span.exclusion-chip(*ngFor="let cat of rowData.ipCategoryTypes") {{ cat }}
            td
              span.exclusion-chip(*ngFor="let status of rowData.applicationStatus") {{ status }}
            td
              span.exclusion-chip(*ngIf="rowData.excludedEventCodes !== 'None'") {{ rowData.excludedEventCodes }}
              span(*ngIf="rowData.excludedEventCodes === 'None'") None
            td
              span.exclusion-chip(*ngIf="rowData.excludedDocuments !== 'Disabled'") {{ rowData.excludedDocuments }}
              span(*ngIf="rowData.excludedDocuments === 'Disabled'") Disabled
            td
              span.status-badge(
                [class.status-active]="rowData.status === 'active'",
                [class.status-inactive]="rowData.status === 'inactive'"
              ) {{ rowData.status }}
            td
              .flex.gap-2.justify-content-center
                button.p-button-rounded.p-button-text(
                  pButton,
                  icon="pi pi-pencil",
                  severity="info",
                  (click)="onActionClick({ action: 'edit', item: rowData })"
                )
                button.p-button-rounded.p-button-text(
                  pButton,
                  icon="pi pi-trash",
                  severity="danger",
                  (click)="onActionClick({ action: 'delete', item: rowData })"
                )

        ng-template(pTemplate="emptymessage")
          tr
            td(colspan="8") No distribution rules found.

  // Add Rule Full Screen Modal
  .full-screen-modal-overlay(*ngIf="showAddRuleModal")
    .full-screen-modal-container
      .full-screen-modal-header
        h2 Add New Distribution Rule
        button.modal-close-btn((click)="onModalHide()")
          i.pi.pi-times
      .full-screen-modal-content
        app-add-exclusion-rule([data]="localData", [onClose]="onFormSubmitted")
