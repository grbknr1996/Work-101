app-layout([config]="layoutConfig")
  app-breadcrumbs([items]="getBreadcrumbItems()")

  // Page Header
  .page-header
    .header-content
      .header-title
        h1 Originating Offices
        p Manage IP offices that provide data to the WIPO system

  // Statistics Cards
  .stats-section
    p-card(styleClass="stat-card")
      .stat-content
        .stat-icon
          i.pi.pi-building
        .stat-info
          .stat-number {{ totalOfficesCount() }}
          .stat-label Total Originating Offices

  // Offices Table
  .table-section
    p-card(header="Originating Offices", styleClass="table-card")
      app-table(
        [columns]="columns",
        [data]="filteredOffices()",
        [rows]="10",
        [paginator]="true",
        [loading]="false"
      )
