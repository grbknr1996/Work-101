app-layout([config]="layoutConfig")
  app-breadcrumbs([items]="getBreadcrumbItems()")

  // Page Header
  .page-header
    .header-content
      .header-title
        h1 Originating Offices
        p Manage IP offices that provide data to the WIPO system
      .header-actions
        button(
          pButton,
          type="button",
          label="Import Offices",
          icon="pi pi-upload",
          class="p-button-outlined"
        )
        button(
          pButton,
          type="button",
          label="Add Office",
          icon="pi pi-plus",
          (click)="onAddOffice()"
        )

  // Statistics Cards
  .stats-section
    p-card(styleClass="stat-card")
      .stat-content
        .stat-icon
          i.pi.pi-building
        .stat-info
          .stat-number {{ filteredOffices().length }}
          .stat-label Total Offices

    p-card(styleClass="stat-card")
      .stat-content
        .stat-icon
          i.pi.pi-check-circle
        .stat-info
          .stat-number {{ activeOfficesCount() }}
          .stat-label Active Offices

    p-card(styleClass="stat-card")
      .stat-content
        .stat-icon
          i.pi.pi-sync
        .stat-info
          .stat-number {{ syncedTodayCount() }}
          .stat-label Synced Today

  // Offices Table
  .table-section
    p-card(header="Originating Offices", styleClass="table-card")
      app-table(
        [columns]="columns",
        [data]="filteredOffices()",
        [rows]="10",
        [paginator]="true",
        [loading]="loading",
        (actionClick)="onActionClick($event)"
      )
        // Status Template
        ng-template(#statusTemplate, let-row)
          span.status-badge([ngClass]="getStatusClass(row.status)") {{ row.status }}

        // Data Types Template
        ng-template(#dataTypesTemplate, let-row)
          .data-types
            span.data-type-badge(*ngFor="let type of row.dataTypes") {{ getDataTypesLabel([type]) }}

  // Add Office Dialog
  p-dialog(
    header="Add Originating Office",
    [(visible)]="showAddDialog",
    [modal]="true",
    [style]="{ width: '600px' }",
    [draggable]="false",
    [resizable]="false"
  )
    form([formGroup]="officeForm", class="office-form")
      .form-grid
        .form-field
          label(for="code") Office Code *
          input(
            id="code",
            type="text",
            pInputText,
            formControlName="code",
            placeholder="e.g., US, EP, JP",
            maxlength="10"
          )
          small.p-error(
            *ngIf="officeForm.get('code')?.invalid && officeForm.get('code')?.touched"
          )
            | Office code is required and must be 10 characters or less

        .form-field
          label(for="name") Office Name *
          input(
            id="name",
            type="text",
            pInputText,
            formControlName="name",
            placeholder="e.g., United States Patent and Trademark Office"
          )
          small.p-error(
            *ngIf="officeForm.get('name')?.invalid && officeForm.get('name')?.touched"
          )
            | Office name is required and must be at least 3 characters

        .form-field
          label(for="country") Country *
          p-dropdown(
            id="country",
            [options]="countries",
            formControlName="country",
            placeholder="Select Country",
            optionLabel="label",
            optionValue="value"
          )
          small.p-error(
            *ngIf="officeForm.get('country')?.invalid && officeForm.get('country')?.touched"
          )
            | Country is required

        .form-field
          label(for="status") Status *
          p-dropdown(
            id="status",
            [options]="[{ label: 'Active', value: 'active' }, { label: 'Inactive', value: 'inactive' }]",
            formControlName="status",
            placeholder="Select Status",
            optionLabel="label",
            optionValue="value"
          )

        .form-field.full-width
          label(for="dataTypes") Data Types *
          p-multiselect(
            id="dataTypes",
            [options]="dataTypes",
            formControlName="dataTypes",
            placeholder="Select Data Types",
            optionLabel="label",
            optionValue="value",
            display="chip"
          )
          small.p-error(
            *ngIf="officeForm.get('dataTypes')?.invalid && officeForm.get('dataTypes')?.touched"
          )
            | At least one data type must be selected

    ng-template(pTemplate="footer")
      button(
        pButton,
        type="button",
        label="Cancel",
        class="p-button-text",
        (click)="onCancel()"
      )
      button(
        pButton,
        type="button",
        label="Save",
        (click)="onSaveOffice()",
        [disabled]="!officeForm.valid"
      )

  // Edit Office Dialog
  p-dialog(
    header="Edit Originating Office",
    [(visible)]="showEditDialog",
    [modal]="true",
    [style]="{ width: '600px' }",
    [draggable]="false",
    [resizable]="false"
  )
    form([formGroup]="officeForm", class="office-form")
      .form-grid
        .form-field
          label(for="edit-code") Office Code *
          input(
            id="edit-code",
            type="text",
            pInputText,
            formControlName="code",
            placeholder="e.g., US, EP, JP",
            maxlength="10"
          )
          small.p-error(
            *ngIf="officeForm.get('code')?.invalid && officeForm.get('code')?.touched"
          )
            | Office code is required and must be 10 characters or less

        .form-field
          label(for="edit-name") Office Name *
          input(
            id="edit-name",
            type="text",
            pInputText,
            formControlName="name",
            placeholder="e.g., United States Patent and Trademark Office"
          )
          small.p-error(
            *ngIf="officeForm.get('name')?.invalid && officeForm.get('name')?.touched"
          )
            | Office name is required and must be at least 3 characters

        .form-field
          label(for="edit-country") Country *
          p-dropdown(
            id="edit-country",
            [options]="countries",
            formControlName="country",
            placeholder="Select Country",
            optionLabel="label",
            optionValue="value"
          )
          small.p-error(
            *ngIf="officeForm.get('country')?.invalid && officeForm.get('country')?.touched"
          )
            | Country is required

        .form-field
          label(for="edit-status") Status *
          p-dropdown(
            id="edit-status",
            [options]="[{ label: 'Active', value: 'active' }, { label: 'Inactive', value: 'inactive' }]",
            formControlName="status",
            placeholder="Select Status",
            optionLabel="label",
            optionValue="value"
          )

        .form-field.full-width
          label(for="edit-dataTypes") Data Types *
          p-multiselect(
            id="edit-dataTypes",
            [options]="dataTypes",
            formControlName="dataTypes",
            placeholder="Select Data Types",
            optionLabel="label",
            optionValue="value",
            display="chip"
          )
          small.p-error(
            *ngIf="officeForm.get('dataTypes')?.invalid && officeForm.get('dataTypes')?.touched"
          )
            | At least one data type must be selected

    ng-template(pTemplate="footer")
      button(
        pButton,
        type="button",
        label="Cancel",
        class="p-button-text",
        (click)="onCancel()"
      )
      button(
        pButton,
        type="button",
        label="Update",
        (click)="onSaveOffice()",
        [disabled]="!officeForm.valid"
      )

  // Confirmation Dialog
  p-confirmDialog
