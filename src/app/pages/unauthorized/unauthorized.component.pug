.flex.justify-center.align-items-center(
  style=`
    min-height: 100vh;
    background: linear-gradient(
      135deg,
      var(--p-primary-color) 50%,
      var(--p-primary-600) 25%
    );
    padding: 1rem;
  `
)
  p-card.max-w-25rem.text-center.shadow-8
    ng-template(pTemplate="header")
      .flex.justify-content-center.p-3
        i.pi.pi-shield-exclamation.text-6xl.text-red-500.animate-pulse
    
    ng-template(pTemplate="title")
      h1.text-2xl.font-bold.text-gray-800.m-0 Access Denied
    
    ng-template(pTemplate="content")
      .text-gray-600.line-height-2.mb-3
        p.text-base.mb-2
          | Sorry, you don't have permission to access this page.
        p.text-base
          | Please contact your administrator if you believe this is an error.
      
      p-divider
      
      .flex.justify-center.mb-3
        p-chip(
          label="Error 403",
          severity="danger",
          styleClass="text-sm"
        )
    
    ng-template(pTemplate="footer")
      .flex.flex-column.gap-2.sm: flex-row.sm: justify-content-center
        p-button(
          icon="pi pi-arrow-left",
          label="Go Back",
          severity="primary",
          (onClick)="goBack()",
          styleClass="w-full sm:w-auto text-sm"
        )